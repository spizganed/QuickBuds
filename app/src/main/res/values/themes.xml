<?xml version="1.0" encoding="utf-8"?>
<!--
  The three built-in presets, as compiled styles (design/SPEC.md section 1).

  Every colour in the app comes from the six token attributes below. Each style
  sets all six; ThemeRes.color() resolves them against the CURRENT theme, and XML
  references them as ?attr/appColor*. Custom presets have no style: ThemeRes picks
  the base style with the right light/dark window, then substitutes the preset's
  values at inflation time (ThemeRes.PaletteFactory) and in ThemeRes.color().
  PaletteStore.builtIn() reads these styles back, so the built-in values live only here.

  HISTORY, so this is not undone:
    attempt 1  applyOverrideConfiguration(uiMode) -> crashed on launch, five times
    attempt 2  setTheme() alone -> no crash, but colours never changed
    attempt 3  this: attributes resolve per theme, and setTheme() selects them
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <attr name="appColorBg" format="color" />
    <attr name="appColorCard" format="color" />
    <attr name="appColorAccent" format="color" />
    <attr name="appColorTextPrimary" format="color" />
    <attr name="appColorTextSecondary" format="color" />
    <attr name="appColorOutline" format="color" />

    <style name="Theme.App.Base" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">?attr/appColorBg</item>
        <item name="android:colorBackground">?attr/appColorBg</item>
        <item name="android:statusBarColor">?attr/appColorBg</item>
        <item name="android:navigationBarColor">?attr/appColorBg</item>
        <item name="android:colorAccent">?attr/appColorAccent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <!-- OLED Black (default). True black so the panel shuts pixels off. -->
    <style name="Theme.App.OLED" parent="Theme.App.Base">
        <item name="appColorBg">#000000</item>
        <item name="appColorCard">#1C1C1E</item>
        <item name="appColorAccent">#D71920</item>
        <item name="appColorTextPrimary">#FFFFFF</item>
        <item name="appColorTextSecondary">#9B9B9B</item>
        <item name="appColorOutline">#2E2E30</item>
    </style>

    <!-- Classic Dark. Off-black so the cards have something to sit against. -->
    <style name="Theme.App.Dark" parent="Theme.App.Base">
        <item name="appColorBg">#121214</item>
        <item name="appColorCard">#232327</item>
        <item name="appColorAccent">#D71920</item>
        <item name="appColorTextPrimary">#FFFFFF</item>
        <item name="appColorTextSecondary">#A0A0A5</item>
        <item name="appColorOutline">#34343A</item>
    </style>

    <!-- White. Light bars, so the system icons flip to dark. -->
    <style name="Theme.App.Light" parent="Theme.App.Base">
        <item name="appColorBg">#F2F2F4</item>
        <item name="appColorCard">#FFFFFF</item>
        <item name="appColorAccent">#D71920</item>
        <item name="appColorTextPrimary">#111113</item>
        <item name="appColorTextSecondary">#6B6B70</item>
        <item name="appColorOutline">#DDDDE0</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- Kept so a stale reference lands on OLED instead of the light platform default. -->
    <style name="Theme.App" parent="Theme.App.OLED" />

    <!-- Window animation for the bottom sheets (BottomSheetDialog, the EQ editor). -->
    <style name="SheetAnimation">
        <item name="android:windowEnterAnimation">@anim/sheet_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_out</item>
    </style>
</resources>
