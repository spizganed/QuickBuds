<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing widget style: the selected button's outline ([USER] 2026-09-30: an outline, not a fill), dashed so it
     reads as a row of dots. WHITE on purpose: tinted at runtime with the accent. Same 16dp corners as widget_panel_n. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <!-- Without a solid, a colour filter makes GradientDrawable fill the shape opaque. -->
    <solid android:color="#00000000" />
    <stroke android:width="2dp" android:color="#FFFFFF" android:dashWidth="2dp" android:dashGap="2dp" />
    <corners android:radius="16dp" />
</shape>
