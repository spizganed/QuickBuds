<?xml version="1.0" encoding="utf-8"?>
<!--
  Charging case, OUTLINE variant — used for the "in case" state.

  The rule, as specified: the in-case state is the same shape but HOLLOW — filled
  with the background colour inside, with the icon colour as an outline. In the app
  that means a transparent interior showing the card through it.

  WHY THIS READS AS A STATE: the three wear states are a fill progression, not just
  a colour change, so they stay distinguishable even if the colours are close:
    in ear      -> solid fill
    out of ear  -> solid fill, grey
    in case     -> hollow
  Filling it "with the background colour" literally would be wrong here: the icon
  sits on a card whose colour differs from the screen background, so a hardcoded
  background-coloured interior would show as a mismatched disc. Drawing the interior
  as a REAL HOLE (two subpaths, outer clockwise and inner counter-clockwise, with
  the default non-zero fill rule) makes it transparent instead, so whatever surface
  is behind shows through — which is what "the colour of background" means visually
  on a card, on the widget, and over any wallpaper.

  GEOMETRY: identical to ic_case.xml, inset by a uniform 2.6 units, so switching
  between the two states does not change the icon's apparent size. Keep the two
  files' coordinates in sync if either is edited.

  The lid line is preserved as a gap in the OUTLINE too, so the hollow variant is
  still recognisably the same object.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp" android:height="48dp"
    android:viewportWidth="48" android:viewportHeight="48">

    <!--
      Upper half outline: outer top arc, then the inner top arc subtracted.
      Both subpaths are in one <path> so the even-odd/non-zero rule punches the
      hole rather than filling it.
    -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 24 8.6
            C 31.4 8.6 37.4 15.3 37.4 23.5
            L 10.6 23.5
            C 10.6 15.3 16.6 8.6 24 8.6
            Z
            M 24 11.2
            C 18.2 11.2 13.2 16.8 13.2 23.5
            L 34.8 23.5
            C 34.8 16.8 29.8 11.2 24 11.2
            Z" />

    <!-- Lower half outline: outer bottom arc, then the inner bottom arc. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 10.6 25.1
            C 10.6 33.3 16.6 39.4 24 39.4
            C 31.4 39.4 37.4 33.3 37.4 25.1
            Z
            M 13.2 25.1
            C 13.2 32.1 18.2 36.8 24 36.8
            C 29.8 36.8 34.8 32.1 34.8 25.1
            Z" />
</vector>
