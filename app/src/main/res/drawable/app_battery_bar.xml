<?xml version="1.0" encoding="utf-8"?>
<!--
  Battery bar, segmented into 5 divisions.

  A layer-list CANNOT do evenly-spaced dividers at arbitrary widths: layer-list
  items are positioned by gravity and fixed dp, so dividers would drift between
  the narrow app bar and the wider widget bar. The segments are therefore painted
  in code by SegmentedBarDrawable, which is a small ProgressDrawable that draws
  the track, the fill, and the dividers at computed fractions of its own width.

  This file is kept as the style source of truth for the two rounded rectangles so
  the widget and the app cannot disagree on the shapes; SegmentedBarDrawable reads
  the same resources for its colours.

  (Left as a plain layer-list for any tooling that expects a drawable reference;
  the app sets SegmentedBarDrawable on the ProgressBar in code. Do not try to add
  dividers here — see the note above.)
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="?attr/appColorBarTrack" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="?attr/appColorSegBgActive" />
                <corners android:radius="3dp" />
            </shape>
        </clip>
    </item>
</layer-list>
