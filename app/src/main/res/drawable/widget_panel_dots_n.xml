<?xml version="1.0" encoding="utf-8"?>
<!-- Dot matrix widget style: a button's grey outline, dashed like widget_panel_select_n but thinner, so the buttons
     read as separate cells ([USER] 2026-09-30). WHITE on purpose: tinted at runtime. Same 16dp corners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#00000000" />
    <stroke android:width="1.5dp" android:color="#FFFFFF" android:dashWidth="1.5dp" android:dashGap="2dp" />
    <corners android:radius="16dp" />
</shape>
