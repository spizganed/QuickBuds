<?xml version="1.0" encoding="utf-8"?>
<!--
  ANC button background, INACTIVE.

  Rounded rectangle that stretches to fill its share of the row, so there is no
  empty space at the screen edges. It now carries the SAME 1dp outline as the
  battery box above it and the settings rows below it, so the three groups read as
  one family of bordered surfaces — which is what was asked for.

  The fill is the button colour, which is a step off the card, so an inactive button
  is still distinguishable from the background even before the outline is noticed.

  Radius is 16dp to match the card corners exactly, rather than the 14dp this
  previously used — the mismatch was visible where the row sits directly under the
  battery box.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/appColorButton" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="?attr/appColorOutline" />
</shape>
