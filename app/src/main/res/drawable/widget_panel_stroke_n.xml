<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing widget style, WHITE on purpose: tinted at runtime (ImageView.setColorFilter) with the active palette.
     The box matches Nothing OS's own widgets (about 19dp, measured on the Phone (3a), [USER] 2026-09-28); inner
     shapes take 16dp so their corners run parallel to it inside the 3dp inset. Every size uses the same radius. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <stroke android:width="1dp" android:color="#FFFFFF" />
    <corners android:radius="16dp" />
</shape>
