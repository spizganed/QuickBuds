<?xml version="1.0" encoding="utf-8"?>
<!--
  Dev Tools button, INACTIVE state.

  A small rounded chip matching the main screen's controls (app_switch_track's
  shape and fill), so the tab row and the action buttons look like the same
  family as everything else.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/appColorButton" />
    <corners android:radius="10dp" />
    <stroke
        android:width="1dp"
        android:color="?attr/appColorOutline" />
</shape>
