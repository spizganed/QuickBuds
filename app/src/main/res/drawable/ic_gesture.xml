        android:fillColor="#FFFFFF"
        android:pathData="M 9.1 4.6 C 8.4 4.6 7.9 4.1 7.9 3.4 C 7.9 2.7 8.4 2.2 9.1 2.2 C 9.8 2.2 10.3 2.7 10.3 3.4 C 10.3 4.1 9.8 4.6 9.1 4.6 Z" />
