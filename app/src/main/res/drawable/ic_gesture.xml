        android:pathData="M 11.2 8.6 C 11.2 7.5 12.1 6.6 13.2 6.6 C 14.3 6.6 15.2 7.5 15.2 8.6 L 15.2 13.2 L 15.6 13.2 C 17.4 13.2 18.9 14.7 18.9 16.5 L 18.9 18.6 C 18.9 20.5 17.4 22 15.6 22 L 11.4 22 C 10.4 22 9.4 21.6 8.7 20.8 L 5.4 17.1 C 4.8 16.4 4.9 15.3 5.6 14.7 C 6.3 14.1 7.3 14.2 7.9 14.8 L 9.3 16.2 L 9.3 10.6 C 9.3 9.5 10.2 8.6 11.2 8.6 Z" />
    <!-- Tap arcs -->
