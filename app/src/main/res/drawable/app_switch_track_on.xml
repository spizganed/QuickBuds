<?xml version="1.0" encoding="utf-8"?>
<!--
  Switch track, CHECKED state. Uses the widget's red accent so "on" means the
  same thing here as it does on the home screen.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/app_accent" />
    <corners android:radius="100dp" />
</shape>
