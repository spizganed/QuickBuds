<?xml version="1.0" encoding="utf-8"?>
<!--
  Letter badge behind the L / C / R battery labels: a small ringed circle.

  Draws nothing but the ring, so the letter is a normal TextView on top of it.
  Keeping the letter as text (rather than baking it into four drawables) means
  the label stays selectable/tintable and there is only one asset to keep.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/appColorButton" />
    <corners android:radius="100dp" />
    <stroke
        android:width="1dp"
        android:color="?attr/appColorOutline" />
</shape>
