<?xml version="1.0" encoding="utf-8"?>
<!--
  ANC button background, ACTIVE.

  Rounded rectangle to match the inactive state, with the same 1dp outline so the
  geometry is identical between states — only the fill and text colour change, which
  is the indicator the user asked for ("the color of the button and text in it is
  enough of an indicator").

  NO red ring: that was removed by request. The red accent appears only on the
  game-mode switch track now.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/appColorSegBgActive" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="?attr/appColorOutline" />
</shape>
