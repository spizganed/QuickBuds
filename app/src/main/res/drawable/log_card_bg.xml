<?xml version="1.0" encoding="utf-8"?>
<!--
  Log surface: the card the log text sits in.

  This is what the request asked for as "some border around the text of the logs".
  It matches the main screen's card language — same 16dp radius, same 1dp outline
  stroke as app_card_bg — so the Dev Tools screen reads as part of the same app
  rather than as a debug surface bolted on.

  Uses theme attributes so it follows the in-app theme, not just the system
  dark-mode setting.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/appColorBg" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="?attr/appColorOutline" />
</shape>
