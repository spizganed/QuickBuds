<?xml version="1.0" encoding="utf-8"?>
<!--
  Left bud, OUTLINE variant — the "in case" state.

  HOW THE OUTLINE IS MADE, and why not by editting coordinates:
  Hand-insetting a traced path means recomputing every cubic control point, which is
  error-prone and would drift from the solid version the moment either is touched.

  Instead this uses the platform's own stroke support on a vector path: the path is
  the SAME data as ic_bud_left.xml, filled with nothing and stroked with the icon
  colour. The platform vector renderer strokes the actual curve, so the outline
  follows the silhouette exactly at every scale, and the two files stay in sync by
  construction — only the fillColor/strokeColor differ.

  WHY strokeAlpha IS NOT USED FOR THE "HOLLOW" LOOK: a stroked-and-unfilled path IS
  hollow. There is no interior fill at all, so whatever is behind the icon (card,
  widget background, wallpaper) shows through — which is what the user asked for as
  "inside of the icon color of background so transparent inside technically".
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp" android:height="48dp"
    android:viewportWidth="48" android:viewportHeight="48">
    <group
        android:scaleX="0.98"
        android:scaleY="0.98"
        android:translateX="0.867"
        android:translateY="0.082">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.7"
            android:strokeLineJoin="round"
            android:strokeLineCap="round"
            android:pathData="M 25.8 47.5 L 22.7 47.2 L 21.4 46.4 L 20.0 44.9 L 19.3 43.0 L 19.1 39.7 L 19.1 27.3 L 16.6 27.2 L 14.6 26.7 L 12.4 25.4 L 10.4 23.4 L 9.1 21.2 L 8.6 19.4 L 8.6 16.1 L 9.1 14.2 L 10.8 11.4 L 13.8 9.0 L 15.8 5.5 L 18.5 3.0 L 22.9 0.8 L 25.3 0.3 L 29.0 0.3 L 32.7 1.6 L 36.5 5.2 L 37.9 8.5 L 38.1 12.6 L 37.4 15.1 L 35.5 18.3 L 33.4 20.6 L 30.4 22.9 L 30.6 43.2 L 29.6 45.2 L 28.4 46.4 Z" />
    </group>
</vector>
