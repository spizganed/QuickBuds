<?xml version="1.0" encoding="utf-8"?>
<!--
  Right bud, used by the widget (ImageView widget_bud_right).

  Same treatment as ic_bud_left.xml: traced path data verbatim, plus a transform
  that CENTRES THE INK IN THE VIEWPORT.

      raw ink bounds: x 9.5 -> 39.2 (centre 24.35), y 0.3 -> 47.5 (centre 23.90)
      viewport centre: 24, 24

  The ink is 0.35 units right of centre and 0.10 units above it. With
  scaleType="fitCenter" the ImageView centres by bounds, not by ink, so this
  offset shows up directly as a misaligned pair in the widget.

  The widget relies on the two stems sitting at equal distances either side of
  the divider, so both buds are normalised independently here rather than being
  nudged via layout padding.

  If the artwork is ever retraced, RECOMPUTE these numbers from the ink bounds.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp" android:height="48dp"
    android:viewportWidth="48" android:viewportHeight="48">
    <group
        android:scaleX="0.98"
        android:scaleY="0.98"
        android:translateX="0.077"
        android:translateY="0.082">
        <path android:fillColor="#FFFFFF"
            android:pathData="M 23.8 47.5 L 21.0 47.4 L 19.6 46.6 L 18.6 45.8 L 17.4 43.9 L 17.1 42.8 L 17.3 22.7 L 15.0 21.1 L 11.9 17.9 L 10.1 14.4 L 9.5 11.8 L 9.9 8.1 L 12.1 4.1 L 14.8 1.8 L 18.8 0.3 L 24.2 0.6 L 27.1 1.8 L 29.7 3.4 L 32.8 6.6 L 34.1 9.2 L 35.3 9.9 L 37.8 12.6 L 39.2 16.6 L 39.0 19.9 L 37.0 23.8 L 33.6 26.5 L 31.2 27.2 L 28.7 27.3 L 28.3 43.4 L 27.6 45.0 L 26.0 46.6 Z" />
    </group>
</vector>
