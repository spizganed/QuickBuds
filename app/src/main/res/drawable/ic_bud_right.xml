<?xml version="1.0" encoding="utf-8"?>
<!--
  RIGHT earbud — the user's latest SVG (400x500 viewBox), MIRRORED horizontally as
  requested.

  COLOUR RULE (the user's own): white = transparent, black = icon colour. But this
  SVG uses STROKES as well as fills, and they need opposite handling:

    fill="#000000"                 -> ink
    stroke="#ffffff"               -> an outline that must stay VISIBLE, so it is
                                      converted to an ink STROKE with the enclosed
                                      shape left hollow
    fill="#ffffff" (grille centre)  -> a cut-out
    fill="#000000" (3 micro-ports)  -> ink islands inside that cut-out (omitted, see
                                      below)

  ==================================================================
  THE MIRROR, AND WHY IT IS DONE PER-COORDINATE
  ==================================================================
  The user asked for this icon flipped. It is mirrored about the viewport's vertical
  centre line, X -> 53.58 - X, where 53.58 is the source shape's own centre line
  (the bud body spans x 12.30..41.28, centre 26.79, so mirroring about the SHAPE
  keeps it in place instead of sliding it across the viewport).

  IT IS NOT DONE with <group scaleX="-1">. That flips the winding order of every
  subpath, and this icon relies on fillType="evenOdd" for its cut-outs: reversed
  winding turns holes into islands and vice versa, so the body would hollow out and
  the grille would fill in. Mirroring each coordinate and swapping the arc sweep
  flags gives the same picture with the winding intact.

  ==================================================================
  TRANSFORM AND ARITHMETIC
  ==================================================================
  Source 400x500 -> 48x48, scale by the long side:
      scale = 48/500 = 0.096
      xOffset from the original fit: X0 = x*0.096 + 5.58
      mirror about the shape centre: X = 53.58 - X0 = 48.00 - x*0.096
      Y = y*0.096
  So:  X = 48 - x*0.096    Y = y*0.096

    body     70,160 -> 41.28,15.36    250,160 -> 24.00,15.36   r 90 -> 8.64
             240,225-> 24.96,21.60    150,210 -> 33.60,20.16   150,250 -> 33.60,24.00
             150,380-> 33.60,36.48     70,380 -> 41.28,36.48   r 40 -> 3.84
    glass    centre 85,108 -> 39.84,10.37  (half-length 1.63, angle -38)
    ear tip  200,210 -> 28.80,20.16   rx 6.14  ry 5.18
    nozzle   218,222 -> 27.07,21.31   rx 1.73  ry 2.69
    grille   218,222 -> 27.07,21.31   rx 1.15  ry 1.92

  ==================================================================
  TWO DELIBERATE SIMPLIFICATIONS (losses, stated plainly)
  ==================================================================
  1. STROKE WIDTHS RAISED. The source's 4.5 and 4 become 0.43 and 0.38 units, i.e.
     under half a pixel at 42dp — invisible. Raised to 1.2 so the rims render.
  2. THE THREE MICRO-PORTS ARE OMITTED. At r=3.2 they scale to 0.31 units, well
     below one pixel. Drawing them would cost rasterisation per frame for something
     unseen, and on some densities reads as grime rather than detail.

  If the icon is ever drawn large — Find my earbuds uses 120dp — this file should
  gain a scaled-up sibling that restores the fine detail.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp" android:height="48dp"
    android:viewportWidth="48" android:viewportHeight="48">

    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="
            M 41.28 15.36
            A 8.64 8.64 0 0 0 24 15.36
            C 24.96 21.6 33.6 20.16 33.6 24
            L 33.6 36.48
            A 3.84 3.84 0 0 0 41.28 36.48
            Z

            M 39.84 9.37
            C 39.36 8.99 38.81 9.0 38.83 9.75
            C 38.86 10.38 39.26 10.86 40.51 11.63
            C 41.76 12.4 42.4 12.99 43.0 12.7
            C 43.7 12.36 43.46 11.66 42.4 11.37
            C 41.36 11.09 40.32 9.75 39.84 9.37
            Z" />

    <!-- Ear tip rim: stroked, not filled. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.2"
        android:pathData="
            M 28.8 14.98
            C 25.41 14.98 22.66 17.35 22.66 20.16
            C 22.66 22.97 25.41 25.34 28.8 25.34
            C 32.19 25.34 34.94 22.97 34.94 20.16
            C 34.94 17.35 32.19 14.98 28.8 14.98
            Z" />

    <!-- Nozzle rim: also stroked. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.2"
        android:pathData="
            M 27.07 18.62
            C 25.85 19.19 25.19 20.19 25.19 21.31
            C 25.19 22.43 25.85 23.43 27.07 24
            C 28.29 24.57 29.53 24.57 28.75 23.43
            C 27.97 22.29 27.97 20.33 28.75 19.19
            C 29.53 18.05 28.29 18.05 27.07 18.62
            Z" />

    <!-- Grille centre: a cut-out. -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="
            M 28.26 21.31
            C 28.26 20.64 27.69 20.11 26.99 20.11
            C 26.29 20.11 25.72 20.64 25.72 21.31
            C 25.72 21.98 26.29 22.51 26.99 22.51
            C 27.69 22.51 28.26 21.98 28.26 21.31
            Z" />
</vector>
