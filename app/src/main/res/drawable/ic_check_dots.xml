<?xml version="1.0" encoding="utf-8"?>
<!-- Check for the Nothing style (ThemeRes.tint swaps it in): ic_check's path with a 3.6 stroke, so the
     diagonal samples as an even two-dot staircase instead of a ragged one-dot line. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <path
        android:pathData="M5,12.5l4.5,4.5L19,7"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
