<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2 widget (BatteryWidgetProvider, battery and controls pages). No previewImage: a VECTOR there shows "Can't load widget" in some pickers (see git history).
     Resizable: QuickBudsWidget.fit picks the layout for the size. updatePeriodMillis 0: the service pushes every change (AncWidgetProvider.refreshAll). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_pages"
    android:configure="com.spizganed.quickbuds.widget.WidgetSetupActivity"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:widgetCategory="home_screen" />
