<?xml version="1.0" encoding="utf-8"?>
<!-- The service notification while connected: left, case and right levels as the widget's rings. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:gravity="center" android:orientation="horizontal">
        <ImageView android:id="@+id/n_ring_l" android:layout_width="40dp" android:layout_height="40dp" />
        <TextView android:id="@+id/n_pct_l" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />
    </LinearLayout>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:gravity="center" android:orientation="horizontal">
        <ImageView android:id="@+id/n_ring_c" android:layout_width="40dp" android:layout_height="40dp" />
        <TextView android:id="@+id/n_pct_c" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />
    </LinearLayout>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:gravity="center" android:orientation="horizontal">
        <ImageView android:id="@+id/n_ring_r" android:layout_width="40dp" android:layout_height="40dp" />
        <TextView android:id="@+id/n_pct_r" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />
    </LinearLayout>
</LinearLayout>
