<?xml version="1.0" encoding="utf-8"?>
<!--
  Main screen, redesigned.

  PAINT: nothing here carries a hardcoded colour. Every colour comes from a theme
  attribute (?attr/appColor*) so the OLED / Dark / Light swap is a resource
  qualifier change rather than a view-tree recolor. The one exception is the
  icons, which are vector drawables and therefore tinted in Kotlin (see
  MainActivity.applyThemeTints).

  STRUCTURE, top to bottom:
    1. header      - device name + dev tools + settings cog (no left button)
    2. scroll
       2a. battery card   - L/R bud icons + case icon, three labelled bars
       2b. ANC row        - four circles; tapping the active one opens the
                            mode chooser (see MainActivity.showAncChooser)
       2c. settings card  - game mode, hi-res codec, spatial audio (switches)
                            equalizer, find my earbuds, app update (chevrons)

  The settings rows are NOT written out here. They are built in MainActivity
  (buildFeatureRows) because each one needs live state, a themed icon tint and a
  click handler, and duplicating six near-identical row layouts in XML would mean
  six places to edit every time a row changes. The container (#featureList) is
  declared empty here on purpose.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/appColorBg"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="44dp"
    android:paddingBottom="12dp">

    <!-- Header. Left action intentionally absent: the redesign drops it. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/deviceNameText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/default_device_name"
            android:textSize="@dimen/header_title_size"
            android:textStyle="bold"
            android:textColor="?attr/appColorTextPrimary" />

        <ImageButton
            android:id="@+id/btnDevTools"
            android:layout_width="@dimen/header_icon_button"
            android:layout_height="@dimen/header_icon_button"
            android:background="@drawable/header_icon_bg"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_dev_tools"
            android:contentDescription="@string/action_dev_tools" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="@dimen/header_icon_button"
            android:layout_height="@dimen/header_icon_button"
            android:layout_marginStart="8dp"
            android:background="@drawable/header_icon_bg"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings_cog"
            android:contentDescription="@string/action_settings" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ============ 1. BATTERY CARD ============
                 Two halves: icons on the left, labelled bars on the right.

                 ICON LOGIC IS A PORT OF THE WIDGET'S (see renderWear): white in ear,
                 grey out of ear, hidden in case. Colours are the widget's own, not
                 themed, so this panel matches the home screen in every app theme.

                 SPACING: the two buds sit at the outer edges with a gap between them
                 for the case icon, which is why they are weighted rather than packed
                 together. The case is centred in that gap. -->
            <LinearLayout
                android:id="@+id/batteryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/battery_card_padding"
                android:paddingTop="@dimen/battery_card_padding_v"
                android:paddingBottom="@dimen/battery_card_padding_v"
                android:background="@drawable/app_card_outline_bg"
                android:gravity="center_vertical">

                <!-- LEFT HALF: bud, space, case, space, bud -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/status_bud_left"
                        android:layout_width="@dimen/battery_bud_size"
                        android:layout_height="@dimen/battery_bud_size"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_bud_left"
                        android:contentDescription="@string/widget_battery_left" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/battery_case_height"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/status_case_icon"
                            android:layout_width="@dimen/battery_case_width"
                            android:layout_height="@dimen/battery_case_height"
                            android:layout_gravity="center"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_case"
                            android:contentDescription="@string/widget_battery_case" />
                    </FrameLayout>

                    <ImageView
                        android:id="@+id/status_bud_right"
                        android:layout_width="@dimen/battery_bud_size"
                        android:layout_height="@dimen/battery_bud_size"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_bud_right"
                        android:contentDescription="@string/widget_battery_right" />
                </LinearLayout>

                <!-- RIGHT HALF: three labelled bars, no numeric labels on the
                     outside — the numbers now live INSIDE the segments. -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <LinearLayout
                        android:id="@+id/status_row_left"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/battery_row_spacing">

                        <TextView
                            android:layout_width="@dimen/battery_letter_size"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/widget_battery_left"
                            android:textColor="?attr/appColorLetter"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="@dimen/battery_bar_height"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp">

                            <ProgressBar
                                android:id="@+id/status_bar_left"
                                style="@android:style/Widget.ProgressBar.Horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:max="100"
                                android:progress="0" />

                            <TextView
                                android:id="@+id/status_text_left"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:textColor="?attr/appColorBarLabelOnTrack"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/status_row_case"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/battery_row_spacing">

                        <TextView
                            android:layout_width="@dimen/battery_letter_size"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/widget_battery_case"
                            android:textColor="?attr/appColorLetter"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="@dimen/battery_bar_height"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp">

                            <ProgressBar
                                android:id="@+id/status_bar_case"
                                style="@android:style/Widget.ProgressBar.Horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:max="100"
                                android:progress="0" />

                            <TextView
                                android:id="@+id/status_text_case"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:textColor="?attr/appColorBarLabelOnTrack"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/status_row_right"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="@dimen/battery_letter_size"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/widget_battery_right"
                            android:textColor="?attr/appColorLetter"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="@dimen/battery_bar_height"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp">

                            <ProgressBar
                                android:id="@+id/status_bar_right"
                                style="@android:style/Widget.ProgressBar.Horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:max="100"
                                android:progress="0" />

                            <TextView
                                android:id="@+id/status_text_right"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:textColor="?attr/appColorBarLabelOnTrack"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ============ 2. ANC CIRCLES ============ -->
            <!--
              Four buttons only. The chooser for the full mode list opens from the
              ACTIVE button (see MainActivity.showAncChooser), which is why there
              are four and not five: one slot per conceptual state, with the
              sub-variants of noise cancelling behind the ANC button.
            -->
            <LinearLayout
                android:id="@+id/ancRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <TextView
                    android:id="@+id/anc_btn_off"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/anc_button_height"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/app_anc_off"
                    android:textSize="@dimen/anc_circle_text_size"
                    android:textStyle="bold"
                    android:textColor="?attr/appColorSegText"
                    android:background="@drawable/anc_circle_bg" />

                <TextView
                    android:id="@+id/anc_btn_anc"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/anc_button_height"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/anc_circle_gap"
                    android:gravity="center"
                    android:text="@string/app_anc_anc"
                    android:textSize="@dimen/anc_circle_text_size"
                    android:textStyle="bold"
                    android:textColor="?attr/appColorSegText"
                    android:background="@drawable/anc_circle_bg" />

                <TextView
                    android:id="@+id/anc_btn_trans"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/anc_button_height"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/anc_circle_gap"
                    android:gravity="center"
                    android:text="@string/app_anc_trans"
                    android:textSize="@dimen/anc_circle_text_size"
                    android:textStyle="bold"
                    android:textColor="?attr/appColorSegText"
                    android:background="@drawable/anc_circle_bg" />
            </LinearLayout>

            <!-- ============ 3. SETTINGS ROWS ============
                 Built in code; see the class comment at the top of this file.
                 Uses the same outlined rounded box as the battery card and the ANC
                 buttons, so all three groups share one visual treatment. -->
            <LinearLayout
                android:id="@+id/featureList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="18dp"
                android:background="@drawable/app_card_outline_bg" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
