<?xml version="1.0" encoding="utf-8"?>
<!--
  Main screen (design/SPEC.md 3.1 / 3.2).

  PAINT: nothing here carries a hardcoded colour. Colours come from the six token
  attributes (?attr/appColor*), and shapes are built in code (ThemeRes).

  STRUCTURE: the header, then a scrolling column of TILES, each its own include
  layout with a stable root id (batteryCard, ancRow, featureList). The sound
  settings rows are built in code (buildFeatureRows) and ordered / hidden one by
  one from Settings > Home layout (layoutFeatureRows).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/appColorBg">

    <!-- Header. Left action intentionally absent: the redesign drops it. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/deviceNameText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/default_device_name"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginEnd="8dp"
            android:textSize="@dimen/header_title_size"
            android:textStyle="bold"
            android:textColor="?attr/appColorTextPrimary" />

        <!--
          CONNECTION STATUS PILL.

          A small stadium-shaped box holding a dot and a word, beside the device name.
          Why a pill and not just a coloured dot: the dot alone is ambiguous the first
          time it is seen (is green "connected" or "connected AND something else"?),
          and the word is what makes it self-explanatory. The dot is what makes it
          readable at a glance without reading.

          ORDER: dot, then label. The dot is tinted in code (ThemeRes.tint) because
          it is a vector and its colour is connection STATE, not a theme surface — it
          must stay green/grey in every theme. The LABEL colour comes from the same
          state colours, set in MainActivity.renderConnectionPill.

          `wrap_content` on both sides: the pill must not stretch, and it must not
          reserve space for the longer word when showing the shorter one.
        -->
        <LinearLayout
            android:id="@+id/connPill"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/header_icon_button"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginEnd="8dp">

            <ImageView
                android:id="@+id/connDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_status_dot_empty"
                android:contentDescription="@string/conn_status_desc" />

            <TextView
                android:id="@+id/connText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/conn_off"
                android:textColor="?attr/appColorTextSecondary" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnDevTools"
            android:layout_width="@dimen/header_icon_button"
            android:layout_height="@dimen/header_icon_button"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_dev_tools"
            android:contentDescription="@string/action_dev_tools" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="@dimen/header_icon_button"
            android:layout_height="@dimen/header_icon_button"
            android:layout_marginStart="8dp"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings_cog"
            android:contentDescription="@string/action_settings" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/tiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/tile_battery" />
            <include layout="@layout/tile_noise" />
            <include layout="@layout/tile_settings" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
