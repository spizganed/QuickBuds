<?xml version="1.0" encoding="utf-8"?>
<!-- 4x1 bar widget: three small rings, a noise-control chip that cycles Off / ANC / Transparency, Low latency.
     Colours are set at runtime from the active palette (widget/WidgetRender.kt); nothing here is coloured.
     RemoteViews: only FrameLayout / LinearLayout / ImageView / TextView. Every id is set by the renderer
     for this layout, so a view added here needs its line in WidgetRender too. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_fill" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/w_stroke" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_stroke" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center">
            <ImageView android:id="@+id/w_ring_left" android:layout_width="30dp" android:layout_height="30dp"
                android:scaleType="fitCenter" />
            <TextView android:id="@+id/w_pct_left" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center">
            <ImageView android:id="@+id/w_ring_case" android:layout_width="30dp" android:layout_height="30dp"
                android:scaleType="fitCenter" />
            <TextView android:id="@+id/w_pct_case" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center">
            <ImageView android:id="@+id/w_ring_right" android:layout_width="30dp" android:layout_height="30dp"
                android:scaleType="fitCenter" />
            <TextView android:id="@+id/w_pct_right" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
        </LinearLayout>
            <FrameLayout android:id="@+id/w_chip_cycle" android:layout_width="64dp" android:layout_height="40dp"
                android:layout_marginStart="3dp" android:layout_marginEnd="3dp">
                <ImageView android:id="@+id/w_chip_cycle_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/widget_chip" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center">
                    <ImageView android:id="@+id/w_chip_cycle_icon" android:layout_width="16dp" android:layout_height="16dp"
                        android:importantForAccessibility="no" />
                    <TextView android:id="@+id/w_chip_cycle_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="9sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:id="@+id/w_chip_gamechip" android:layout_width="40dp" android:layout_height="40dp"
                android:layout_marginStart="3dp" android:layout_marginEnd="3dp">
                <ImageView android:id="@+id/w_chip_gamechip_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/widget_chip" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center">
                    <ImageView android:id="@+id/w_chip_gamechip_icon" android:layout_width="16dp" android:layout_height="16dp"
                        android:importantForAccessibility="no" />
                    <TextView android:id="@+id/w_chip_gamechip_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="0sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>
    </LinearLayout>
</FrameLayout>
