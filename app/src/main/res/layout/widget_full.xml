<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2 full widget: battery rings with wear labels, all six noise modes, Low latency.
     Colours are set at runtime from the active palette (widget/WidgetRender.kt); nothing here is coloured.
     RemoteViews: only FrameLayout / LinearLayout / ImageView / TextView. Every id is set by the renderer
     for this layout, so a view added here needs its line in WidgetRender too. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_fill" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/w_stroke" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_stroke" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center" android:padding="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <ImageView android:id="@+id/w_ring_left" android:layout_width="38dp" android:layout_height="38dp"
                android:scaleType="fitCenter" />
            <TextView android:id="@+id/w_pct_left" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
            <TextView android:id="@+id/w_label_left" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <ImageView android:id="@+id/w_ring_case" android:layout_width="38dp" android:layout_height="38dp"
                android:scaleType="fitCenter" />
            <TextView android:id="@+id/w_pct_case" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
            <TextView android:id="@+id/w_label_case" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <ImageView android:id="@+id/w_ring_right" android:layout_width="38dp" android:layout_height="38dp"
                android:scaleType="fitCenter" />
            <TextView android:id="@+id/w_pct_right" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
            <TextView android:id="@+id/w_label_right" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:maxLines="1" />
        </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="horizontal">
            <FrameLayout android:id="@+id/w_chip_off" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp"
                android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
                <ImageView android:id="@+id/w_chip_off_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/widget_chip" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center">
                    <ImageView android:id="@+id/w_chip_off_icon" android:layout_width="16dp" android:layout_height="16dp"
                        android:importantForAccessibility="no" />
                    <TextView android:id="@+id/w_chip_off_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="9sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:id="@+id/w_chip_low" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp"
                android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
                <ImageView android:id="@+id/w_chip_low_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/widget_chip" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center">
                    <ImageView android:id="@+id/w_chip_low_icon" android:layout_width="16dp" android:layout_height="16dp"
                        android:importantForAccessibility="no" />
                    <TextView android:id="@+id/w_chip_low_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="9sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:id="@+id/w_chip_med" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp"
                android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
                <ImageView android:id="@+id/w_chip_med_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/widget_chip" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center">
                    <ImageView android:id="@+id/w_chip_med_icon" android:layout_width="16dp" android:layout_height="16dp"
                        android:importantForAccessibility="no" />
                    <TextView android:id="@+id/w_chip_med_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="9sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:id="@+id/w_chip_high" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp"
                android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
                <ImageView android:id="@+id/w_chip_high_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/widget_chip" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center">
                    <ImageView android:id="@+id/w_chip_high_icon" android:layout_width="16dp" android:layout_height="16dp"
                        android:importantForAccessibility="no" />
                    <TextView android:id="@+id/w_chip_high_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="9sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:id="@+id/w_chip_adapt" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp"
                android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
                <ImageView android:id="@+id/w_chip_adapt_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/widget_chip" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center">
                    <ImageView android:id="@+id/w_chip_adapt_icon" android:layout_width="16dp" android:layout_height="16dp"
                        android:importantForAccessibility="no" />
                    <TextView android:id="@+id/w_chip_adapt_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="9sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:id="@+id/w_chip_trans" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp"
                android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
                <ImageView android:id="@+id/w_chip_trans_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/widget_chip" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center">
                    <ImageView android:id="@+id/w_chip_trans_icon" android:layout_width="16dp" android:layout_height="16dp"
                        android:importantForAccessibility="no" />
                    <TextView android:id="@+id/w_chip_trans_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="9sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        <FrameLayout android:id="@+id/w_game" android:layout_width="match_parent" android:layout_height="28dp"
            android:layout_marginTop="6dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
            <ImageView android:id="@+id/w_game_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/widget_chip" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="horizontal" android:gravity="center">
                <ImageView android:id="@+id/w_game_icon" android:layout_width="14dp" android:layout_height="14dp"
                    android:src="@drawable/ic_bolt" android:importantForAccessibility="no" />
                <TextView android:id="@+id/w_game_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" android:textSize="11sp" android:fontFamily="sans-serif-medium"
                    android:maxLines="1" android:text="@string/row_game_title" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
