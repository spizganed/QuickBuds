<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2 compact widget: battery rings, Off / L / M / H / Transparency, Low latency.
     The rings row takes whatever height the launcher gives (weight 1; the ring bitmap is scaled by
     fitCenter), so a short cell shrinks the rings instead of clipping the widget. Low latency is the
     bolt chip at the end of the noise row, as in the 4x1.
     Colours are set at runtime from the active palette (widget/AncWidgetProvider.kt); nothing here is coloured.
     RemoteViews: only FrameLayout / LinearLayout / ImageView / TextView. Every id is set by the renderer
     for this layout, so a view added here needs its line in the renderer too. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_fill" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/w_stroke" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_stroke" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center_horizontal">
                <ImageView android:id="@+id/w_ring_left" android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:scaleType="fitCenter" />
                <TextView android:id="@+id/w_pct_left" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="1dp" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center_horizontal">
                <ImageView android:id="@+id/w_ring_case" android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:scaleType="fitCenter" />
                <TextView android:id="@+id/w_pct_case" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="1dp" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center_horizontal">
                <ImageView android:id="@+id/w_ring_right" android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:scaleType="fitCenter" />
                <TextView android:id="@+id/w_pct_right" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="1dp" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="32dp"
            android:layout_marginTop="6dp" android:orientation="horizontal">
            <FrameLayout android:id="@+id/w_chip_off" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
                <ImageView android:id="@+id/w_chip_off_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/widget_chip" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center">
                    <ImageView android:id="@+id/w_chip_off_icon" android:layout_width="14dp" android:layout_height="14dp"
                        android:importantForAccessibility="no" />
                    <TextView android:id="@+id/w_chip_off_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="9sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:id="@+id/w_chip_low" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
                <ImageView android:id="@+id/w_chip_low_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/widget_chip" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center">
                    <ImageView android:id="@+id/w_chip_low_icon" android:layout_width="0dp" android:layout_height="0dp"
                        android:importantForAccessibility="no" />
                    <TextView android:id="@+id/w_chip_low_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="10sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:id="@+id/w_chip_med" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
                <ImageView android:id="@+id/w_chip_med_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/widget_chip" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center">
                    <ImageView android:id="@+id/w_chip_med_icon" android:layout_width="0dp" android:layout_height="0dp"
                        android:importantForAccessibility="no" />
                    <TextView android:id="@+id/w_chip_med_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="10sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:id="@+id/w_chip_high" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
                <ImageView android:id="@+id/w_chip_high_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/widget_chip" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center">
                    <ImageView android:id="@+id/w_chip_high_icon" android:layout_width="0dp" android:layout_height="0dp"
                        android:importantForAccessibility="no" />
                    <TextView android:id="@+id/w_chip_high_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="10sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:id="@+id/w_chip_trans" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
                <ImageView android:id="@+id/w_chip_trans_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/widget_chip" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center">
                    <ImageView android:id="@+id/w_chip_trans_icon" android:layout_width="14dp" android:layout_height="14dp"
                        android:importantForAccessibility="no" />
                    <TextView android:id="@+id/w_chip_trans_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="9sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:id="@+id/w_chip_gamechip" android:layout_width="32dp" android:layout_height="match_parent"
                android:layout_marginStart="5dp" android:layout_marginEnd="2dp">
                <ImageView android:id="@+id/w_chip_gamechip_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/widget_chip" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center">
                    <ImageView android:id="@+id/w_chip_gamechip_icon" android:layout_width="16dp" android:layout_height="16dp"
                        android:importantForAccessibility="no" />
                    <TextView android:id="@+id/w_chip_gamechip_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="0sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
