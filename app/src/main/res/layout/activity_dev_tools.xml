<?xml version="1.0" encoding="utf-8"?>
<!--
  Dev Tools: the live packet log (decoded or raw), log file actions, link controls and the
  crash logger test. Layout, screenshot and widget reports were removed 2026-09-27: adb
  (uiautomator, screencap, logcat) covers them. Colours come from ?attr/appColor* and the
  chip / card drawables applied in DevToolsActivity.applyTheme().
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/devToolsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/appColorBg"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="44dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/devToolsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp"
        android:text="Dev Tools"
        android:textSize="@dimen/header_title_size"
        android:textStyle="bold"
        android:textColor="?attr/appColorTextPrimary" />

    <LinearLayout
        android:id="@+id/devActionsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnClear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:minWidth="0dp"
                android:minHeight="44dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textSize="13sp"
                android:text="Clear" />
            <Button
                android:id="@+id/btnExport"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:minWidth="0dp"
                android:minHeight="44dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textSize="13sp"
                android:text="Export" />
            <Button
                android:id="@+id/btnCrashTest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:minWidth="0dp"
                android:minHeight="44dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textSize="13sp"
                android:text="Crash test" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnReconnect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:minWidth="0dp"
                android:minHeight="44dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textSize="13sp"
                android:text="Reconnect" />
            <Button
                android:id="@+id/btnDisconnect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:minWidth="0dp"
                android:minHeight="44dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textSize="13sp"
                android:text="Disconnect" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">
        <Button
            android:id="@+id/btnTabHuman"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:minWidth="0dp"
            android:minHeight="44dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="Human-Readable" />
        <Button
            android:id="@+id/btnTabRaw"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:minWidth="0dp"
            android:minHeight="44dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="Raw Hex" />
    </LinearLayout>

    <!-- Long press copies the visible tab. -->
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="10dp"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:typeface="monospace"
            android:lineSpacingExtra="2dp"
            android:paddingBottom="8dp" />
    </ScrollView>

</LinearLayout>
