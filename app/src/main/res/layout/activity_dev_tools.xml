<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/devToolsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp"
    android:paddingTop="48dp">

    <!-- Toolbar: title + clear + export -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Dev Tools"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Mark" />

        <!--
          Screenshot -> text. Diagnostic only: decodes an image on device and writes
          the pixels out as text so the coding agent can read a layout it cannot see.
          See ScreenshotToText.
        -->
        <Button
            android:id="@+id/btnScreenshot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Shot" />

        <!--
          Layout report. Writes the measured geometry of THIS screen out as text:
          every view's id, bounds, margins, padding, weights and text metrics.
          This is the readable form of a screenshot for a layout question — a
          text description of a picture is guesswork, but the numbers the
          framework already computed are exact. See LayoutReport.
        -->
        <Button
            android:id="@+id/btnLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Layout" />

        <!--
          Widget report. The Layout button walks an ACTIVITY's view tree, and a
          home-screen widget is not an Activity — it is drawn by the launcher from a
          RemoteViews parcel in another process, so it was invisible to the layout
          log until this button existed. This inflates widget_anc in-process at the
          launcher's reported size, and also prints the live widget state, which is
          what distinguishes "measures wrong" from "state empty so everything is
          gated INVISIBLE". See LayoutReport.buildWidget.
        -->
        <Button
            android:id="@+id/btnWidgetLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Widg" />

        <!--
          Widget REMOTEVIEWS check. The "Widg" button above measures the widget's
          layout, which is a different question and was misleading: the layout was
          already correct while the widget still failed, so the button kept saying
          "fine". This one runs the widget's REAL builder for the current state and
          round-trips the result through a Parcel — the same thing the
          AppWidgetService does before the launcher ever sees the update — and reports
          any throw, plus how many times the live update path has already failed.
        -->
        <Button
            android:id="@+id/btnWidgetLogic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Wlog" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Clear" />

        <Button
            android:id="@+id/btnExport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Export" />
    </LinearLayout>

    <!-- Live clock: current time with milliseconds + time since last Mark.
         Used as a testing instrument to time physical actions (bud in/out)
         against the packet timeline. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/clockText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="--:--:--.---"
            android:textSize="16sp"
            android:textStyle="bold"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/sinceMarkText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:typeface="monospace" />
    </LinearLayout>

    <!-- Tab switcher -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/btnTabHuman"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Human-Readable"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTabRaw"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Raw Hex"
            android:textStyle="bold" />
    </LinearLayout>

    <!--
      Log content.

      The ScrollView itself now carries the card background (log_card_bg) so the
      log sits inside a bordered panel, matching the main screen's cards. The
      background is on the ScrollView rather than the inner TextView so the border
      stays put when the content is shorter than the view, and so the padding is
      inside the border rather than pushing it around.
    -->
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/log_card_bg"
        android:padding="10dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/logText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textIsSelectable="true"
                android:textSize="12sp"
                android:typeface="monospace"
                android:lineSpacingExtra="2dp"
                android:paddingBottom="8dp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
