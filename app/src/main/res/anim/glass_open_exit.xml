<?xml version="1.0" encoding="utf-8"?>
<!-- Glass: the screen below sinks back and dims a little. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:interpolator="@android:interpolator/decelerate_cubic">
    <alpha android:fromAlpha="1" android:toAlpha="0.6" android:duration="220" />
    <scale android:fromXScale="1" android:toXScale="0.97" android:fromYScale="1" android:toYScale="0.97"
        android:pivotX="50%" android:pivotY="50%" android:duration="260" />
</set>
