// QuickBuds desktop UI: the main window and the tray's quick panel. Classic or Dot matrix style, the phone's presets.

import { ListView, ScrollView, Palette as SysPalette } from "std-widgets.slint";
// The phone's bundled Doto, for the Dot matrix style.
import "../../app/src/main/res/font/doto.ttf";

export global Palette {
    in-out property <color> bg: #121214;
    in-out property <color> card: #232327;
    in-out property <color> accent: #D71920;
    in-out property <color> text: #FFFFFF;
    in-out property <color> text2: #A0A0A5;
    in-out property <color> outline: #34343A;
    // Derived in Rust (`theme.rs`): the label on an accent fill, a light theme, the switch track.
    in-out property <color> on-accent: #FFFFFF;
    in-out property <bool> light;
    in-out property <color> track: #3D3D43;
    out property <color> sidebar: card.mix(bg, 0.5);
    // Switch thumb when off: the text on a dark theme, the card on a light one (a dark thumb looked like a hole).
    out property <color> thumb-off: light ? card : text.mix(card, 0.9);
    // Background of an expanded row.
    out property <color> expanded: card.mix(text, 0.95);
    // An outline that stands out a little more: lighter on a dark theme, darker on a light one.
    out property <color> outline-strong: light ? outline.darker(0.15) : outline.brighter(0.3);

    // Wear shade: in ear full, out of ear secondary, in case faint (like the phone's rings).
    public pure function wear-tint(wear: int) -> color {
        if wear == 2 { return text; }
        if wear == 3 { return text.transparentize(0.83); }
        return text2;
    }
    // The Dot matrix glyph shade (the widget's `nothingTint`): opaque blends, the dots have no alpha.
    public pure function dot-tint(wear: int) -> color {
        if wear == 2 { return text; }
        if wear == 1 { return card.mix(text2, 0.35); }
        return card.mix(text2, 0.83);
    }
}

// Shared animation timings: hover, state change, page and value change.
export global Motion {
    out property <duration> fast: 120ms;
    out property <duration> base: 200ms;
    out property <duration> slow: 320ms;
}

// The Dot matrix style (`dots.rs`). Shapes come from Rust as images at physical pixels, snapped to whole cells.
export global Dots {
    in property <bool> on;
    in property <float> scale: 1;
    // The dot pitch in physical px.
    in property <float> pitch: 2;
    callback set-on(bool);
    pure callback box-px(float, float, color, color, float) -> image;
    pure callback ring-px(float, int, int, color, color, color) -> image;
    pure callback knob-px(color, color) -> image;
    // A disc of n cells: colour, outer cells.
    pure callback disc-px(int, color, color) -> image;
    // A colour slider's track: width in px, channel (hue, saturation, brightness), and the colour as h, s, v.
    pure callback slider-px(float, int, float, float, float) -> image;
    out property <string> font: on ? "Doto" : "Segoe UI";
    // The largest whole number of cells inside `l`.
    public pure function snap(l: length) -> length { return floor(l / 1px * scale / pitch) * pitch / scale * 1px; }
    public pure function box(w: length, h: length, fill: color, stroke: color, r: length) -> image {
        return box-px(w / 1px * scale, h / 1px * scale, fill, stroke, r / 1px * scale);
    }
    public pure function knob(ring: color, fill: color) -> image { return knob-px(ring, fill); }
    // The knob's size in logical px (7 cells).
    out property <length> knob-size: 7 * pitch / scale * 1px;
}

// A card, button or row outline as dots: the outline a cell of `stroke`, the fill a cell inside.
component DotBox inherits Rectangle {
    in property <color> fill: Palette.card;
    in property <color> stroke: Palette.outline;
    in property <length> radius: 16px;
    Image {
        width: Dots.snap(root.width);
        height: Dots.snap(root.height);
        x: round((root.width - self.width) / 2 * Dots.scale / 1px) / Dots.scale * 1px;
        y: round((root.height - self.height) / 2 * Dots.scale / 1px) / Dots.scale * 1px;
        source: Dots.box(root.width, root.height, root.fill, root.stroke, root.radius);
        image-fit: ImageFit.fill;
        image-rendering: pixelated;
    }
}

// Strings from the phone app's strings.xml (set from Rust for the system language).
export struct Choice {
    value: int,
    label: string,
}

export global Update {
    in property <string> installed;
    in property <string> status;
    // The newer version found, "" = none.
    in property <string> available;
    in property <string> notice;
    // Its folder is writable: else the button opens the release page.
    in property <bool> can-install;
    in property <bool> busy;
    in property <bool> auto;
    // Settings › Hide old battery levels (`clear_battery`).
    in property <bool> clear-battery;
    callback set-clear-battery(bool);
    // Settings › Language: "System default" first, then each locale (`main.rs` LANGUAGES).
    in property <[Choice]> languages;
    in property <int> language;
    in property <string> language-name;
    callback set-language(int);
    callback check();
    callback install();
    callback set-auto(bool);
}

