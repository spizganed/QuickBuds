export struct Level {
    id: string,
    name: string,
    icon: image,
}

export global Buds {
    // 0 not connected, 1 connecting, 2 connected
    in property <int> status;
    in property <string> name;
    // -1 = unknown
    in property <int> left: -1;
    in property <int> right: -1;
    in property <int> case: -1;
    in property <bool> left-charging;
    in property <bool> right-charging;
    in property <bool> case-charging;
    // 0 unknown, 1 out of ear, 2 in ear, 3 in case
    in property <int> left-wear;
    in property <int> right-wear;
    in property <string> anc;
    in property <bool> anc-is-level;
    in property <bool> has-off;
    in property <bool> has-adaptive;
    in property <bool> has-transparency;
    in property <[Level]> levels;
    in property <bool> low-latency;
    in property <bool> has-game: true;
    in property <bool> has-eq: true;

    in property <image> icon-left;
    in property <image> icon-right;
    in property <image> icon-case;
    in property <image> icon-palette;
    in property <image> icon-off;
    in property <image> icon-anc;
    in property <image> icon-adaptive;
    in property <image> icon-transparency;
    in property <image> icon-low-latency;
    in property <image> icon-app;
    in property <image> icon-bass;
    in property <image> icon-chevron;
    in property <image> icon-update;
    in property <image> icon-plus;
    in property <image> icon-info;
    in property <image> icon-find;
    in property <image> icon-earbud;
    in property <image> icon-volume;
    in property <image> icon-volume-off;
    in property <image> icon-devices;
    in property <image> icon-hearing;
    in property <image> icon-language;
    in property <image> icon-pencil;
    in property <image> icon-copy;
    in property <image> icon-delete;
    in property <image> icon-warning;
    in property <image> icon-chevron-down;
    in property <image> icon-hires;
    // The ANC segment's label: "ANC", or "ANC M" while a level is on (the phone's and the widget's button).
    in property <string> anc-label: Tr.anc;

    callback set-anc(string);
    callback set-low-latency(bool);
    callback connect();
    callback disconnect();
    callback open-main();
    callback quit();

    out property <bool> on: status == 2;
    out property <string> status-text: status == 2 ? Tr.connected : status == 1 ? Tr.connecting : Tr.not-connected;
}

component Card inherits Rectangle {
    // App settings, not the buds': never dimmed.
    in property <bool> live;
    background: Dots.on ? transparent : Palette.card;
    border-width: Dots.on ? 0 : 1px;
    border-color: Palette.outline;
    border-radius: 16px;
    opacity: Buds.on || live ? 1 : 0.35;
    animate opacity { duration: Motion.base; easing: ease-out; }
    if Dots.on: DotBox { width: 100%; height: 100%; radius: root.border-radius; }
}

component Ring {
    in property <int> level;
    in property <bool> charging;
    in property <image> glyph;
    in property <length> glyph-w;
    in property <length> glyph-h;
    in property <color> tint: Palette.text;
    in property <string> label;
    in property <bool> label-bright;
    in property <length> size: 90px;
    // 0 left, 1 case, 2 right; the Dot matrix ring draws its own glyph.
    in property <int> slot;
    in property <int> wear;
    // The drawn level slides to the reported one (from 0 at connect).
    property <float> shown: max(0, min(level, 99.9));
    animate shown { duration: Motion.slow; easing: ease-out; }
    property <float> frac: shown / 100;
    property <float> r: 45;
    // Dot matrix: no label line (the glyph's shade shows wear, as on the phone).
    property <bool> show-label: label != "" && !Dots.on;
    width: size;
    height: size + (!show-label ? 20px : size > 60px ? 52px : 38px);

    if Dots.on: Image {
        x: 0; y: 0; width: size; height: size;
        source: Dots.ring-px(round(size / 1px * Dots.scale), Buds.on && level > 0 ? round(shown) : Buds.on ? level : -1, slot,
            !Buds.on ? Palette.outline : slot == 1 ? Palette.text : Palette.dot-tint(wear),
            Palette.accent, Palette.card.mix(Palette.text2, 0.5));
        image-fit: ImageFit.fill;
        image-rendering: pixelated;
    }
    if !Dots.on: Path {
        x: 0; y: 0; width: size; height: size;
        viewbox-width: 100; viewbox-height: 100;
        stroke: Palette.outline;
        stroke-width: size * 0.06;
        MoveTo { x: 50; y: 5; }
        ArcTo { x: 49.99; y: 5; radius-x: r; radius-y: r; large-arc: true; sweep: true; }
    }
    if level > 0 && !Dots.on: Path {
        x: 0; y: 0; width: size; height: size;
        viewbox-width: 100; viewbox-height: 100;
        stroke: Palette.accent;
        stroke-width: size * 0.06;
        MoveTo { x: 50; y: 5; }
        ArcTo {
            x: 50 + r * sin(frac * 360deg);
            y: 50 - r * cos(frac * 360deg);
            radius-x: r; radius-y: r;
            large-arc: frac > 0.5; sweep: true;
        }
    }
    if !Dots.on: Image {
        source: glyph;
        width: glyph-w; height: glyph-h;
        x: (size - self.width) / 2; y: (size - self.height) / 2;
        colorize: tint;
    }
    Text {
        y: size + 4px; width: size;
        horizontal-alignment: center;
        text: level < 0 ? "–" : level + (Dots.on ? "" : "%") + (charging ? " ⚡" : "");
        color: Palette.text;
        font-size: size > 60px ? 22px : 12px;
        font-weight: 600;
    }
    if show-label: Text {
        y: size + (size > 60px ? 34px : 22px); width: size;
        horizontal-alignment: center;
        text: label;
        color: label-bright ? Palette.text : Palette.text2;
        font-size: size > 60px ? 14px : 12px;
    }
}

// Left, case, right, like the phone's status card; a bud's label is where it is (in ear, out, in case).
component Batteries inherits HorizontalLayout {
    in property <length> size: 90px;
    in property <bool> labels: true;
    alignment: space-around;
    pure function wear-label(wear: int, side: string) -> string {
        if wear == 2 { return Tr.in-ear; }
        if wear == 3 { return Tr.in-case; }
        if wear == 1 { return Tr.out-of-ear; }
        return side;
    }
    Ring {
        size: root.size; level: Buds.left; charging: Buds.left-charging; slot: 0; wear: Buds.left-wear;
        label: labels ? wear-label(Buds.left-wear, Tr.left) : ""; label-bright: Buds.left-wear == 2;
        glyph: Buds.icon-left; glyph-w: root.size * 0.32; glyph-h: root.size * 0.5;
        tint: Palette.wear-tint(Buds.left-wear);
    }
    Ring {
        size: root.size; level: Buds.case; charging: Buds.case-charging; label: labels ? Tr.case : ""; slot: 1;
        glyph: Buds.icon-case; glyph-w: root.size * 0.5; glyph-h: root.size * 0.4;
    }
    Ring {
        size: root.size; level: Buds.right; charging: Buds.right-charging; slot: 2; wear: Buds.right-wear;
        label: labels ? wear-label(Buds.right-wear, Tr.right) : ""; label-bright: Buds.right-wear == 2;
        glyph: Buds.icon-right; glyph-w: root.size * 0.32; glyph-h: root.size * 0.5;
        tint: Palette.wear-tint(Buds.right-wear);
    }
}

component Segment inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> selected;
    in property <bool> compact;
    in property <bool> enabled: Buds.on;
    callback clicked;
    // Equal widths, whatever the label length.
    preferred-width: 0;
    horizontal-stretch: 1;
    border-radius: min(self.height, self.width) / 2;
    // Dot matrix: the selected segment is an accent outline, the track inside (not a fill).
    property <color> lit: Dots.on ? Palette.accent : Palette.on-accent;
    background: Dots.on ? transparent : selected ? Palette.accent : ta.has-hover ? Palette.outline : transparent;
    animate background { duration: Motion.fast; }
    if Dots.on && (selected || ta.has-hover): DotBox {
        width: 100%; height: 100%;
        radius: min(root.height / 2 * 0.85, 22px);
        fill: Palette.card;
        stroke: selected ? Palette.accent : Palette.outline;
    }
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        padding-top: 6px;
        padding-bottom: 6px;
        if icon.width > 0: HorizontalLayout {
            alignment: center;
            Image {
                source: icon; width: 24px; height: 24px;
                colorize: selected ? lit : Palette.text2;
            }
        }
        if !compact: Text {
            text: label;
            horizontal-alignment: center;
            font-size: 12px;
            color: selected ? lit : Palette.text2;
            overflow: elide;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Off / ANC / Adaptive / Transparency. ANC slides the modes out and the buds' levels in (the phone's
// and the widget's picker): a pick sends it, the lit level sends Off, 2 s without a pick slides back.
component AncSegments inherits Rectangle {
    in property <bool> compact;
    property <bool> picking;
    property <bool> on: Buds.on;
    changed on => { if !on { picking = false; } }
    clip: true;
    HorizontalLayout {
        x: picking ? root.width : 0;
        width: root.width;
        height: root.height;
        animate x { duration: Motion.slow; easing: ease-in-out; }
        spacing: 4px;
        if Buds.has-off: Segment {
            compact: root.compact; icon: Buds.icon-off; label: Tr.off;
            selected: Buds.anc == "Off"; clicked => { Buds.set-anc("Off"); }
        }
        if Buds.levels.length > 0: Segment {
            compact: root.compact; icon: Buds.icon-anc; label: Buds.anc-label;
            selected: Buds.anc-is-level;
            clicked => { if Buds.levels.length > 1 { picking = true; } else { Buds.set-anc("ANC"); } }
        }
        if Buds.has-adaptive: Segment {
            compact: root.compact; icon: Buds.icon-adaptive; label: Tr.adaptive;
            selected: Buds.anc == "Adaptive"; clicked => { Buds.set-anc("Adaptive"); }
        }
        if Buds.has-transparency: Segment {
            compact: root.compact; icon: Buds.icon-transparency; label: Tr.transparency;
            selected: Buds.anc == "Transparency"; clicked => { Buds.set-anc("Transparency"); }
        }
    }
    HorizontalLayout {
        x: picking ? 0 : -root.width;
        width: root.width;
        height: root.height;
        animate x { duration: Motion.slow; easing: ease-in-out; }
        spacing: 4px;
        for l in Buds.levels: Segment {
            compact: root.compact; icon: l.icon; label: l.name;
            selected: Buds.anc == l.id;
            clicked => { picking = false; Buds.set-anc(Buds.anc == l.id ? "Off" : l.id); }
        }
    }
    Timer {
        interval: 2280ms;
        running: picking;
        triggered => { picking = false; }
    }
}

component Toggle inherits Rectangle {
    in property <bool> checked;
    in property <bool> live;
    in property <bool> locked;
    opacity: locked ? 0.4 : 1;
    callback toggled(bool);
    // The phone's switch: a thin track under a thumb as tall as the switch, light grey when off.
    width: 44px;
    height: 24px;
    if !Dots.on: Rectangle {
        x: 6px; y: 6px; width: parent.width - 12px; height: 12px; border-radius: 6px;
        background: Palette.track;
    }
    // Dot matrix: a dot track and a round dot thumb.
    if Dots.on: DotBox {
        x: 4px; y: 6px; width: parent.width - 8px; height: 12px;
        fill: Palette.track; stroke: Palette.track; radius: 5px;
    }
    property <int> thumb-cells: floor(22px / 1px * Dots.scale / Dots.pitch);
    if Dots.on: Image {
        width: thumb-cells * Dots.pitch / Dots.scale * 1px; height: self.width;
        y: (root.height - self.height) / 2;
        x: root.checked ? root.width - self.width : 0;
        animate x { duration: Motion.fast; }
        source: Dots.disc-px(thumb-cells, root.checked ? Palette.accent : Palette.thumb-off, root.checked ? Palette.accent : Palette.thumb-off);
        image-fit: ImageFit.fill;
        image-rendering: pixelated;
    }
    if !Dots.on: Rectangle {
        width: 22px; height: 22px; border-radius: 11px;
        background: root.checked ? Palette.accent : Palette.thumb-off;
        // A light theme's thumb is the card's own colour: the track's shade outlines it.
        border-width: Palette.light && !root.checked ? 1px : 0;
        border-color: Palette.track;
        animate background { duration: Motion.fast; }
        y: 1px;
        x: root.checked ? root.width - 23px : 1px;
        animate x { duration: Motion.fast; }
    }
    TouchArea {
        enabled: (Buds.on || root.live) && !root.locked;
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
}

component LowLatencyRow inherits HorizontalLayout {
    spacing: 12px;
    Image {
        source: Buds.icon-low-latency; width: 24px; height: 24px;
        colorize: Palette.accent;
        y: (parent.height - self.height) / 2;
    }
    Text {
        text: Tr.low-latency; color: Palette.text; font-size: 14px;
        vertical-alignment: center; horizontal-stretch: 1;
    }
    VerticalLayout {
        alignment: center;
        Toggle {
            checked: Buds.low-latency;
            toggled(on) => { Buds.set-low-latency(on); }
        }
    }
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    callback clicked;
    height: 34px;
    min-width: label.preferred-width + 28px;
    border-radius: 17px;
    background: Dots.on ? transparent : primary ? Palette.accent : ta.has-hover ? Palette.outline : transparent;
    border-width: primary || Dots.on ? 0 : 1px;
    border-color: Palette.outline-strong;
    animate background { duration: Motion.fast; }
    // Dot matrix: an outline, accent for the primary chip.
    if Dots.on: DotBox {
        width: 100%; height: 100%; radius: 14px;
        fill: ta.has-hover ? Palette.outline : Palette.card;
        stroke: root.primary ? Palette.accent : Palette.outline-strong;
    }
    label := Text {
        text: root.text;
        color: root.primary ? (Dots.on ? Palette.accent : Palette.on-accent) : Palette.text;
        font-size: 13px;
        font-weight: 600;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export struct NavEntry {
    icon: image,
    name: string,
    ready: bool,
}

component NavItem inherits Rectangle {
    in property <NavEntry> entry;
    in property <bool> active;
    callback clicked;
    height: entry.ready ? 40px : 0px;
    visible: entry.ready;
    border-radius: 10px;
    // Classic: the active highlight is the sidebar's sliding indicator, so it reports where it is.
    callback at(length);
    init => { if active { at(self.y); } }
    changed active => { if active { at(self.y); } }
    changed y => { if active { at(self.y); } }
    background: Dots.on || active ? transparent : ta.has-hover && entry.ready ? Palette.outline : transparent;
    animate background { duration: Motion.fast; }
    if Dots.on && (active || (ta.has-hover && entry.ready)): DotBox {
        width: 100%; height: 100%; radius: 10px;
        fill: Palette.sidebar; stroke: active ? Palette.accent : Palette.outline;
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        Image {
            source: entry.icon; width: 20px; height: 20px; y: (parent.height - self.height) / 2;
            colorize: active ? Palette.accent : Palette.text;
        }
        Text {
            text: entry.name; vertical-alignment: center; horizontal-stretch: 1;
            color: Palette.text; font-size: 14px; font-weight: active ? 600 : 400;
        }
    }
    ta := TouchArea {
        enabled: entry.ready;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A page fades in and lifts 8px when it opens. Slint has no exit animation for `if`, so only the entry moves.
component PageIn inherits Rectangle {
    property <float> t;
    init => { t = 1; }
    animate t { duration: Motion.slow; easing: ease-out; }
    horizontal-stretch: 1;
    Rectangle {
        y: (1 - root.t) * 8px; height: root.height; opacity: root.t;
        @children
    }
}

// A dialog's card: it fades in and grows from 96% when the popup opens (the popup builds it on each show).
component DialogCard inherits Rectangle {
    property <float> t;
    init => { t = 1; }
    animate t { duration: Motion.base; easing: ease-out; }
    opacity: t;
    transform-scale: 0.96 + 0.04 * t;
    // Solid behind the dots: the page must not show through the gaps.
    background: Dots.on ? Palette.bg : Palette.card;
    border-radius: 14px;
    border-width: Dots.on ? 0 : 1px;
    border-color: Palette.outline;
    if Dots.on: DotBox { width: 100%; height: 100%; radius: 14px; }
    @children
}

component SectionTitle inherits Text {
    color: Palette.text2;
    font-size: 12px;
    font-weight: 600;
}

component FeatureRow inherits HorizontalLayout {
    in property <image> icon;
    in property <string> title;
    in property <string> subtitle;
    in property <bool> checked;
    // A row that opens a page (`NavRow`): a chevron instead of the switch.
    in property <bool> chevron;
    // Neither switch nor chevron (an info row).
    in property <bool> no-end;
    // The current value, left of the chevron.
    in property <string> value;
    // Works while disconnected (an app setting).
    in property <bool> live;
    in property <bool> locked;
    callback toggled(bool);
    spacing: 16px;
    height: 64px;
    if icon.width > 0: Image { source: icon; width: 24px; height: 24px; y: (parent.height - self.height) / 2; image-fit: contain; colorize: Palette.accent; }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 2px;
        Text { text: title; color: Palette.text; font-size: 15px; }
        if subtitle != "": Text { text: subtitle; color: Palette.text2; font-size: 12px; overflow: elide; }
    }
    if !chevron: VerticalLayout {
        alignment: center;
        Toggle { checked: root.checked; live: root.live; locked: root.locked; toggled(on) => { root.toggled(on); } }
    }
    if value != "": Text { text: value; color: Palette.text2; font-size: 13px; vertical-alignment: center; horizontal-alignment: right; overflow: elide; max-width: 260px; }
    if chevron && !no-end: Image {
        source: Buds.icon-chevron; width: 20px; height: 20px; y: (parent.height - self.height) / 2;
        colorize: Palette.accent;
    }
}

// A feature row that opens a page: the whole row is the button.
component NavRow inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> subtitle;
    in property <bool> chevron: true;
    in property <string> value;
    callback clicked;
    height: 64px;
    FeatureRow { width: 100%; icon: root.icon; title: root.title; subtitle: root.subtitle; chevron: true; no-end: !root.chevron; value: root.value; }
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A row divider inside a card.
component Divider inherits Rectangle {
    height: Dots.on ? Dots.pitch / Dots.scale * 1px : 1px;
    background: Dots.on ? transparent : Palette.outline;
    if Dots.on: DotBox { width: 100%; height: 100%; radius: 0; fill: Palette.outline; stroke: Palette.outline; }
}

component CaptionButton inherits Rectangle {
    in property <bool> danger;
    callback clicked;
    width: 46px;
    background: ta.has-hover ? (danger ? #C42B1C : Palette.outline) : transparent;
    ta := TouchArea { clicked => { root.clicked(); } }
    @children
}

component TitleBar inherits Rectangle {
    in property <bool> maximized;
    callback drag();
    callback minimize();
    callback toggle-maximize();
    callback close();
    height: 40px;
    background: Palette.sidebar;
    TouchArea {
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left { root.drag(); }
        }
        double-clicked => { root.toggle-maximize(); }
    }
    HorizontalLayout {
        padding-left: 16px;
        spacing: 10px;
        Image { source: Buds.icon-app; width: 20px; height: 20px; y: (parent.height - self.height) / 2; }
        Text { text: "QuickBuds"; color: Palette.text; font-size: 13px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
        CaptionButton {
            clicked => { root.minimize(); }
            Rectangle { width: 10px; height: 1px; background: Palette.text; }
        }
        CaptionButton {
            clicked => { root.toggle-maximize(); }
            Rectangle { width: 10px; height: 10px; border-width: 1px; border-color: Palette.text; }
        }
        CaptionButton {
            danger: true;
            clicked => { root.close(); }
            Path {
                width: 10px; height: 10px;
                viewbox-width: 10; viewbox-height: 10;
                stroke: Palette.text; stroke-width: 1px;
                commands: "M0 0 L10 10 M10 0 L0 10";
            }
        }
    }
}

export struct EqRow {
    id: int,
    name: string,
    // Sent to the buds, not listed by them yet: dimmed, not clickable.
    pending: bool,
}

// The Equalizer page's state, filled from Rust (`App::apply`).
export global Eq {
    in property <[EqRow]> builtins;
    in property <[EqRow]> customs;
    in property <int> current: -1;
    in property <bool> has-custom;
    in property <bool> can-add;
    in property <bool> has-bass;
    in property <bool> bass-on;
    in-out property <int> bass-level;
    // The selected custom preset, in the editor.
    in property <bool> editing;
    in-out property <string> edit-name;
    in property <[int]> gains;
    in property <[string]> freq-labels;
    // Path commands in the plot's own pixels (a Path keeps its viewbox's aspect ratio).
    in property <string> curve;
    // The Dot matrix curve, set from Rust with `curve`.
    in property <image> curve-dots;
    callback plot-resized(float, float);
    // A knob or slider is held: Rust leaves the values alone.
    in-out property <bool> dragging;

    callback select-builtin(int);
    callback select-custom(int);
    callback add();
    callback delete();
    callback rename(string);
    callback band-moved(int, int);
    callback band-released(int, int);
    callback bass-toggled(bool);
    callback bass-released(int);
}

// A row in a preset Card: flat, the selected one has an accent bar and accent text.
component PresetRow inherits Rectangle {
    in property <string> name;
    in property <bool> selected;
    in property <bool> enabled: Buds.on;
    callback clicked;
    height: 40px;
    border-radius: 10px;
    background: ta.has-hover ? Palette.outline : transparent;
    animate background { duration: Motion.fast; }
    Rectangle {
        x: 6px; y: (parent.height - self.height) / 2;
        width: 3px; height: selected ? 18px : 0;
        border-radius: 1.5px;
        background: Palette.accent;
        animate height { duration: Motion.fast; easing: ease-out; }
    }
    Text {
        x: 18px; width: parent.width - 36px;
        text: name; overflow: elide; vertical-alignment: center;
        color: selected ? Palette.accent : Palette.text; font-size: 14px;
        font-weight: selected ? 600 : 400;
    }
    ta := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component AddRow inherits Rectangle {
    in property <string> text;
    callback clicked;
    height: 40px;
    border-radius: 10px;
    background: ta.has-hover ? Palette.outline : transparent;
    animate background { duration: Motion.fast; }
    HorizontalLayout {
        padding-left: 14px;
        spacing: 10px;
        Image { source: Buds.icon-plus; width: 18px; height: 18px; y: (parent.height - self.height) / 2; colorize: Palette.accent; }
        Text { text: root.text; color: Palette.text; font-size: 14px; vertical-alignment: center; }
    }
    ta := TouchArea { enabled: Buds.on; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component HSlider inherits Rectangle {
    in property <int> minimum;
    in property <int> maximum;
    in-out property <int> value;
    in property <bool> show-value: true;
    callback released(int);
    height: 48px;
    property <length> knob: Dots.on ? Dots.knob-size : 20px;
    property <length> track-y: 30px;
    property <float> frac: (value - minimum) / (maximum - minimum);
    if !Dots.on: Rectangle { y: track-y - 3px; height: 6px; border-radius: 3px; background: Palette.outline; }
    if !Dots.on: Rectangle {
        x: 0; y: track-y - 3px; height: 6px; border-radius: 3px;
        width: frac * (parent.width - knob) + knob / 2;
        background: Palette.accent;
    }
    // Dot matrix: a dot track, the accent part a second track over it, and the dot knob.
    if Dots.on: DotBox { x: 0; y: track-y - 4px; width: parent.width; height: 8px; radius: 3px; fill: Palette.outline; stroke: Palette.outline; }
    if Dots.on: DotBox {
        x: 0; y: track-y - 4px; height: 8px; radius: 3px; fill: Palette.accent; stroke: Palette.accent;
        width: frac * (parent.width - knob) + knob / 2;
    }
    if Dots.on: Image {
        x: frac * (parent.width - knob); y: track-y - knob / 2; width: knob; height: knob;
        source: Dots.knob(Palette.accent, Palette.card);
        image-fit: ImageFit.fill; image-rendering: pixelated;
    }
    if !Dots.on: Rectangle {
        x: frac * (parent.width - knob); y: track-y - knob / 2;
        width: knob; height: knob; border-radius: knob / 2;
        background: Palette.card;
        border-width: 3px; border-color: Palette.accent;
    }
    if show-value: Text {
        x: frac * (parent.width - knob) + knob / 2 - 20px; y: 0; width: 40px;
        horizontal-alignment: center;
        text: (value > 0 ? "+" : "") + value;
        color: Palette.accent; font-size: 13px; font-weight: 600;
    }
    function set-from(x: length) {
        root.value = clamp(round(minimum + (x - knob / 2) / (root.width - knob) * (maximum - minimum)), minimum, maximum);
    }
    TouchArea {
        enabled: Buds.on;
        mouse-cursor: pointer;
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down { Eq.dragging = true; set-from(self.mouse-x); }
            if ev.kind == PointerEventKind.up { Eq.dragging = false; root.released(root.value); }
        }
        moved => { if self.pressed { set-from(self.mouse-x); } }
    }
}

component EqEditor inherits Rectangle {
    property <length> knob: Dots.on ? Dots.knob-size : 18px;
    property <length> labels: 36px;
    property <length> plot-h: self.height - labels;
    property <length> band-w: self.width / max(1, Eq.gains.length);
    // The +6 / 0 / -6 guides
    for f in [0, 0.5, 1]: Rectangle {
        y: knob / 2 + f * (plot-h - knob); height: 1px;
        background: f == 0.5 ? Palette.outline-strong : Palette.outline;
    }
    changed width => { Eq.plot-resized(root.width / 1px, (plot-h - knob) / 1px); }
    changed height => { Eq.plot-resized(root.width / 1px, (plot-h - knob) / 1px); }
    init => { Eq.plot-resized(root.width / 1px, (plot-h - knob) / 1px); }
    if Dots.on: Image {
        x: 0; y: knob / 2; width: Dots.snap(root.width); height: Dots.snap(plot-h - knob);
        source: Eq.curve-dots;
        image-fit: ImageFit.fill;
        image-rendering: pixelated;
    }
    if !Dots.on: Path {
        x: 0; y: knob / 2; width: root.width; height: plot-h - knob;
        viewbox-width: root.width / 1px; viewbox-height: (plot-h - knob) / 1px;
        stroke: Palette.accent; stroke-width: 2.5px;
        commands: Eq.curve;
    }
    for g[i] in Eq.gains: Rectangle {
        x: i * band-w; y: 0; width: band-w; height: root.height;
        Rectangle { x: (parent.width - 2px) / 2; y: knob / 2; width: 2px; height: plot-h - knob; background: Palette.outline.transparentize(0.4); }
        if Dots.on: Image {
            x: (parent.width - knob) / 2; y: (6 - g) / 12 * (plot-h - knob);
            width: knob; height: knob;
            source: Dots.knob(Palette.accent, ta.pressed || ta.has-hover ? Palette.accent : Palette.card);
            image-fit: ImageFit.fill; image-rendering: pixelated;
        }
        if !Dots.on: Rectangle {
            x: (parent.width - knob) / 2; y: (6 - g) / 12 * (plot-h - knob);
            width: knob; height: knob; border-radius: knob / 2;
            background: ta.pressed || ta.has-hover ? Palette.accent.brighter(0.2) : Palette.accent;
            border-width: 2px; border-color: Palette.card;
        }
        Text {
            y: plot-h + 2px; width: parent.width; horizontal-alignment: center;
            text: Eq.freq-labels[i]; color: Palette.text2; font-size: 11px;
        }
        Text {
            y: plot-h + 17px; width: parent.width; horizontal-alignment: center;
            text: (g > 0 ? "+" : "") + g + " dB"; color: Palette.text; font-size: 11px;
        }
        function set-from(y: length) {
            Eq.band-moved(i, clamp(round(6 - (y - knob / 2) / (plot-h - knob) * 12), -6, 6));
        }
        ta := TouchArea {
            y: 0; height: plot-h;
            enabled: Buds.on;
            mouse-cursor: ns-resize;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down { Eq.dragging = true; set-from(self.mouse-y); }
                if ev.kind == PointerEventKind.up { Eq.dragging = false; Eq.band-released(i, Eq.gains[i]); }
            }
            moved => { if self.pressed { set-from(self.mouse-y); } }
        }
    }
}

component EqPage inherits VerticalLayout {
    padding: 28px;
    spacing: 16px;
    Text { text: Tr.eq-title; color: Palette.text; font-size: 26px; font-weight: 700; }
    if !Buds.on: Text { text: Tr.eq-not-connected; color: Palette.text2; font-size: 13px; }

    HorizontalLayout {
        spacing: 16px;
        vertical-stretch: 1;
        // Presets
        VerticalLayout {
            width: 270px;
            spacing: 16px;
            alignment: start;
            // One card per group, flat rows inside.
            if Eq.builtins.length > 0: VerticalLayout {
                spacing: 8px;
                SectionTitle { text: Tr.eq-recommended; font-size: 13px; font-weight: 400; }
                Card {
                    VerticalLayout {
                        padding: 6px;
                        spacing: 2px;
                        for p in Eq.builtins: PresetRow {
                            name: p.name; selected: Eq.current == p.id;
                            clicked => { Eq.select-builtin(p.id); }
                        }
                    }
                }
            }
            if Eq.has-custom: VerticalLayout {
                spacing: 8px;
                SectionTitle { text: Tr.eq-custom; font-size: 13px; font-weight: 400; }
                if Eq.customs.length > 0 || Eq.can-add: Card {
                    VerticalLayout {
                        padding: 6px;
                        spacing: 2px;
                        for p in Eq.customs: PresetRow {
                            name: p.name; selected: Eq.current == p.id;
                            enabled: Buds.on && !p.pending; opacity: p.pending ? 0.5 : 1;
                            clicked => { Eq.select-custom(p.id); }
                        }
                        if Eq.can-add: AddRow { text: Tr.eq-add; clicked => { Eq.add(); } }
                    }
                }
            }
        }
        // Editor and bass
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 16px;
            Card {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 20px;
                    spacing: 14px;
                    if Eq.editing: HorizontalLayout {
                        spacing: 10px;
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 36px;
                            border-radius: 8px;
                            border-width: Dots.on ? 0 : 1px;
                            border-color: name-input.has-focus ? Palette.accent : Palette.outline;
                            if Dots.on: DotBox {
                                width: 100%; height: 100%; radius: 8px; fill: Palette.card;
                                stroke: name-input.has-focus ? Palette.accent : Palette.outline;
                            }
                            name-input := TextInput {
                                x: 12px; width: parent.width - 24px;
                                text <=> Eq.edit-name;
                                color: Palette.text; font-size: 15px; font-weight: 600;
                                vertical-alignment: center;
                                single-line: true;
                                accepted => { Eq.rename(self.text); self.clear-focus(); }
                            }
                        }
                        Chip { text: Tr.eq-save; clicked => { Eq.rename(name-input.text); name-input.clear-focus(); } }
                        Chip { text: Tr.eq-delete; clicked => { confirm.show(); } }
                    }
                    if Eq.editing: EqEditor { vertical-stretch: 1; min-height: 200px; }
                    if !Eq.editing: Rectangle {
                        vertical-stretch: 1;
                        Text {
                            text: Eq.has-custom ? "Pick a custom preset to edit its bands." : "These earbuds have no custom presets.";
                            color: Palette.text2; font-size: 13px;
                        }
                    }
                }
            }
            if Eq.has-bass: Card {
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 8px;
                    padding-bottom: 12px;
                    FeatureRow {
                        icon: Buds.icon-bass;
                        title: Tr.eq-basswave;
                        subtitle: Tr.eq-basswave-sub;
                        checked: Eq.bass-on;
                        toggled(on) => { Eq.bass-toggled(on); }
                    }
                    if Eq.bass-on: HSlider {
                        minimum: -5; maximum: 5;
                        value <=> Eq.bass-level;
                        released(v) => { Eq.bass-released(v); }
                    }
                }
            }
        }
    }

    confirm := PopupWindow {
        x: (root.width - 320px) / 2;
        y: (root.height - 140px) / 2;
        width: 320px;
        height: 140px;
        DialogCard {
            VerticalLayout {
                padding: 20px;
                spacing: 16px;
                Text { text: Tr.eq-delete + " \"" + Eq.edit-name + "\"?"; color: Palette.text; font-size: 15px; font-weight: 600; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Chip { text: Tr.cancel; }
                    Chip { text: Tr.eq-delete; primary: true; clicked => { Eq.delete(); } }
                }
            }
        }
    }
}

export struct LogRow {
    text: string,
    // 0 sent, 1 from the buds, 2 connection, 3 problem (`devtools.rs`).
    kind: int,
}

// Dev tools' packet log, filled from Rust (`devtools.rs`). Labels stay English-only, like the phone's.
export global DevLog {
    in property <[LogRow]> rows;
    in-out property <int> mode;
    in property <string> note;
    // A monospace font the system has.
    in property <string> font;
    callback refresh();
    callback set-mode(int);
    callback clear();
    callback export();
    callback reconnect();
}

component DevPage inherits VerticalLayout {
    padding: 24px;
    spacing: 12px;
    SectionTitle { text: Tr.dev-tools-title; }
    HorizontalLayout {
        spacing: 8px;
        for m[i] in ["Simple", "Detailed"]: Chip { text: m; primary: DevLog.mode == i; clicked => { DevLog.set-mode(i); } }
        Rectangle { horizontal-stretch: 1; }
        Chip { text: "Clear"; clicked => { DevLog.clear(); } }
        Chip { text: "Export"; clicked => { DevLog.export(); } }
        Chip { text: "Reconnect"; clicked => { DevLog.reconnect(); } }
        Chip { text: "Disconnect"; clicked => { Buds.disconnect(); } }
    }
    if DevLog.note != "": Text { text: DevLog.note; color: Palette.text2; font-size: 12px; }
    // Not a Card: the log stays readable while disconnected.
    Rectangle {
        vertical-stretch: 1;
        background: Palette.card;
        border-radius: 16px;
        border-width: 1px;
        border-color: Palette.outline;
        VerticalLayout { padding: 8px; ListView {
            for r in DevLog.rows: Text {
                text: r.text;
                color: r.kind == 0 ? Palette.accent : r.kind == 2 ? #3FB950 : r.kind == 3 ? #E8A33D : Palette.text;
                font-family: DevLog.font;
                font-size: 12px;
                wrap: word-wrap;
            }
        } }
    }
    // The session thread appends to the log; the page picks the new lines up while it is open.
    Timer { interval: 500ms; running: true; triggered => { DevLog.refresh(); } }
}

export struct FeatureItem {
    id: int,
    icon: image,
    title: string,
    sub: string,
    on: bool,
    // Asked before turning on ("" = never); `confirm-off`: before turning off too.
    confirm: string,
    confirm-off: bool,
    // A picker row under the switch: 0 none, 1 game sound type, 2 head gesture mapping.
    choice-kind: int,
    choice-title: string,
    choice: string,
    // Turning it on runs the Personalized ANC flow instead of a write.
    flow: bool,
    // The switch shows its state but takes no click (Hi-Res with a codec other than LDAC or LHDC V5).
    locked: bool,
}

// The Earbud settings page's state (`earbuds.rs`).
export global Earbuds {
    in property <[FeatureItem]> features;
    // The Overview's switches (`earbuds::home`); id -1 is low latency.
    in property <[FeatureItem]> home;
    in property <[Choice]> codec-choices;
    in property <int> codec-current;
    in property <[Choice]> spatial-choices;
    in property <int> spatial-current;
    in property <bool> has-firmware;
    in property <string> firmware;
    in property <bool> has-find;
    // The locator tone is on: leaving the page or closing the dialog stops it.
    in-out property <bool> find-playing;
    in property <bool> has-alert;
    in-out property <int> alert: 5;
    in property <bool> has-tap;
    in-out property <int> tap: 3;
    in property <int> tap-default: 3;
    in property <bool> has-fit;
    in property <int> fit-left;
    in property <int> fit-right;
    in property <int> fit-seq;
    in property <[Choice]> game-choices;
    in property <int> game-current;
    in property <[Choice]> head-choices;
    in property <int> head-current;
    in property <int> pnc-kind;
    in property <int> pnc-value;
    in property <int> pnc-seq;
    callback pnc-query();
    callback pnc(int);
    callback status-read();
    callback choose(int, int);
    callback fit(bool);
    callback opened();
    callback alert-released(int);
    callback tap-released(int);
    callback set-feature(int, bool);
    callback find(bool);
    public function stop-find() { if find-playing { find-playing = false; find(false); } }
}

// A list to pick one from (the phone's bottom sheet items); the current one has the outline.
component ChoiceDialog inherits PopupWindow {
    in property <string> title;
    in property <[Choice]> items;
    in property <int> current;
    in property <string> message;
    callback picked(int);
    width: 340px;
    DialogCard {
        VerticalLayout {
            padding: 20px;
            spacing: 8px;
            Text { text: root.title; color: Palette.text; font-size: 15px; font-weight: 600; }
            if root.message != "": Text { text: root.message; color: Palette.text2; font-size: 13px; wrap: word-wrap; }
            for c in root.items: PresetRow {
                name: c.label; selected: c.value == root.current;
                clicked => { root.picked(c.value); }
            }
        }
    }
}

// Earbud fit test (`FitTestSheet`): both buds in an ear, Play, one result per bud within 15 s; closing stops it.
component FitDialog inherits PopupWindow {
    // 0 ready, 1 insert the buds, 2 running, 3 failed, 4 perfect, 5 adjust
    property <int> state;
    property <bool> started;
    property <bool> shown-result;
    close-policy: PopupClosePolicy.no-auto-close;
    width: 380px;
    public function stop() { if started { started = false; Earbuds.fit(false); } }
    function play() {
        if Buds.left-wear != 2 || Buds.right-wear != 2 { state = 1; return; }
        state = 2; started = true; shown-result = false;
        Earbuds.fit(true);
    }
    pure function ok(s: int) -> bool { return s == 0 || s == 1 || s == 6; }
    pure function word(s: int) -> string { return s == 1 ? Tr.fit-good : s == 0 ? Tr.fit-average : s == 6 ? Tr.fit-poor : ""; }
    property <int> seq: Earbuds.fit-seq;
    changed seq => {
        if state != 2 { return; }
        if !ok(Earbuds.fit-left) || !ok(Earbuds.fit-right) { state = 3; return; }
        shown-result = true;
        state = Earbuds.fit-left == 1 && Earbuds.fit-right == 1 ? 4 : 5;
    }
    Timer { interval: 15s; running: state == 2; triggered => { state = 3; } }
    DialogCard {
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text {
                text: [Tr.fit-title, Tr.fit-insert, Tr.fit-keep, Tr.fit-failed, Tr.fit-perfect, Tr.fit-adjust][state];
                color: Palette.text; font-size: 15px; font-weight: 600; wrap: word-wrap;
            }
            if state != 2 && state != 4: Text {
                text: state == 5 ? (Earbuds.fit-left != 1 && Earbuds.fit-right != 1 ? Tr.fit-tips-both : Earbuds.fit-left != 1 ? Tr.fit-tips-left : Tr.fit-tips-right) : Tr.fit-hint;
                color: Palette.text2; font-size: 13px; wrap: word-wrap;
            }
            // "Left · Good", a good fit in the accent colour.
            if shown-result: HorizontalLayout {
                alignment: space-around;
                for side[i] in [Earbuds.fit-left, Earbuds.fit-right]: Text {
                    text: (i == 0 ? Tr.bud-left : Tr.bud-right) + " · " + word(side);
                    color: side == 1 ? Palette.accent : Palette.text; font-size: 15px;
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Chip { text: Tr.close; clicked => { stop(); state = 0; shown-result = false; root.close(); } }
                Chip {
                    primary: true;
                    text: state == 2 ? Tr.fit-playing : state == 4 ? Tr.done : state == 5 ? Tr.fit-again : Tr.fit-play;
                    clicked => {
                        if state == 2 { return; }
                        if state == 4 { stop(); state = 0; shown-result = false; root.close(); return; }
                        play();
                    }
                }
            }
        }
    }
}

// Personalized ANC (`PersonalNoiseFlow`): both buds worn, then the stored result if the buds hold one (5 s for
// the answer), else the ear canal test (a result within 15 s; closing cancels it).
component PncDialog inherits PopupWindow {
    // 0 asking, 1 stored result offered, 2 test intro, 3 testing, 4 failed, 5 wear both buds, 6 done
    property <int> state;
    property <int> reason;
    close-policy: PopupClosePolicy.no-auto-close;
    width: 380px;
    pure function worn() -> bool { return Buds.left-wear == 2 && Buds.right-wear == 2; }
    function start() {
        if !worn() { state = 5; return; }
        state = 0;
        Earbuds.pnc-query();
    }
    function test() {
        if !worn() { state = 5; return; }
        state = 3;
        Earbuds.pnc(1);
    }
    function finish() {
        if state == 3 { Earbuds.pnc(3); }
        state = 0;
        root.close();
    }
    property <int> seq: Earbuds.pnc-seq;
    changed seq => {
        if Earbuds.pnc-kind == 1 && state == 0 { state = Earbuds.pnc-value != 0 ? 1 : 2; }
        // A rejected write fails the test as well (status 15: another device busy).
        if Earbuds.pnc-kind == 2 && state == 3 && Earbuds.pnc-value != 0 { reason = 0; state = 4; }
        if Earbuds.pnc-kind == 3 && state == 3 {
            if Earbuds.pnc-value == 0 { state = 6; Earbuds.status-read(); } else { reason = Earbuds.pnc-value; state = 4; }
        }
    }
    Timer { interval: 5s; running: state == 0; triggered => { state = 2; } }
    // The popup's content is built on each show: each opening starts the flow.
    init => { start(); }
    Timer { interval: 15s; running: state == 3; triggered => { reason = 0; state = 4; } }
    DialogCard {
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text {
                text: [Tr.pnc-title, Tr.pnc-stored-title, Tr.pnc-test-title, Tr.pnc-title, Tr.pnc-failed, Tr.pnc-title, Tr.pnc-title][state];
                color: Palette.text; font-size: 15px; font-weight: 600; wrap: word-wrap;
            }
            Text {
                text: [Tr.connecting, Tr.pnc-stored-body, Tr.pnc-test-body, Tr.pnc-testing,
                    ["", Tr.pnc-fail-quiet, Tr.pnc-fail-fit, Tr.pnc-fail-wind, Tr.pnc-fail-still, Tr.pnc-fail-audio][reason <= 5 ? reason : 0],
                    Tr.pnc-wear, Tr.pnc-done][state];
                color: Palette.text2; font-size: 13px; wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Chip {
                    text: state == 1 ? Tr.pnc-test-again : state == 6 ? Tr.close : Tr.cancel;
                    clicked => { if state == 1 { test(); } else { finish(); } }
                }
                if state == 1 || state == 2 || state == 4 || state == 5: Chip {
                    primary: true;
                    text: state == 1 ? Tr.pnc-use : state == 2 ? Tr.pnc-start : Tr.pnc-retry;
                    clicked => {
                        if state == 1 { Earbuds.pnc(2); state = 0; root.close(); }
                        else if state == 5 { start(); }
                        else { test(); }
                    }
                }
            }
        }
    }
}

// Find my earbuds (`FindBudsSheet`): Play / Stop in place; a bud in an ear asks first (the tone is loud).
component FindDialog inherits PopupWindow {
    property <bool> warn;
    close-policy: PopupClosePolicy.no-auto-close;
    width: 360px;
    DialogCard {
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text { text: warn ? Tr.find-warn-title : Tr.find-title; color: Palette.text; font-size: 15px; font-weight: 600; wrap: word-wrap; }
            Text { text: warn ? Tr.find-warn-msg : Tr.find-hint; color: Palette.text2; font-size: 13px; wrap: word-wrap; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Chip { text: Tr.close; clicked => { warn = false; Earbuds.stop-find(); root.close(); } }
                Chip {
                    primary: true;
                    text: Earbuds.find-playing ? Tr.find-stop : warn ? Tr.find-warn-play : Tr.find-play;
                    clicked => {
                        if Earbuds.find-playing {
                            Earbuds.stop-find();
                        } else if !warn && (Buds.left-wear == 2 || Buds.right-wear == 2) {
                            warn = true;
                        } else {
                            warn = false;
                            Earbuds.find-playing = true;
                            Earbuds.find(true);
                        }
                    }
                }
            }
        }
    }
}

// A centred dialog: title, body, and Cancel / OK (`ConfirmDialog`); no Cancel with `cancel` "".
component Dialog inherits PopupWindow {
    in property <string> title;
    in property <string> body;
    in property <string> ok: Tr.ok;
    in property <string> cancel: Tr.cancel;
    callback accepted();
    width: 360px;
    DialogCard {
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text { text: root.title; color: Palette.text; font-size: 15px; font-weight: 600; wrap: word-wrap; }
            if root.body != "": Text { text: root.body; color: Palette.text2; font-size: 13px; wrap: word-wrap; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                if root.cancel != "": Chip { text: root.cancel; }
                Chip { text: root.ok; primary: true; clicked => { root.accepted(); } }
            }
        }
    }
}

// Earbud settings (`EarbudSettingsActivity`): the switches these buds list, and the firmware version.
component EarbudsPage inherits Rectangle {
    callback open-models();
    init => { Earbuds.opened(); }
    property <int> ask-id;
    property <bool> ask-on;
    property <string> ask-title;
    property <string> ask-body;
    ScrollView {
        VerticalLayout {
            padding: 28px;
            spacing: 16px;
            alignment: start;
            Text { text: Tr.earbuds-title; color: Palette.text; font-size: 26px; font-weight: 700; }
            if !Buds.on: Text { text: Tr.not-connected; color: Palette.text2; font-size: 13px; }
            // Not a Card: the model list works while disconnected too.
            Rectangle {
                height: 64px;
                border-radius: 24px;
                background: Dots.on ? transparent : Palette.card;
                border-width: Dots.on ? 0 : 1px;
                border-color: Palette.outline;
                if Dots.on: DotBox { width: 100%; height: 100%; radius: 24px; }
                NavRow {
                    x: 20px; width: parent.width - 40px;
                    icon: Buds.icon-earbud; title: Tr.model-title;
                    subtitle: Models.current == "" ? Tr.model-auto + " · " + Models.detected : Models.model-name;
                    clicked => { root.open-models(); }
                }
            }
            if Earbuds.has-find || Earbuds.has-fit: Card {
                border-radius: 24px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    if Earbuds.has-find: NavRow { icon: Buds.icon-find; title: Tr.find-row-title; subtitle: Tr.find-row-sub; clicked => { if Buds.on { find.show(); } } }
                    if Earbuds.has-find && Earbuds.has-fit: Divider {}
                    if Earbuds.has-fit: NavRow { icon: Buds.icon-earbud; title: Tr.fit-title; subtitle: Tr.fit-sub; clicked => { if Buds.on { fit.show(); } } }
                }
            }
            if Earbuds.features.length > 0: SectionTitle { text: Tr.section-features; font-size: 13px; font-weight: 400; }
            if Earbuds.features.length > 0: Card {
                border-radius: 24px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    for f[i] in Earbuds.features: VerticalLayout {
                        if i > 0: Divider {}
                        FeatureRow {
                            icon: f.icon; title: f.title; subtitle: f.sub; checked: f.on;
                            toggled(on) => {
                                if f.flow && on {
                                    pnc.show();
                                } else if f.confirm != "" && (on || f.confirm-off) {
                                    ask-id = f.id; ask-on = on; ask-title = f.title; ask-body = f.confirm;
                                    ask.show();
                                } else {
                                    Earbuds.set-feature(f.id, on);
                                }
                            }
                        }
                        if f.choice-kind > 0: Divider {}
                        if f.choice-kind > 0: NavRow {
                            icon: f.icon; title: f.choice-title; subtitle: f.choice;
                            clicked => { if !Buds.on { return; } if f.choice-kind == 1 { game.show(); } else { head.show(); } }
                        }
                    }
                }
            }
            if Earbuds.has-tap: SectionTitle { text: Tr.tap-title; font-size: 13px; font-weight: 400; }
            if Earbuds.has-tap: Card {
                border-radius: 24px;
                VerticalLayout {
                    padding: 20px;
                    padding-bottom: 10px;
                    Text { text: Tr.tap-hint; color: Palette.text2; font-size: 13px; wrap: word-wrap; }
                    HSlider { minimum: 1; maximum: 5; value <=> Earbuds.tap; released(v) => { Earbuds.tap-released(v); } }
                    // Below the buds' default, as HeyMelody warns.
                    if Earbuds.tap < Earbuds.tap-default: Text { text: Tr.tap-warning; color: Palette.text2; font-size: 13px; wrap: word-wrap; }
                }
            }
            if Earbuds.has-alert: SectionTitle { text: Tr.section-sounds; font-size: 13px; font-weight: 400; }
            // No numbers, as in HeyMelody: a speaker left of the bar, muted at the lowest step (level 1 is silent).
            if Earbuds.has-alert: Card {
                border-radius: 24px;
                VerticalLayout {
                    padding: 20px;
                    padding-bottom: 6px;
                    Text { text: Tr.alert-title; color: Palette.text; font-size: 15px; font-weight: 600; }
                    HorizontalLayout {
                        spacing: 12px;
                        Image {
                            source: Earbuds.alert <= 1 ? Buds.icon-volume-off : Buds.icon-volume;
                            width: 22px; height: 22px; y: 22px; colorize: Palette.accent;
                        }
                        HSlider {
                            horizontal-stretch: 1; minimum: 1; maximum: 10; show-value: false;
                            value <=> Earbuds.alert; released(v) => { Earbuds.alert-released(v); }
                        }
                    }
                }
            }
            if Earbuds.has-firmware: SectionTitle { text: Tr.section-about; font-size: 13px; font-weight: 400; }
            // No firmware updates here: a failed flash can brick the buds, so a click points to HeyMelody.
            if Earbuds.has-firmware: Card {
                border-radius: 24px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    NavRow { icon: Buds.icon-info; title: Tr.firmware-title; subtitle: Earbuds.firmware; chevron: false; clicked => { info.show(); } }
                }
            }
        }
    }
    ask := Dialog {
        x: (root.width - self.width) / 2; y: (root.height - 160px) / 2;
        title: root.ask-title; body: root.ask-body;
        accepted => { Earbuds.set-feature(root.ask-id, root.ask-on); }
    }
    game := ChoiceDialog {
        x: (root.width - self.width) / 2; y: 120px;
        title: Tr.game-sound-type-title; items: Earbuds.game-choices; current: Earbuds.game-current;
        picked(v) => { Earbuds.choose(1, v); }
    }
    head := ChoiceDialog {
        x: (root.width - self.width) / 2; y: 120px;
        title: Tr.head-motion-type-title; items: Earbuds.head-choices; current: Earbuds.head-current;
        picked(v) => { Earbuds.choose(2, v); }
    }
    pnc := PncDialog {
        x: (root.width - self.width) / 2; y: 120px;
    }
    fit := FitDialog {
        x: (root.width - self.width) / 2; y: 120px;
    }
    find := FindDialog {
        x: (root.width - self.width) / 2; y: (root.height - 160px) / 2;
    }
    info := Dialog {
        x: (root.width - self.width) / 2; y: (root.height - 180px) / 2;
        title: Tr.firmware-dialog-title; body: Tr.firmware-dialog-body; ok: Tr.close; cancel: "";
    }
}

export struct ModelRow {
    id: string,
    name: string,
    // The id, where two rows share a name.
    sub: string,
}

export struct ModelSection {
    title: string,
    rows: [ModelRow],
}

// The model list's state (`models.rs`).
export global Models {
    in property <[ModelSection]> sections;
    // The manual pick's id, "" = Automatic.
    in property <string> current;
    in property <string> detected;
    in property <string> model-name;
    callback pick(string);
}

// The model list (`ModelActivity`): Automatic, then every model by brand. Selection is an outline.
component ModelsPage inherits Rectangle {
    callback back();
    ScrollView {
        VerticalLayout {
            padding: 28px;
            spacing: 8px;
            alignment: start;
            HorizontalLayout {
                spacing: 12px;
                Chip { text: "‹"; width: 40px; clicked => { root.back(); } }
                Text { text: Tr.model-title; color: Palette.text; font-size: 26px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
            }
            Card {
                live: true;
                VerticalLayout {
                    padding: 6px;
                    PresetRow { name: Tr.model-auto + "   ·   " + Models.detected; selected: Models.current == ""; enabled: true; clicked => { Models.pick(""); } }
                }
            }
            for sec in Models.sections: VerticalLayout {
                spacing: 8px;
                padding-top: 8px;
                SectionTitle { text: sec.title; font-size: 13px; font-weight: 400; }
                Card {
                    live: true;
                    VerticalLayout {
                        padding: 6px;
                        spacing: 2px;
                        for m in sec.rows: PresetRow {
                            name: m.sub == "" ? m.name : m.name + "  (" + m.sub + ")";
                            selected: Models.current == m.id; enabled: true;
                            clicked => { Models.pick(m.id); }
                        }
                    }
                }
            }
        }
    }
}

export struct ControlsRow {
    icon: image,
    title: string,
    value: string,
}

export struct Pick {
    value: int,
    label: string,
    on: bool,
}

// Controls' state (`controls.rs`); the dialogs are filled from Rust when a row opens.
export global Controls {
    in property <[ControlsRow]> rows;
    in property <[ControlsRow]> calls;
    in property <int> side;
    // A neckband: no Left / Right.
    in property <bool> one-button;
    in property <string> dialog-title;
    in property <[Choice]> choices;
    in property <int> choice-current;
    in property <[Pick]> picks;
    in property <string> pick-message;
    callback opened();
    callback set-side(int);
    // 1 a list to pick one from, 2 the per-bud hold's choices, 3 the hold's noise modes.
    callback open-row(int) -> int;
    callback open-call(int);
    // 3: the noise modes open next.
    callback picked(int) -> int;
    callback toggle(int);
    callback done();
}

// The hold's noise modes (several, cycled in order): a click toggles, Done writes.
component PickDialog inherits PopupWindow {
    close-policy: PopupClosePolicy.no-auto-close;
    width: 340px;
    DialogCard {
        VerticalLayout {
            padding: 20px;
            spacing: 8px;
            Text { text: Controls.dialog-title; color: Palette.text; font-size: 15px; font-weight: 600; }
            for p in Controls.picks: PresetRow { name: p.label; selected: p.on; clicked => { Controls.toggle(p.value); } }
            if Controls.pick-message != "": Text { text: Controls.pick-message; color: Palette.text2; font-size: 13px; wrap: word-wrap; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Chip { text: Tr.cancel; clicked => { root.close(); } }
                Chip { text: Tr.done; primary: true; clicked => { Controls.done(); root.close(); } }
            }
        }
    }
}

// Controls (`GestureActivity`): Left / Right, the gestures of that bud, then the on-call rows (both buds).
component ControlsPage inherits Rectangle {
    init => { Controls.opened(); }
    ScrollView {
        VerticalLayout {
            padding: 28px;
            spacing: 16px;
            alignment: start;
            Text { text: Tr.gesture-title; color: Palette.text; font-size: 26px; font-weight: 700; }
            if !Buds.on: Text { text: Tr.not-connected; color: Palette.text2; font-size: 13px; }
            if !Controls.one-button: HorizontalLayout {
                alignment: start;
                Rectangle {
                    width: 320px;
                    height: 44px;
                    border-radius: self.height / 2;
                    background: Dots.on ? transparent : Palette.card;
                    border-width: Dots.on ? 0 : 1px;
                    border-color: Palette.outline;
                    if Dots.on: DotBox { width: 100%; height: 100%; radius: 20px; }
                    HorizontalLayout {
                        padding: 4px;
                        spacing: 4px;
                        Segment { enabled: true; label: Tr.bud-left; selected: Controls.side == 0; clicked => { Controls.set-side(0); } }
                        Segment { enabled: true; label: Tr.bud-right; selected: Controls.side == 1; clicked => { Controls.set-side(1); } }
                    }
                }
            }
            if Controls.rows.length > 0: SectionTitle { text: Tr.gesture-not-in-call; font-size: 13px; font-weight: 400; }
            if Controls.rows.length > 0: Card {
                border-radius: 24px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    for r[i] in Controls.rows: VerticalLayout {
                        if i > 0: Divider {}
                        NavRow {
                            icon: r.icon; title: r.title; subtitle: ""; value: r.value;
                            clicked => {
                                if !Buds.on { return; }
                                let kind = Controls.open-row(i);
                                if kind == 1 || kind == 2 { choice.show(); }
                                if kind == 3 { picks.show(); }
                            }
                        }
                    }
                }
            }
            if Controls.calls.length > 0: SectionTitle { text: Tr.gesture-on-call; font-size: 13px; font-weight: 400; }
            if Controls.calls.length > 0: Card {
                border-radius: 24px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    for r[i] in Controls.calls: VerticalLayout {
                        if i > 0: Divider {}
                        NavRow {
                            icon: r.icon; title: r.title; subtitle: ""; value: r.value;
                            clicked => { if Buds.on { Controls.open-call(i); choice.show(); } }
                        }
                    }
                }
            }
            Text { text: Tr.gesture-note; color: Palette.text2; font-size: 12px; wrap: word-wrap; }
        }
    }
    choice := ChoiceDialog {
        x: (root.width - self.width) / 2; y: 100px;
        title: Controls.dialog-title; items: Controls.choices; current: Controls.choice-current;
        picked(v) => { if Controls.picked(v) == 3 { picks.show(); } }
    }
    picks := PickDialog {
        x: (root.width - self.width) / 2; y: 100px;
    }
}

export struct RadarLabel {
    x: float,
    y: float,
    text: string,
}

// Hearing profile's state (`hearing.rs`); the test dialog's texts come from Rust as its flow moves on.
export global Hearing {
    in property <bool> on;
    in property <[EqRow]> profiles;
    in property <[string]> delete-names;
    in property <int> active: -1;
    in property <bool> has-test;
    in property <bool> has-radar;
    in-out property <int> ear;
    // The radar as path commands in the plot's own pixels, and as dots (Dot matrix).
    in property <string> grid;
    in property <string> rim;
    in property <string> shape;
    in property <image> grid-dots;
    in property <image> rim-dots;
    in property <image> shape-dots;
    in property <[RadarLabel]> labels;
    in property <string> test-title;
    in property <string> test-message;
    in property <string> test-button;
    in property <bool> test-slider;
    // The result is saved: the main button closes the dialog.
    in property <bool> test-done;
    in-out property <int> test-stop;
    callback opened();
    callback set-on(bool);
    callback pick(int);
    callback delete(int);
    callback set-ear(int);
    callback radar-resized(float, float);
    callback test-open();
    callback test-action();
    callback test-moved(int);
    callback test-closed();
}

// The hearing test (`GoldenTestSheet`): ear scan where the model has one, then a tone per frequency, each set
// to where it just disappears. Closing stops it.
component HearingTestDialog inherits PopupWindow {
    close-policy: PopupClosePolicy.no-auto-close;
    width: 400px;
    property <int> stop: Hearing.test-stop;
    changed stop => { Hearing.test-moved(stop); }
    DialogCard {
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text { text: Hearing.test-title; color: Palette.text; font-size: 15px; font-weight: 600; wrap: word-wrap; }
            if Hearing.test-message != "": Text { text: Hearing.test-message; color: Palette.text2; font-size: 13px; wrap: word-wrap; }
            if Hearing.test-slider: HSlider { minimum: 0; maximum: 24; show-value: false; value <=> Hearing.test-stop; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Chip { text: Tr.close; clicked => { Hearing.test-closed(); root.close(); } }
                Chip {
                    primary: true;
                    text: Hearing.test-button;
                    clicked => { if Hearing.test-done { root.close(); } else { Hearing.test-action(); } }
                }
            }
        }
    }
}

// Hearing profile (`GoldenSoundActivity`): the switch, the active profile's radar, the profiles, the test.
component HearingPage inherits Rectangle {
    init => { Hearing.opened(); }
    property <int> ask-index;
    ScrollView {
        VerticalLayout {
            padding: 28px;
            spacing: 16px;
            alignment: start;
            Text { text: Tr.hearing-title; color: Palette.text; font-size: 26px; font-weight: 700; }
            if !Buds.on: Text { text: Tr.not-connected; color: Palette.text2; font-size: 13px; }
            Card {
                border-radius: 24px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    FeatureRow {
                        icon: Buds.icon-hearing; title: Tr.hearing-title; subtitle: Tr.hearing-sub; checked: Hearing.on;
                        toggled(on) => { Hearing.set-on(on); }
                    }
                }
            }
            // One ear at a time reads better.
            if Hearing.has-radar: Card {
                border-radius: 24px;
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    Rectangle {
                        height: 44px;
                        HorizontalLayout {
                            spacing: 4px;
                            Segment { enabled: true; label: Tr.hearing-left; selected: Hearing.ear == 0; clicked => { Hearing.set-ear(0); } }
                            Segment { enabled: true; label: Tr.hearing-right; selected: Hearing.ear == 1; clicked => { Hearing.set-ear(1); } }
                        }
                    }
                    plot := Rectangle {
                        height: 260px;
                        changed width => { Hearing.radar-resized(self.width / 1px, self.height / 1px); }
                        init => { Hearing.radar-resized(self.width / 1px, self.height / 1px); }
                        if !Dots.on: Path {
                            x: 0; y: 0; width: parent.width; height: parent.height;
                            viewbox-width: parent.width / 1px; viewbox-height: parent.height / 1px;
                            stroke: Palette.outline; stroke-width: 1px; commands: Hearing.grid;
                        }
                        if !Dots.on: Path {
                            x: 0; y: 0; width: parent.width; height: parent.height;
                            viewbox-width: parent.width / 1px; viewbox-height: parent.height / 1px;
                            fill: Palette.text2.transparentize(0.9); stroke: Palette.text2; stroke-width: 2px; commands: Hearing.rim;
                        }
                        if !Dots.on && Hearing.shape != "": Path {
                            x: 0; y: 0; width: parent.width; height: parent.height;
                            viewbox-width: parent.width / 1px; viewbox-height: parent.height / 1px;
                            fill: Palette.accent.transparentize(0.75); stroke: Palette.accent; stroke-width: 2px; commands: Hearing.shape;
                        }
                        for img in Dots.on ? [Hearing.grid-dots, Hearing.rim-dots, Hearing.shape-dots] : []: Image {
                            x: 0; y: 0; width: Dots.snap(parent.width); height: Dots.snap(parent.height);
                            source: img; image-fit: ImageFit.fill; image-rendering: pixelated;
                        }
                        for l in Hearing.labels: Text {
                            x: l.x * 1px - 30px; y: l.y * 1px - 8px; width: 60px;
                            horizontal-alignment: center;
                            text: l.text; color: Palette.text2; font-size: 11px;
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        Rectangle { width: 16px; height: 2px; y: (parent.height - self.height) / 2; background: Palette.text2; }
                        Text { text: Tr.hearing-boost; color: Palette.text2; font-size: 11px; }
                    }
                }
            }
            SectionTitle { text: Tr.hearing-profiles; font-size: 13px; font-weight: 400; }
            if Hearing.profiles.length == 0: Text { text: Tr.hearing-none; color: Palette.text2; font-size: 13px; }
            if Hearing.profiles.length > 0: Card {
                VerticalLayout {
                    padding: 6px;
                    spacing: 2px;
                    for p[i] in Hearing.profiles: HorizontalLayout {
                        spacing: 8px;
                        PresetRow {
                            horizontal-stretch: 1;
                            name: p.name; selected: Hearing.active == i;
                            clicked => { Hearing.pick(i); }
                        }
                        Chip { y: 3px; text: Tr.eq-delete; clicked => { ask-index = i; ask.show(); } }
                    }
                }
            }
            if Hearing.has-test: Card {
                border-radius: 24px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    NavRow {
                        icon: Buds.icon-hearing; title: Tr.hearing-test-row; subtitle: Tr.hearing-test-sub;
                        clicked => { if Buds.on { Hearing.test-open(); test.show(); } }
                    }
                }
            }
        }
    }
    ask := Dialog {
        x: (root.width - self.width) / 2; y: (root.height - 140px) / 2;
        title: Hearing.delete-names[root.ask-index]; body: ""; ok: Tr.eq-delete;
        accepted => { Hearing.delete(root.ask-index); }
    }
    test := HearingTestDialog {
        x: (root.width - self.width) / 2; y: 120px;
    }
}

export struct DualDevice {
    name: string,
    // Connected (this device) / Connected / Not connected
    state: string,
    // "Connect X?" / "Disconnect X?", and its button.
    ask: string,
    action: string,
    can-click: bool,
}

// Dual connection's state (`dual.rs`).
export global Dual {
    in property <bool> on;
    in property <[DualDevice]> devices;
    // The model has HeyMelody's device manager: every paired device is listed and can be (dis)connected.
    in property <bool> manages;
    in property <bool> has-preferred;
    in property <string> preferred;
    in property <[Choice]> preferred-choices;
    in property <int> preferred-current;
    callback opened();
    callback set-dual(bool);
    callback connect-device(int);
    callback set-preferred(int);
}

// Dual connection (`DualDeviceActivity`): the switch, the preferred device, the devices; Add device is instructions.
component DualPage inherits Rectangle {
    init => { Dual.opened(); }
    property <int> ask-index;
    property <string> ask-title;
    property <string> ask-ok;
    ScrollView {
        VerticalLayout {
            padding: 28px;
            spacing: 16px;
            alignment: start;
            Text { text: Tr.dual-title; color: Palette.text; font-size: 26px; font-weight: 700; }
            if !Buds.on: Text { text: Tr.not-connected; color: Palette.text2; font-size: 13px; }
            Card {
                border-radius: 24px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    FeatureRow {
                        icon: Buds.icon-devices; title: Tr.dual-title; subtitle: Tr.dual-switch-sub; checked: Dual.on;
                        toggled(on) => { Dual.set-dual(on); }
                    }
                }
            }
            if Dual.has-preferred: Card {
                border-radius: 24px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    NavRow {
                        icon: Buds.icon-devices; title: Tr.dual-preferred; subtitle: Dual.preferred;
                        clicked => { if Buds.on { preferred.show(); } }
                    }
                }
            }
            SectionTitle { text: Dual.manages ? Tr.dual-section-all : Tr.dual-section-devices; font-size: 13px; font-weight: 400; }
            Card {
                border-radius: 24px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    for d[i] in Dual.devices: VerticalLayout {
                        if i > 0: Divider {}
                        Rectangle {
                            height: 60px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text { text: d.name; color: Palette.text; font-size: 15px; font-weight: 600; overflow: elide; }
                                Text { text: d.state; color: Palette.text2; font-size: 12px; }
                            }
                            if d.can-click: TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if !Buds.on { return; }
                                    ask-index = i; ask-title = d.ask; ask-ok = d.action;
                                    ask.show();
                                }
                            }
                        }
                    }
                    if Dual.devices.length > 0: Divider {}
                    NavRow { icon: Buds.icon-plus; title: Tr.dual-add-title; subtitle: ""; clicked => { add.show(); } }
                }
            }
        }
    }
    ask := Dialog {
        x: (root.width - self.width) / 2; y: (root.height - 140px) / 2;
        title: root.ask-title; body: ""; ok: root.ask-ok;
        accepted => { Dual.connect-device(root.ask-index); }
    }
    preferred := ChoiceDialog {
        x: (root.width - self.width) / 2; y: 120px;
        title: Tr.dual-preferred; message: Tr.dual-preferred-sub;
        items: Dual.preferred-choices; current: Dual.preferred-current;
        picked(v) => { Dual.set-preferred(v); }
    }
    add := Dialog {
        x: (root.width - self.width) / 2; y: (root.height - 200px) / 2;
        title: Tr.dual-add-title; body: Tr.dual-add-message; ok: Tr.ok; cancel: "";
    }
}

// App settings (the phone's Settings and Theme screens): for now the style.
// App settings › Report a problem (`report.rs`).
export global Report {
    in-out property <string> model;
    in-out property <string> description;
    in property <[string]> categories;
    in property <[bool]> picked;
    in-out property <bool> with-log: true;
    // The exact text Send posts, after See the report; "" hides it.
    in property <string> preview;
    in property <string> note;
    in property <bool> busy;
    callback open();
    callback toggle(int);
    callback show-preview();
    callback send();
}

// A text field: one line, or [multi] lines that wrap.
component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> hint;
    in property <bool> multi;
    // Enter, and the field losing focus (one line only).
    callback accepted();
    callback focus-lost();
    height: multi ? 120px : 40px;
    border-radius: 10px;
    background: Dots.on ? transparent : Palette.card;
    border-width: Dots.on ? 0 : 1px;
    border-color: input.has-focus ? Palette.accent : Palette.outline;
    if Dots.on: DotBox {
        width: 100%; height: 100%; radius: 10px; fill: Palette.card;
        stroke: input.has-focus ? Palette.accent : Palette.outline;
    }
    if root.text == "": Text {
        x: 12px; y: root.multi ? 10px : (parent.height - self.height) / 2;
        text: root.hint; color: Palette.text2; font-size: 14px;
    }
    input := TextInput {
        x: 12px; y: root.multi ? 10px : 0;
        width: parent.width - 24px; height: root.multi ? parent.height - 20px : parent.height;
        text <=> root.text;
        color: Palette.text; font-size: 14px;
        single-line: !root.multi;
        wrap: root.multi ? word-wrap : no-wrap;
        vertical-alignment: root.multi ? top : center;
        accepted => { root.accepted(); }
        changed has-focus => { if !self.has-focus { root.focus-lost(); } }
    }
}

component ReportPage inherits Rectangle {
    callback back();
    ScrollView {
        VerticalLayout {
            padding: 28px;
            spacing: 10px;
            alignment: start;
            HorizontalLayout {
                spacing: 12px;
                Chip { text: "‹"; width: 40px; clicked => { root.back(); } }
                Text { text: Tr.problem-title; color: Palette.text; font-size: 26px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
            }
            Text { text: Tr.problem-intro; color: Palette.text2; font-size: 13px; wrap: word-wrap; }
            SectionTitle { text: Tr.problem-model; font-size: 13px; font-weight: 400; }
            Field { text <=> Report.model; }
            SectionTitle { text: Tr.problem-category; font-size: 13px; font-weight: 400; }
            Card {
                live: true;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    for c[i] in Report.categories: FeatureRow {
                        height: 48px; title: c; checked: Report.picked[i]; live: true;
                        toggled => { Report.toggle(i); }
                    }
                }
            }
            SectionTitle { text: Tr.problem-description; font-size: 13px; font-weight: 400; }
            Field { text <=> Report.description; hint: Tr.problem-description-hint; multi: true; }
            Card {
                live: true;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    FeatureRow {
                        icon: Buds.icon-info; title: Tr.problem-log-title;
                        subtitle: "Without Bluetooth addresses or this computer's name";
                        checked: Report.with-log; live: true; toggled(on) => { Report.with-log = on; }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Chip { text: Tr.problem-preview; clicked => { Report.show-preview(); } }
                Chip { text: Report.busy ? Tr.problem-sending : Tr.problem-send; primary: true; clicked => { if !Report.busy { Report.send(); } } }
            }
            if Report.note != "": Text { text: Report.note; color: Palette.text2; font-size: 13px; wrap: word-wrap; }
            if Report.preview != "": Card {
                live: true;
                VerticalLayout {
                    padding: 16px;
                    Text { text: Report.preview; color: Palette.text; font-family: DevLog.font; font-size: 12px; wrap: word-wrap; }
                }
            }
        }
    }
}

// One preset's six colours (`theme.rs`, the phone's `Palette`).
export struct Pal {
    id: string,
    name: string,
    bg: color,
    card: color,
    accent: color,
    text: color,
    text2: color,
    outline: color,
}

// Themes, colors & styles and Edit preset (`theme.rs`; the phone's ThemeActivity and PresetEditActivity).
export global Theme {
    in property <[Pal]> builtins;
    in property <[Pal]> custom;
    in property <Pal> active;
    in property <bool> active-builtin;
    in property <bool> auto;
    in property <string> auto-sub;
    in property <string> custom-title;
    in property <string> new-sub;
    in property <bool> full;
    in property <[color]> swatches;
    in property <[color]> recent;
    in property <[string]> token-names;
    // The preset in Edit preset, as saved, and its contrast warnings ("" none).
    in-out property <Pal> edit;
    in property <[string]> warnings;
    in property <bool> can-duplicate;
    in property <string> delete-title;
    in property <string> delete-body;
    // The system's light or dark mode, for Match system.
    out property <bool> system-light: SysPalette.color-scheme != ColorScheme.dark;
    callback system-changed();
    callback pick(string);
    callback set-auto(bool);
    callback set-accent(color);
    callback remember(string, color);
    callback new-preset() -> bool;
    callback open(string);
    callback set-token(int, color);
    callback rename(string);
    callback duplicate();
    callback delete();
    pure callback hex(color) -> string;
    // Transparent for an entry that is not a colour.
    pure callback parse-hex(string) -> color;
    pure callback track(Pal) -> color;
    // A swatch dot's outer cells: the ring colour only where the colour would vanish into the background.
    pure callback edge(color, color, color) -> color;
    pure callback with-token(Pal, int, color) -> Pal;
    public pure function token(p: Pal, i: int) -> color {
        return i == 0 ? p.bg : i == 1 ? p.card : i == 2 ? p.accent : i == 3 ? p.text : i == 4 ? p.text2 : p.outline;
    }
}

// A preview shape in a preset's colours: a rounded box with an outline (none when transparent), or its dots.
component PBox inherits Rectangle {
    in property <color> fill;
    in property <color> stroke;
    in property <length> r;
    border-radius: Dots.on ? 0 : r;
    background: Dots.on ? transparent : fill;
    border-width: Dots.on || stroke == transparent ? 0 : 1px;
    border-color: stroke;
    if Dots.on: DotBox { width: 100%; height: 100%; radius: root.r; fill: root.fill; stroke: root.stroke == transparent ? root.fill : root.stroke; }
}

// A round dot: a circle, or a disc of `cells` dots on whole pixels.
component PDisc inherits Rectangle {
    in property <color> fill;
    in property <color> ring: fill;
    in property <length> ring-w;
    in property <int> cells: 7;
    border-radius: Dots.on ? 0 : self.width / 2;
    background: Dots.on ? transparent : fill;
    border-width: Dots.on ? 0 : ring-w;
    border-color: ring;
    if Dots.on: Image {
        width: root.cells * Dots.pitch / Dots.scale * 1px;
        height: self.width;
        x: round((root.width - self.width) / 2 * Dots.scale / 1px) / Dots.scale * 1px;
        y: round((root.height - self.height) / 2 * Dots.scale / 1px) / Dots.scale * 1px;
        source: Dots.disc-px(root.cells, root.fill, root.ring);
        image-fit: ImageFit.fill;
        image-rendering: pixelated;
    }
}

// A preset tile (`PalettePreviewView`, not detailed): a card with three rings, a segment pill, a row.
component PalTile inherits Rectangle {
    in property <Pal> p;
    height: 150px;
    property <length> pad: 10px;
    property <length> w: self.width - 2 * pad;
    PBox { width: 100%; height: 100%; r: 18px; fill: p.bg; stroke: p.outline; }
    PBox { x: pad; y: pad; width: w; height: 46px; r: 10px; fill: p.card; stroke: p.outline; }
    for _[i] in 3: PDisc {
        width: Dots.on ? 13 * Dots.pitch / Dots.scale * 1px : 2 * min(w / 6 - 6px, 10px) + 3px;
        height: self.width;
        x: pad + w * (i * 2 + 1) / 6 - self.width / 2;
        y: pad + 23px - self.height / 2;
        fill: Dots.on ? p.accent : transparent; ring: p.accent; ring-w: 3px; cells: 13;
    }
    PBox { x: pad; y: pad + 54px; width: w; height: 22px; r: 11px; fill: p.card; stroke: p.outline; }
    PBox { x: pad + 3px; y: pad + 57px; width: w * 0.3 - 3px; height: 16px; r: 8px; fill: p.accent; stroke: transparent; }
    PBox { x: pad; y: pad + 84px; width: w; height: root.height - 2 * pad - 84px; r: 10px; fill: p.card; stroke: p.outline; }
    PBox { x: pad + 8px; y: pad + 101px; width: w * 0.55 - 8px; height: 4px; r: 2px; fill: p.text; stroke: transparent; }
    PBox { x: pad + 8px; y: pad + 109px; width: w * 0.38 - 8px; height: 3px; r: 2px; fill: p.text2; stroke: transparent; }
    PDisc { x: pad + w - 17px; y: pad + 102px; width: 10px; height: 10px; fill: p.accent; }
}

// Edit preset's preview (`PalettePreviewView`, detailed): the battery card and one switch row.
component PalPreview inherits Rectangle {
    in property <Pal> p;
    height: 200px;
    property <length> pad: 14px;
    property <length> w: self.width - 2 * pad;
    PBox { width: 100%; height: 100%; r: 24px; fill: p.bg; stroke: p.outline; }
    PBox { x: pad; y: pad; width: w; height: 100px; r: 18px; fill: p.card; stroke: p.outline; }
    for lv[i] in [100, 80, 100]: Rectangle {
        x: pad + w * (i * 2 + 1) / 6 - 40px;
        y: pad;
        width: 80px;
        height: 100px;
        property <float> frac: min(lv / 100, 0.999);
        if !Dots.on: Path {
            x: 20px; y: 10px; width: 40px; height: 40px;
            viewbox-width: 100; viewbox-height: 100;
            stroke: root.p.outline;
            stroke-width: 4px;
            MoveTo { x: 50; y: 5; }
            ArcTo { x: 49.99; y: 5; radius-x: 45; radius-y: 45; large-arc: true; sweep: true; }
        }
        if !Dots.on: Path {
            x: 20px; y: 10px; width: 40px; height: 40px;
            viewbox-width: 100; viewbox-height: 100;
            stroke: root.p.accent;
            stroke-width: 4px;
            MoveTo { x: 50; y: 5; }
            ArcTo {
                x: 50 + 45 * sin(frac * 360deg); y: 50 - 45 * cos(frac * 360deg);
                radius-x: 45; radius-y: 45; large-arc: frac > 0.5; sweep: true;
            }
        }
        if Dots.on: Image {
            x: 20px; y: 10px; width: 40px; height: 40px;
            source: Dots.ring-px(round(40 * Dots.scale), lv, -1, root.p.card, root.p.accent, root.p.outline);
            image-fit: ImageFit.fill;
            image-rendering: pixelated;
        }
        Text {
            y: 56px; width: 100%; horizontal-alignment: center;
            text: lv + (Dots.on ? "" : "%");
            color: root.p.text; font-size: 13px; font-weight: 600;
        }
        Text {
            y: 74px; width: 100%; horizontal-alignment: center;
            text: i == 0 ? Tr.left : i == 1 ? Tr.case : Tr.right;
            color: root.p.text2; font-size: 11px;
        }
    }
    PBox { x: pad; y: pad + 110px; width: w; height: root.height - 2 * pad - 110px; r: 18px; fill: p.card; stroke: p.outline; }
    property <length> mid: (pad + 110px + root.height - pad) / 2;
    Image { x: pad + 14px; y: mid - 10px; width: 20px; height: 20px; source: Buds.icon-hires; colorize: p.accent; }
    VerticalLayout {
        x: pad + 46px; y: mid - 18px; width: w - 46px - 64px; height: 36px;
        alignment: center;
        spacing: 2px;
        Text { text: Tr.hires-title; color: root.p.text; font-size: 13px; font-weight: 600; overflow: elide; }
        Text { text: Tr.hires-sub; color: root.p.text2; font-size: 11px; overflow: elide; }
    }
    PBox { x: pad + w - 52px; y: mid - 7px; width: 34px; height: 14px; r: 7px; fill: Theme.track(p); stroke: transparent; }
    PDisc { x: pad + w - 36px; y: mid - 10px; width: 20px; height: 20px; fill: p.accent; cells: 9; }
}

// A colour swatch: a ringed circle, or a 13-dot disc whose outer dots are the ring.
component ColorSwatch inherits PDisc {
    in property <bool> clickable;
    callback clicked;
    width: Dots.on ? 13 * Dots.pitch / Dots.scale * 1px : 30px;
    height: self.width;
    ring: Palette.outline;
    ring-w: 1px;
    cells: 13;
    TouchArea { enabled: root.clickable; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A preset's six colours, 3 by 2 (the phone's SwatchGrid).
component SwatchGrid inherits Rectangle {
    in property <Pal> p;
    property <length> cell: Dots.on ? 8 * Dots.pitch / Dots.scale * 1px : 14px;
    width: Dots.on ? 23 * Dots.pitch / Dots.scale * 1px : 42px;
    height: Dots.on ? 15 * Dots.pitch / Dots.scale * 1px : 28px;
    for _[i] in 6: PDisc {
        property <color> c: Theme.token(root.p, i);
        x: mod(i, 3) * root.cell + (Dots.on ? 0 : 1.5px);
        y: floor(i / 3) * root.cell + (Dots.on ? 0 : 1.5px);
        width: Dots.on ? 7 * Dots.pitch / Dots.scale * 1px : 11px;
        height: self.width;
        fill: c;
        ring: Dots.on ? Theme.edge(c, Palette.bg, Palette.outline) : Palette.outline;
        ring-w: 1px;
    }
}

// One HSV channel of the colour picker (`ColorSliderView`): the track shows what the channel does to the
// colour, the knob is filled with it. `moved` while it drags, `released` on the button going up.
component ColorSlider inherits Rectangle {
    in property <int> channel;
    in property <float> h;
    in property <float> s;
    in property <float> v;
    callback moved(float);
    callback released();
    height: 40px;
    property <float> max: channel == 0 ? 360 : 1;
    property <float> value: channel == 0 ? h : channel == 1 ? s : v;
    property <length> knob-x: 16px + (self.width - 32px) * value / max;
    // The renderer draws a gradient with square corners: the rounded clip makes the pill.
    if !Dots.on: Rectangle {
        y: (parent.height - self.height) / 2;
        height: 26px;
        border-radius: 13px;
        clip: true;
        Rectangle {
            background: root.channel == 0
                ? @linear-gradient(90deg, hsv(0, 0.85, 0.95) 0%, hsv(60, 0.85, 0.95) 16.67%, hsv(120, 0.85, 0.95) 33.33%,
                    hsv(180, 0.85, 0.95) 50%, hsv(240, 0.85, 0.95) 66.67%, hsv(300, 0.85, 0.95) 83.33%, hsv(360, 0.85, 0.95) 100%)
                : root.channel == 1 ? @linear-gradient(90deg, hsv(root.h, 0, root.v) 0%, hsv(root.h, 1, root.v) 100%)
                : @linear-gradient(90deg, hsv(root.h, root.s, 0) 0%, hsv(root.h, root.s, 1) 100%);
        }
    }
    // Dot matrix: five rows of dots; only the channels the track shows go to the renderer.
    if Dots.on: Image {
        width: Dots.snap(parent.width);
        height: 5 * Dots.pitch / Dots.scale * 1px;
        y: round((parent.height - self.height) / 2 * Dots.scale / 1px) / Dots.scale * 1px;
        source: Dots.slider-px(parent.width / 1px * Dots.scale, root.channel, root.channel == 0 ? 0 : root.h,
            root.channel == 2 ? root.s : 0, root.channel == 1 ? root.v : 0);
        image-fit: ImageFit.fill;
        image-rendering: pixelated;
    }
    if !Dots.on: Rectangle {
        x: root.knob-x - 15px; y: (parent.height - self.height) / 2;
        width: 30px; height: 30px; border-radius: 15px;
        background: hsv(root.h, root.s, root.v);
        border-width: 3px; border-color: Palette.text;
    }
    if Dots.on: Image {
        x: root.knob-x - Dots.knob-size / 2; y: (parent.height - self.height) / 2;
        width: Dots.knob-size; height: Dots.knob-size;
        source: Dots.knob(Palette.text, hsv(root.h, root.s, root.v));
        image-fit: ImageFit.fill;
        image-rendering: pixelated;
    }
    function set-from(x: length) { root.moved(clamp((x - 16px) / (root.width - 32px) * max, 0, max)); }
    TouchArea {
        mouse-cursor: pointer;
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down { set-from(self.mouse-x); }
            if ev.kind == PointerEventKind.up { root.released(); }
        }
        moved => { if self.pressed { set-from(self.mouse-x); } }
    }
}

// The inline colour picker (`ColorPickerView`): hue, saturation and brightness, a hex field, five swatches and
// the recent colours. `change` while a slider drags; `commit` on release, Enter in the hex field or a swatch.
// `target` names what it edits: the recent list keeps one colour per drag series on the same target.
component ColorPicker inherits VerticalLayout {
    in property <color> initial;
    in property <string> target;
    callback change(color);
    callback commit(color);
    property <float> h;
    property <float> s;
    property <float> v;
    property <color> now: hsv(h, s, v);
    function load() {
        h = initial.to-hsv().hue;
        s = initial.to-hsv().saturation;
        v = initial.to-hsv().value;
        hex.text = Theme.hex(initial);
    }
    init => { load(); }
    // A commit comes back as the new initial colour: the sliders keep their place when it is the same colour.
    changed initial => { if initial != now { load(); } }
    function done(c: color) { Theme.remember(target, c); root.commit(c); }
    function dragged() { hex.text = Theme.hex(now); root.change(now); }
    function typed() {
        if Theme.parse-hex(hex.text) == transparent { hex.text = Theme.hex(now); }
        else if Theme.parse-hex(hex.text) != now { done(Theme.parse-hex(hex.text)); }
    }
    spacing: 6px;
    ColorSlider { channel: 0; h: root.h; s: root.s; v: root.v; moved(x) => { root.h = x; dragged(); } released => { done(now); } }
    ColorSlider { channel: 1; h: root.h; s: root.s; v: root.v; moved(x) => { root.s = x; dragged(); } released => { done(now); } }
    ColorSlider { channel: 2; h: root.h; s: root.s; v: root.v; moved(x) => { root.v = x; dragged(); } released => { done(now); } }
    HorizontalLayout {
        padding-top: 6px;
        spacing: 8px;
        hex := Field { width: 112px; height: 44px; accepted => { typed(); } focus-lost => { typed(); } }
        Rectangle { horizontal-stretch: 1; }
        for c in Theme.swatches: VerticalLayout {
            alignment: center;
            ColorSwatch {
                fill: c; ring: c == root.initial ? Palette.text : Palette.outline; ring-w: c == root.initial ? 2px : 1px;
                clickable: true; clicked => { done(c); }
            }
        }
    }
    if Theme.recent.length > 0: HorizontalLayout {
        padding-top: 4px;
        spacing: 8px;
        Text { text: Tr.preset-recent; color: Palette.text2; font-size: 13px; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        for c in Theme.recent: VerticalLayout {
            alignment: center;
            ColorSwatch {
                fill: c; ring: c == root.initial ? Palette.text : Palette.outline; ring-w: c == root.initial ? 2px : 1px;
                clickable: true; clicked => { done(c); }
            }
        }
    }
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> enabled: true;
    callback clicked;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    opacity: enabled ? 1 : 0.35;
    background: ta.has-hover && enabled ? Palette.outline : transparent;
    animate background { duration: Motion.fast; }
    Image { source: root.icon; width: 22px; height: 22px; x: 9px; y: 9px; colorize: Palette.accent; }
    ta := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// The selected tile or preset row: an accent outline that fades in.
component Selected inherits Rectangle {
    in property <bool> on;
    in property <length> r;
    opacity: on ? 1 : 0;
    animate opacity { duration: Motion.base; }
    border-radius: r;
    border-width: Dots.on ? 0 : 2px;
    border-color: Palette.accent;
    if Dots.on: DotBox { width: 100%; height: 100%; radius: root.r; fill: transparent; stroke: Palette.accent; }
}

// Themes, colors & styles (`ThemeActivity`): the style, the three built-in presets as tiles, Match system,
// the built-in's accent, then the custom presets (at most 3). A tile or a row applies its preset at once.
component ThemePage inherits Rectangle {
    callback back();
    callback edit();
    property <bool> accent-open;
    // The accent while its picker drags: the active tile and the swatch follow it.
    property <bool> dragging;
    property <color> drag-color;
    property <color> accent: dragging ? drag-color : Theme.active.accent;
    ScrollView {
        VerticalLayout {
            padding: 28px;
            spacing: 10px;
            alignment: start;
            HorizontalLayout {
                spacing: 12px;
                Chip { text: "‹"; width: 40px; clicked => { root.back(); } }
                Text { text: Tr.theme-title; color: Palette.text; font-size: 26px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
            }
            SectionTitle { text: Tr.style-title; font-size: 13px; font-weight: 400; }
            Rectangle {
                height: 48px;
                border-radius: self.height / 2;
                background: Dots.on ? transparent : Palette.card;
                border-width: Dots.on ? 0 : 1px;
                border-color: Palette.outline;
                if Dots.on: DotBox { width: 100%; height: 100%; radius: 20px; }
                HorizontalLayout {
                    padding: 4px;
                    spacing: 4px;
                    Segment { compact: false; enabled: true; label: Tr.style-classic; selected: !Dots.on; clicked => { Dots.set-on(false); } }
                    Segment { compact: false; enabled: true; label: Tr.style-dots; selected: Dots.on; clicked => { Dots.set-on(true); } }
                }
            }
            SectionTitle { text: Tr.theme-builtin; font-size: 13px; font-weight: 400; }
            HorizontalLayout {
                spacing: 12px;
                for b in Theme.builtins: VerticalLayout {
                    property <bool> on: b.id == Theme.active.id;
                    horizontal-stretch: 1;
                    spacing: 8px;
                    Rectangle {
                        height: 150px;
                        PalTile { width: 100%; height: 100%; p: on ? Theme.with-token(b, 2, root.accent) : b; }
                        Selected { x: -4px; y: -4px; width: parent.width + 8px; height: parent.height + 8px; r: 22px; on: on; }
                        TouchArea { mouse-cursor: pointer; clicked => { Theme.pick(b.id); } }
                    }
                    Text {
                        text: b.name; horizontal-alignment: center; font-size: 13px;
                        color: on ? Palette.text : Palette.text2; font-weight: on ? 600 : 400;
                    }
                }
            }
            Card {
                live: true;
                border-radius: 24px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    FeatureRow {
                        title: Tr.theme-auto; subtitle: Theme.auto-sub; checked: Theme.auto; live: true;
                        toggled(on) => { Theme.set-auto(on); }
                    }
                }
            }
            // The applied built-in's accent: the row unfolds the picker.
            if Theme.active-builtin: Card {
                live: true;
                border-radius: 24px;
                background: Dots.on ? transparent : root.accent-open ? Palette.expanded : Palette.card;
                VerticalLayout {
                    Rectangle {
                        height: 64px;
                        HorizontalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            spacing: 16px;
                            VerticalLayout { alignment: center; ColorSwatch { fill: root.accent; } }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: Tr.theme-accent; color: Palette.text; font-size: 15px; }
                                Text { text: Theme.active.name + " · " + Theme.hex(root.accent); color: Palette.text2; font-size: 12px; }
                            }
                            Image {
                                source: root.accent-open ? Buds.icon-chevron-down : Buds.icon-chevron;
                                width: 20px; height: 20px; y: (parent.height - self.height) / 2; colorize: Palette.accent;
                            }
                        }
                        TouchArea { mouse-cursor: pointer; clicked => { root.accent-open = !root.accent-open; } }
                    }
                    if root.accent-open: ColorPicker {
                        padding-left: 20px;
                        padding-right: 20px;
                        padding-bottom: 16px;
                        initial: Theme.active.accent;
                        target: "accent:" + Theme.active.id;
                        change(c) => { root.dragging = true; root.drag-color = c; }
                        commit(c) => { root.dragging = false; Theme.set-accent(c); }
                    }
                }
            }
            SectionTitle { text: Theme.custom-title; font-size: 13px; font-weight: 400; }
            Card {
                live: true;
                border-radius: 24px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    for c in Theme.custom: VerticalLayout {
                        property <bool> on: c.id == Theme.active.id;
                        Rectangle {
                            height: 64px;
                            Selected { x: -12px; y: 4px; width: parent.width + 24px; height: parent.height - 8px; r: 14px; on: on; }
                            TouchArea { mouse-cursor: pointer; clicked => { Theme.pick(c.id); } }
                            HorizontalLayout {
                                spacing: 16px;
                                VerticalLayout { alignment: center; SwatchGrid { p: c; } }
                                Text {
                                    text: c.name; color: Palette.text; font-size: 15px; font-weight: on ? 600 : 400;
                                    vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    IconButton { icon: Buds.icon-pencil; clicked => { Theme.open(c.id); root.edit(); } }
                                }
                            }
                        }
                        Divider {}
                    }
                    Rectangle {
                        height: 64px;
                        opacity: Theme.full ? 0.35 : 1;
                        FeatureRow { width: 100%; icon: Buds.icon-plus; title: Tr.theme-new; subtitle: Theme.new-sub; chevron: true; no-end: true; }
                        TouchArea { enabled: !Theme.full; mouse-cursor: pointer; clicked => { if Theme.new-preset() { root.edit(); } } }
                    }
                }
            }
            Text { text: Tr.theme-footer; color: Palette.text2; font-size: 13px; wrap: word-wrap; }
        }
    }
}

// Edit preset (`PresetEditActivity`): drawn in the active theme, only the preview in the preset's colours. A change
// shows in the preview at once and saves on commit (slider release, Enter, a swatch, the name field's Enter or focus loss).
component PresetPage inherits Rectangle {
    callback back();
    // The colour row whose picker is open, -1 none.
    property <int> expanded: -1;
    // The token a picker drags, and its colour.
    property <int> drag-i: -1;
    property <color> drag-c;
    property <Pal> live: drag-i < 0 ? Theme.edit : Theme.with-token(Theme.edit, drag-i, drag-c);
    property <string> edit-id: Theme.edit.id;
    property <string> edit-name: Theme.edit.name;
    changed edit-id => { expanded = -1; }
    changed edit-name => { name-field.text = edit-name; }
    init => { name-field.text = edit-name; }
    ScrollView {
        VerticalLayout {
            padding: 28px;
            spacing: 10px;
            alignment: start;
            HorizontalLayout {
                spacing: 12px;
                Chip { text: "‹"; width: 40px; clicked => { root.back(); } }
                Text { text: Tr.preset-title; color: Palette.text; font-size: 26px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                IconButton { icon: Buds.icon-copy; enabled: Theme.can-duplicate; clicked => { Theme.duplicate(); } }
                IconButton { icon: Buds.icon-delete; clicked => { del.show(); } }
            }
            SectionTitle { text: Tr.preset-name; font-size: 13px; font-weight: 400; }
            name-field := Field { accepted => { Theme.rename(self.text); } focus-lost => { Theme.rename(self.text); } }
            SectionTitle { text: Tr.preset-preview; font-size: 13px; font-weight: 400; }
            PalPreview { p: root.live; }
            SectionTitle { text: Tr.preset-colors; font-size: 13px; font-weight: 400; }
            Card {
                live: true;
                border-radius: 24px;
                VerticalLayout {
                    for tn[i] in Theme.token-names: VerticalLayout {
                        property <color> c: Theme.token(root.live, i);
                        Rectangle {
                            background: i == root.expanded && !Dots.on ? Palette.expanded : transparent;
                            // The card's own corners on the first and last row.
                            border-top-left-radius: i == 0 ? 24px : 0;
                            border-top-right-radius: i == 0 ? 24px : 0;
                            border-bottom-left-radius: i == 5 ? 24px : 0;
                            border-bottom-right-radius: i == 5 ? 24px : 0;
                            VerticalLayout {
                                Rectangle {
                                    min-height: 64px;
                                    TouchArea { mouse-cursor: pointer; clicked => { root.expanded = root.expanded == i ? -1 : i; } }
                                    HorizontalLayout {
                                        padding-left: 20px;
                                        padding-right: 20px;
                                        padding-top: 10px;
                                        padding-bottom: 10px;
                                        spacing: 16px;
                                        VerticalLayout { alignment: center; ColorSwatch { fill: c; } }
                                        VerticalLayout {
                                            alignment: center;
                                            horizontal-stretch: 1;
                                            spacing: 2px;
                                            Text { text: tn; color: Palette.text; font-size: 15px; }
                                            if Theme.warnings[i] != "": HorizontalLayout {
                                                spacing: 6px;
                                                VerticalLayout { alignment: center; Image { source: Buds.icon-warning; width: 14px; height: 14px; colorize: Palette.accent; } }
                                                Text { text: Theme.warnings[i]; color: Palette.text2; font-size: 12px; overflow: elide; horizontal-stretch: 1; }
                                            }
                                        }
                                        Text { text: Theme.hex(c); color: Palette.text2; font-size: 14px; vertical-alignment: center; }
                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: root.expanded == i ? Buds.icon-chevron-down : Buds.icon-chevron;
                                                width: 20px; height: 20px; colorize: Palette.accent;
                                            }
                                        }
                                    }
                                }
                                if root.expanded == i: ColorPicker {
                                    padding-left: 20px;
                                    padding-right: 20px;
                                    padding-bottom: 16px;
                                    initial: Theme.token(Theme.edit, i);
                                    target: Theme.edit.id + ":" + i;
                                    change(col) => { root.drag-i = i; root.drag-c = col; }
                                    commit(col) => { root.drag-i = -1; Theme.set-token(i, col); }
                                }
                            }
                        }
                        if i < 5: HorizontalLayout { padding-left: 20px; padding-right: 20px; Divider {} }
                    }
                }
            }
        }
    }
    del := Dialog {
        x: (root.width - self.width) / 2; y: 60px;
        title: Theme.delete-title; body: Theme.delete-body; ok: Tr.preset-delete;
        accepted => { Theme.delete(); root.back(); }
    }
}

// Scrolls: the page is taller than the window's first size (issue #9).
component SettingsPage inherits Rectangle {
    callback open-report();
    callback open-theme();
    ScrollView {
        VerticalLayout {
            padding: 28px;
            spacing: 16px;
            alignment: start;
            Text { text: Tr.app-settings-title; color: Palette.text; font-size: 26px; font-weight: 700; }
            Card {
                live: true;
                border-radius: 24px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    NavRow {
                        icon: Buds.icon-language; title: Tr.language-title; subtitle: Tr.language-sub; value: Update.language-name;
                        clicked => { lang.show(); }
                    }
                }
            }
            // Themes, colors & styles: the style, the presets and their colours.
            Card {
                live: true;
                border-radius: 24px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    NavRow {
                        icon: Buds.icon-palette; title: Tr.theme-title;
                        subtitle: Theme.active.name + " · " + (Dots.on ? Tr.style-dots : Tr.style-classic);
                        clicked => { root.open-theme(); }
                    }
                }
            }
            SectionTitle { text: Tr.update-title; font-size: 13px; font-weight: 400; }
            Card {
                live: true;
                border-radius: 24px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    HorizontalLayout {
                        spacing: 8px;
                        FeatureRow {
                            icon: Buds.icon-update; title: Tr.update-installed + " " + Update.installed; subtitle: Update.status;
                            chevron: true; no-end: true;
                        }
                        if Update.available != "": VerticalLayout {
                            alignment: center;
                            Chip {
                                text: Update.can-install ? Tr.update-install : "Open release page"; primary: true;
                                clicked => { if !Update.busy { Update.install(); } }
                            }
                        }
                        VerticalLayout { alignment: center; Chip { text: Tr.update-check; clicked => { Update.check(); } } }
                    }
                    Divider {}
                    FeatureRow {
                        icon: Buds.icon-update; title: Tr.update-auto-title; subtitle: Tr.update-auto-sub;
                        checked: Update.auto; live: true; toggled(on) => { Update.set-auto(on); }
                    }
                    Divider {}
                    FeatureRow {
                        icon: Buds.icon-case; title: Tr.clear-battery-title; subtitle: Tr.clear-battery-sub;
                        checked: Update.clear-battery; live: true; toggled(on) => { Update.set-clear-battery(on); }
                    }
                }
            }
            Card {
                live: true;
                border-radius: 24px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    NavRow { icon: Buds.icon-info; title: Tr.problem-title; subtitle: Tr.problem-sub; clicked => { root.open-report(); } }
                }
            }
        }
    }
    lang := ChoiceDialog {
        x: (root.width - self.width) / 2; y: 60px;
        title: Tr.language-title; items: Update.languages; current: Update.language;
        picked(v) => { Update.set-language(v); }
    }
}

export component MainWindow inherits Window {
    in property <[NavEntry]> nav;
    in-out property <int> page: 0;
    // The page the model list goes back to.
    property <int> models-from: 5;
    changed page => { Earbuds.stop-find(); Hearing.test-closed(); }
    // Match system follows the system's light or dark mode.
    property <bool> system-light: Theme.system-light;
    changed system-light => { Theme.system-changed(); }
    title: "QuickBuds";
    icon: Buds.icon-app;
    min-width: 900px;
    min-height: 580px;
    // Every page fits without a scroll; main.rs fit_screen shrinks it on a small screen.
    preferred-width: 1040px;
    preferred-height: 900px;
    background: Palette.bg;
    default-font-family: Dots.font;
    no-frame: true;
    // Window chrome, handled in Rust (winit): drag, minimize, maximize, hide, edge resize.
    in property <bool> max-state;
    callback drag();
    callback minimize();
    callback toggle-maximize();
    callback close-window();
    // 0 N, 1 S, 2 W, 3 E, 4 NW, 5 NE, 6 SW, 7 SE
    callback resize(int);
    // The Overview write waiting for its reconnect warning: kind 0 a switch (id, on), 3 / 4 a pick (value).
    property <int> ask-kind;
    property <int> ask-id;
    property <bool> ask-on;
    property <int> ask-value;
    property <string> ask-body;
    // The Overview picker open: 3 codec, 4 3D audio type; its warning when it turns Hi-Res off.
    property <int> pick-kind;
    property <string> pick-title;
    property <string> pick-confirm;

    VerticalLayout {
    TitleBar {
        maximized: root.max-state;
        drag => { root.drag(); }
        minimize => { root.minimize(); }
        toggle-maximize => { root.toggle-maximize(); }
        close => { root.close-window(); }
    }
    HorizontalLayout {
        vertical-stretch: 1;
        // --- Sidebar: the device and the sections ---
        side := Rectangle {
            width: 250px;
            background: Palette.sidebar;
            // Classic: one highlight slides to the active section (no slide to its first place).
            property <length> nav-y;
            property <bool> placed;
            nav-light := Rectangle {
                x: 16px; y: parent.nav-y; width: parent.width - 32px; height: 40px;
                visible: !Dots.on && parent.placed;
                border-radius: 10px;
                background: Palette.accent.transparentize(0.85);
                animate y { duration: side.placed ? Motion.base : 0ms; easing: ease-out; }
            }
            VerticalLayout {
                padding: 16px;
                padding-top: 8px;
                spacing: 4px;
                // Device card
                Rectangle {
                    background: Dots.on ? transparent : Palette.card;
                    border-width: Dots.on ? 0 : 1px;
                    border-color: Palette.outline;
                    border-radius: 14px;
                    if Dots.on: DotBox { width: 100%; height: 100%; radius: 14px; }
                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;
                        // The name opens the model list.
                        Rectangle {
                            height: 28px;
                            border-radius: 8px;
                            background: name-ta.has-hover ? Palette.outline : transparent;
                            animate background { duration: Motion.fast; }
                            HorizontalLayout {
                                padding-left: 4px;
                                spacing: 4px;
                                Text {
                                    text: Buds.name == "" ? "No earbuds" : Buds.name;
                                    color: Palette.text; font-size: 15px; font-weight: 600; overflow: elide;
                                    vertical-alignment: center; horizontal-stretch: 1;
                                }
                                Image { source: Buds.icon-chevron; width: 20px; height: 20px; y: (parent.height - self.height) / 2; }
                            }
                            name-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { if root.page != 8 { root.models-from = root.page; root.page = 8; } }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                width: 8px; height: 8px; border-radius: 4px; y: (parent.height - self.height) / 2;
                                background: Buds.on ? #3DDC84 : Buds.status == 1 ? #E8A33D : Palette.text2;
                                // Pulses while connecting; the tick is read only then, so it redraws only then.
                                opacity: Buds.status == 1 ? 0.6 + 0.4 * cos(animation-tick() / 900ms * 360deg) : 1;
                            }
                            Text { text: Buds.status-text; color: Palette.text2; font-size: 12px; }
                        }
                        Chip {
                            text: Buds.status == 0 ? Tr.connect : Tr.disconnect;
                            primary: Buds.status == 0;
                            clicked => { if Buds.status == 0 { Buds.connect(); } else { Buds.disconnect(); } }
                        }
                    }
                }
                Rectangle { height: 16px; }
                for e[i] in root.nav: NavItem {
                    entry: e;
                    active: root.page == i || (root.page == 8 && i == root.models-from) || (root.page >= 9 && root.page <= 11 && i == 6);
                    clicked => { root.page = i; }
                    at(y) => { side.nav-y = y; side.placed = true; }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }

        // --- Content ---
        if root.page == 1: PageIn { EqPage { } }
        if root.page == 5: PageIn { EarbudsPage { open-models => { root.models-from = 5; root.page = 8; } } }
        // The model list, opened from Earbud settings or the device name (no sidebar entry).
        if root.page == 8: PageIn { ModelsPage { back => { root.page = root.models-from; } } }
        if root.page == 2: PageIn { ControlsPage { } }
        if root.page == 3: PageIn { HearingPage { } }
        if root.page == 4: PageIn { DualPage { } }
        if root.page == 6: PageIn { SettingsPage { open-report => { Report.open(); root.page = 9; } open-theme => { root.page = 10; } } }
        // Themes, colors & styles and Edit preset, opened from App settings (the sidebar shows App settings).
        if root.page == 10: PageIn { ThemePage { back => { root.page = 6; } edit => { root.page = 11; } } }
        if root.page == 11: PageIn { PresetPage { back => { root.page = 10; } } }
        // Report a problem, opened from App settings (no sidebar entry; the sidebar shows App settings).
        if root.page == 9: PageIn { ReportPage { back => { root.page = 6; } } }
        if root.page == 7: PageIn { DevPage { } }
        // Scrolls: Hi-Res, 3D audio and the codec row make it taller than the window's first size (issue #9).
        if root.page == 0: PageIn { ScrollView {
            VerticalLayout {
                padding: 28px;
                // Content stays at most 760px wide, centred in a wide window.
                padding-left: max(28px, (parent.width - 760px) / 2);
                padding-right: self.padding-left;
                spacing: 16px;
                alignment: start;
                Text { text: root.nav[0].name; color: Palette.text; font-size: 26px; font-weight: 700; }
                if Update.available != "": Card {
                    live: true;
                    border-radius: 24px;
                    NavRow {
                        x: 20px; width: parent.width - 40px;
                        icon: Buds.icon-update; title: Update.notice; subtitle: Tr.update-installed + " " + Update.installed;
                        clicked => { root.page = 6; }
                    }
                }
                // The phone's home: status card, noise pill, feature list.
                Card {
                    border-radius: 24px;
                    vertical-stretch: 0;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 10px;
                        Batteries { size: 110px; }
                    }
                }
                if Buds.has-off || Buds.levels.length > 0 || Buds.has-adaptive || Buds.has-transparency: Card {
                    height: 72px;
                    border-radius: self.height / 2;
                    AncSegments { x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px; }
                }
                if Earbuds.home.length > 0 || Buds.has-eq: Card {
                    border-radius: 24px;
                    VerticalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        for f[i] in Earbuds.home: VerticalLayout {
                            if i > 0: Divider {}
                            FeatureRow {
                                icon: f.icon; title: f.title; subtitle: f.sub; checked: f.on; locked: f.locked;
                                toggled(on) => {
                                    if f.id == -1 {
                                        Buds.set-low-latency(on);
                                    } else if f.confirm != "" && (on || f.confirm-off) {
                                        root.ask-kind = 0; root.ask-id = f.id; root.ask-on = on; root.ask-body = f.confirm;
                                        home-ask.show();
                                    } else {
                                        Earbuds.set-feature(f.id, on);
                                    }
                                }
                            }
                            // The codec (3) or the 3D audio type (4).
                            if f.choice-kind > 0: Divider {}
                            if f.choice-kind > 0: NavRow {
                                icon: f.icon; title: f.choice-title; subtitle: f.choice;
                                clicked => {
                                    if !Buds.on { return; }
                                    root.pick-kind = f.choice-kind; root.pick-title = f.choice-title; root.pick-confirm = f.confirm;
                                    home-pick.show();
                                }
                            }
                        }
                        if Earbuds.home.length > 0 && Buds.has-eq: Divider {}
                        if Buds.has-eq: NavRow {
                            icon: Buds.icon-bass;
                            title: Tr.eq-row-title;
                            subtitle: Tr.eq-row-sub;
                            clicked => { root.page = 1; }
                        }
                    }
                }
                // The phone's rows that open a page: hearing profile, dual connection, earbud settings.
                Card {
                    border-radius: 24px;
                    VerticalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        // As on the phone: the row opens the page, the switch toggles the profile.
                        if root.nav[3].ready: Rectangle {
                            height: 64px;
                            TouchArea { mouse-cursor: pointer; clicked => { root.page = 3; } }
                            FeatureRow {
                                width: 100%;
                                icon: Buds.icon-hearing; title: Tr.hearing-title; subtitle: Tr.hearing-sub; checked: Hearing.on;
                                toggled(on) => { Hearing.set-on(on); }
                            }
                        }
                        if root.nav[3].ready && root.nav[4].ready: Divider {}
                        if root.nav[4].ready: NavRow {
                            icon: Buds.icon-devices; title: Tr.dual-title; subtitle: Tr.dual-row-sub;
                            clicked => { root.page = 4; }
                        }
                        if root.nav[3].ready || root.nav[4].ready: Divider {}
                        NavRow {
                            icon: Buds.icon-earbud; title: Tr.earbuds-title; subtitle: Tr.earbuds-row-sub;
                            clicked => { root.page = 5; }
                        }
                    }
                }
            }
        } }
    }
    }

    home-ask := Dialog {
        x: (root.width - self.width) / 2; y: (root.height - 180px) / 2;
        title: Tr.codec-dialog-title; body: root.ask-body; ok: Tr.codec-dialog-accept;
        accepted => {
            if root.ask-kind == 0 { Earbuds.set-feature(root.ask-id, root.ask-on); } else { Earbuds.choose(root.ask-kind, root.ask-value); }
        }
    }
    // A codec change always reconnects; a 3D audio type asks only when it turns Hi-Res off.
    home-pick := ChoiceDialog {
        x: (root.width - self.width) / 2; y: 120px;
        title: root.pick-title;
        items: root.pick-kind == 3 ? Earbuds.codec-choices : Earbuds.spatial-choices;
        current: root.pick-kind == 3 ? Earbuds.codec-current : Earbuds.spatial-current;
        picked(v) => {
            if root.pick-kind == 3 && v != Earbuds.codec-current {
                root.ask-kind = 3; root.ask-value = v; root.ask-body = Tr.codec-msg-reconnect; home-ask.show();
            } else if root.pick-kind == 4 && v != 0 && root.pick-confirm != "" {
                root.ask-kind = 4; root.ask-value = v; root.ask-body = root.pick-confirm; home-ask.show();
            } else if root.pick-kind == 4 {
                Earbuds.choose(4, v);
            }
        }
    }

    // Resize edges (a frameless window has none of its own).
    if !root.max-state: Rectangle {
        property <length> e: 5px;
        TouchArea { x: e; y: 0; width: root.width - 2 * e; height: e; mouse-cursor: ns-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize(0); } } }
        TouchArea { x: e; y: root.height - e; width: root.width - 2 * e; height: e; mouse-cursor: ns-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize(1); } } }
        TouchArea { x: 0; y: e; width: e; height: root.height - 2 * e; mouse-cursor: ew-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize(2); } } }
        TouchArea { x: root.width - e; y: e; width: e; height: root.height - 2 * e; mouse-cursor: ew-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize(3); } } }
        TouchArea { x: 0; y: 0; width: e; height: e; mouse-cursor: nwse-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize(4); } } }
        TouchArea { x: root.width - e; y: 0; width: e; height: e; mouse-cursor: nesw-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize(5); } } }
        TouchArea { x: 0; y: root.height - e; width: e; height: e; mouse-cursor: nesw-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize(6); } } }
        TouchArea { x: root.width - e; y: root.height - e; width: e; height: e; mouse-cursor: nwse-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize(7); } } }
    }
}


export component QuickPanel inherits Window {
    no-frame: true;
    always-on-top: true;
    title: "QuickBuds";
    width: 300px;
    height: 250px;
    background: Palette.outline;
    default-font-family: Dots.font;

    Rectangle {
        x: 1px; y: 1px;
        width: parent.width - 2px; height: parent.height - 2px;
        background: Palette.bg;
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            HorizontalLayout {
                Text {
                    text: Buds.name == "" ? "QuickBuds" : Buds.name;
                    color: Palette.text; font-size: 13px; font-weight: 700;
                    overflow: elide; horizontal-stretch: 1;
                }
                Text { text: Buds.status-text; color: Palette.text2; font-size: 11px; }
            }
            Batteries { size: 54px; labels: false; }
            AncSegments { compact: true; height: 40px; opacity: Buds.on ? 1 : 0.35; }
            if Buds.has-game: LowLatencyRow { opacity: Buds.on ? 1 : 0.35; }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Chip { text: Tr.quit; clicked => { Buds.quit(); } }
                Chip { text: Tr.open; primary: true; clicked => { Buds.open-main(); } }
            }
        }
    }
}
