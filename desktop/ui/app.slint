export struct Level {
    id: string,
    name: string,
    icon: image,
}

export global Buds {
    // 0 not connected, 1 connecting, 2 connected
    in property <int> status;
    in property <string> name;
    // -1 = unknown
    in property <int> left: -1;
    in property <int> right: -1;
    in property <int> case: -1;
    in property <bool> left-charging;
    in property <bool> right-charging;
    in property <bool> case-charging;
    // 0 unknown, 1 out of ear, 2 in ear, 3 in case
    in property <int> left-wear;
    in property <int> right-wear;
    in property <string> anc;
    in property <bool> anc-is-level;
    in property <bool> has-off;
    in property <bool> has-adaptive;
    in property <bool> has-transparency;
    in property <[Level]> levels;
    in property <bool> low-latency;

    in property <image> icon-left;
    in property <image> icon-right;
    in property <image> icon-case;
    in property <image> icon-off;
    in property <image> icon-anc;
    in property <image> icon-adaptive;
    in property <image> icon-transparency;
    in property <image> icon-low-latency;
    in property <image> icon-app;
    in property <image> icon-bass;
    in property <image> icon-chevron;
    in property <image> icon-plus;
    in property <image> icon-info;
    in property <image> icon-find;
    in property <image> icon-earbud;
    in property <image> icon-volume;
    in property <image> icon-volume-off;
    in property <image> icon-devices;
    in property <image> icon-hearing;
    // The ANC segment's label: "ANC", or "ANC M" while a level is on (the phone's and the widget's button).
    in property <string> anc-label: Tr.anc;

    callback set-anc(string);
    callback set-low-latency(bool);
    callback connect();
    callback disconnect();
    callback open-main();
    callback quit();

    out property <bool> on: status == 2;
    out property <string> status-text: status == 2 ? Tr.connected : status == 1 ? Tr.connecting : Tr.not-connected;
}

component Card inherits Rectangle {
    background: Dots.on ? transparent : Palette.card;
    border-radius: 16px;
    opacity: Buds.on ? 1 : 0.35;
    if Dots.on: DotBox { width: 100%; height: 100%; radius: root.border-radius; }
}

component Ring {
    in property <int> level;
    in property <bool> charging;
    in property <image> glyph;
    in property <length> glyph-w;
    in property <length> glyph-h;
    in property <color> tint: Palette.text;
    in property <string> label;
    in property <bool> label-bright;
    in property <length> size: 90px;
    // 0 left, 1 case, 2 right; the Dot matrix ring draws its own glyph.
    in property <int> slot;
    in property <int> wear;
    property <float> frac: max(0, min(level, 99.9)) / 100;
    property <float> r: 45;
    // Dot matrix: no label line (the glyph's shade shows wear, as on the phone).
    property <bool> show-label: label != "" && !Dots.on;
    width: size;
    height: size + (!show-label ? 20px : size > 60px ? 52px : 38px);

    if Dots.on: Image {
        x: 0; y: 0; width: size; height: size;
        source: Dots.ring-px(round(size / 1px * Dots.scale), Buds.on ? level : -1, slot,
            !Buds.on ? Palette.outline : slot == 1 ? Palette.text : Palette.dot-tint(wear),
            Palette.accent, Palette.card.mix(Palette.text2, 0.5));
        image-fit: ImageFit.fill;
        image-rendering: pixelated;
    }
    if !Dots.on: Path {
        x: 0; y: 0; width: size; height: size;
        viewbox-width: 100; viewbox-height: 100;
        stroke: Palette.outline;
        stroke-width: size * 0.06;
        MoveTo { x: 50; y: 5; }
        ArcTo { x: 49.99; y: 5; radius-x: r; radius-y: r; large-arc: true; sweep: true; }
    }
    if level > 0 && !Dots.on: Path {
        x: 0; y: 0; width: size; height: size;
        viewbox-width: 100; viewbox-height: 100;
        stroke: Palette.accent;
        stroke-width: size * 0.06;
        MoveTo { x: 50; y: 5; }
        ArcTo {
            x: 50 + r * sin(frac * 360deg);
            y: 50 - r * cos(frac * 360deg);
            radius-x: r; radius-y: r;
            large-arc: frac > 0.5; sweep: true;
        }
    }
    if !Dots.on: Image {
        source: glyph;
        width: glyph-w; height: glyph-h;
        x: (size - self.width) / 2; y: (size - self.height) / 2;
        colorize: tint;
    }
    Text {
        y: size + 4px; width: size;
        horizontal-alignment: center;
        text: level < 0 ? "–" : level + (Dots.on ? "" : "%") + (charging ? " ⚡" : "");
        color: Palette.text;
        font-size: size > 60px ? 22px : 12px;
        font-weight: 600;
    }
    if show-label: Text {
        y: size + (size > 60px ? 34px : 22px); width: size;
        horizontal-alignment: center;
        text: label;
        color: label-bright ? Palette.text : Palette.text2;
        font-size: size > 60px ? 14px : 12px;
    }
}

// Left, case, right, like the phone's status card; a bud's label is where it is (in ear, out, in case).
component Batteries inherits HorizontalLayout {
    in property <length> size: 90px;
    in property <bool> labels: true;
    alignment: space-around;
    pure function wear-label(wear: int, side: string) -> string {
        if wear == 2 { return Tr.in-ear; }
        if wear == 3 { return Tr.in-case; }
        if wear == 1 { return Tr.out-of-ear; }
        return side;
    }
    Ring {
        size: root.size; level: Buds.left; charging: Buds.left-charging; slot: 0; wear: Buds.left-wear;
        label: labels ? wear-label(Buds.left-wear, Tr.left) : ""; label-bright: Buds.left-wear == 2;
        glyph: Buds.icon-left; glyph-w: root.size * 0.32; glyph-h: root.size * 0.5;
        tint: Palette.wear-tint(Buds.left-wear);
    }
    Ring {
        size: root.size; level: Buds.case; charging: Buds.case-charging; label: labels ? Tr.case : ""; slot: 1;
        glyph: Buds.icon-case; glyph-w: root.size * 0.5; glyph-h: root.size * 0.4;
    }
    Ring {
        size: root.size; level: Buds.right; charging: Buds.right-charging; slot: 2; wear: Buds.right-wear;
        label: labels ? wear-label(Buds.right-wear, Tr.right) : ""; label-bright: Buds.right-wear == 2;
        glyph: Buds.icon-right; glyph-w: root.size * 0.32; glyph-h: root.size * 0.5;
        tint: Palette.wear-tint(Buds.right-wear);
    }
}

component Segment inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> selected;
    in property <bool> compact;
    in property <bool> enabled: Buds.on;
    callback clicked;
    // Equal widths, whatever the label length.
    preferred-width: 0;
    horizontal-stretch: 1;
    border-radius: min(self.height, self.width) / 2;
    // Dot matrix: the selected segment is an accent outline, the track inside (not a fill).
    property <color> lit: Dots.on ? Palette.accent : #FFFFFF;
    background: Dots.on ? transparent : selected ? Palette.accent : ta.has-hover ? Palette.outline : transparent;
    animate background { duration: 120ms; }
    if Dots.on && (selected || ta.has-hover): DotBox {
        width: 100%; height: 100%;
        radius: min(root.height / 2 * 0.85, 22px);
        fill: Palette.card;
        stroke: selected ? Palette.accent : Palette.outline;
    }
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        padding-top: 6px;
        padding-bottom: 6px;
        if icon.width > 0: HorizontalLayout {
            alignment: center;
            Image {
                source: icon; width: 24px; height: 24px;
                colorize: selected ? lit : Palette.text2;
            }
        }
        if !compact: Text {
            text: label;
            horizontal-alignment: center;
            font-size: 12px;
            color: selected ? lit : Palette.text2;
            overflow: elide;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Off / ANC / Adaptive / Transparency. ANC slides the modes out and the buds' levels in (the phone's
// and the widget's picker): a pick sends it, the lit level sends Off, 2 s without a pick slides back.
component AncSegments inherits Rectangle {
    in property <bool> compact;
    property <bool> picking;
    property <bool> on: Buds.on;
    changed on => { if !on { picking = false; } }
    clip: true;
    HorizontalLayout {
        x: picking ? root.width : 0;
        width: root.width;
        height: root.height;
        animate x { duration: 280ms; easing: ease-in-out; }
        spacing: 4px;
        if Buds.has-off: Segment {
            compact: root.compact; icon: Buds.icon-off; label: Tr.off;
            selected: Buds.anc == "Off"; clicked => { Buds.set-anc("Off"); }
        }
        if Buds.levels.length > 0: Segment {
            compact: root.compact; icon: Buds.icon-anc; label: Buds.anc-label;
            selected: Buds.anc-is-level;
            clicked => { if Buds.levels.length > 1 { picking = true; } else { Buds.set-anc("ANC"); } }
        }
        if Buds.has-adaptive: Segment {
            compact: root.compact; icon: Buds.icon-adaptive; label: Tr.adaptive;
            selected: Buds.anc == "Adaptive"; clicked => { Buds.set-anc("Adaptive"); }
        }
        if Buds.has-transparency: Segment {
            compact: root.compact; icon: Buds.icon-transparency; label: Tr.transparency;
            selected: Buds.anc == "Transparency"; clicked => { Buds.set-anc("Transparency"); }
        }
    }
    HorizontalLayout {
        x: picking ? 0 : -root.width;
        width: root.width;
        height: root.height;
        animate x { duration: 280ms; easing: ease-in-out; }
        spacing: 4px;
        for l in Buds.levels: Segment {
            compact: root.compact; icon: l.icon; label: l.name;
            selected: Buds.anc == l.id;
            clicked => { picking = false; Buds.set-anc(Buds.anc == l.id ? "Off" : l.id); }
        }
    }
    Timer {
        interval: 2280ms;
        running: picking;
        triggered => { picking = false; }
    }
}

component Toggle inherits Rectangle {
    in property <bool> checked;
    callback toggled(bool);
    // The phone's switch: a thin track under a thumb as tall as the switch, light grey when off.
    width: 44px;
    height: 24px;
    if !Dots.on: Rectangle {
        x: 6px; y: 6px; width: parent.width - 12px; height: 12px; border-radius: 6px;
        background: Palette.outline;
    }
    // Dot matrix: a dot track and a round dot thumb.
    if Dots.on: DotBox {
        x: 4px; y: 6px; width: parent.width - 8px; height: 12px;
        fill: Palette.outline; stroke: Palette.outline; radius: 5px;
    }
    property <int> thumb-cells: floor(22px / 1px * Dots.scale / Dots.pitch);
    if Dots.on: Image {
        width: thumb-cells * Dots.pitch / Dots.scale * 1px; height: self.width;
        y: (root.height - self.height) / 2;
        x: root.checked ? root.width - self.width : 0;
        animate x { duration: 120ms; }
        source: Dots.disc-px(thumb-cells, root.checked ? Palette.accent : #E4E4E6);
        image-fit: ImageFit.fill;
        image-rendering: pixelated;
    }
    if !Dots.on: Rectangle {
        width: 22px; height: 22px; border-radius: 11px;
        background: root.checked ? Palette.accent : #E4E4E6;
        animate background { duration: 120ms; }
        y: 1px;
        x: root.checked ? root.width - 23px : 1px;
        animate x { duration: 120ms; }
    }
    TouchArea {
        enabled: Buds.on;
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
}

component LowLatencyRow inherits HorizontalLayout {
    spacing: 12px;
    Image {
        source: Buds.icon-low-latency; width: 24px; height: 24px;
        colorize: Palette.accent;
        y: (parent.height - self.height) / 2;
    }
    Text {
        text: Tr.low-latency; color: Palette.text; font-size: 14px;
        vertical-alignment: center; horizontal-stretch: 1;
    }
    VerticalLayout {
        alignment: center;
        Toggle {
            checked: Buds.low-latency;
            toggled(on) => { Buds.set-low-latency(on); }
        }
    }
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    callback clicked;
    height: 34px;
    min-width: label.preferred-width + 28px;
    border-radius: 17px;
    background: Dots.on ? transparent : primary ? Palette.accent : ta.has-hover ? Palette.outline : transparent;
    border-width: primary || Dots.on ? 0 : 1px;
    border-color: Palette.outline.brighter(0.3);
    // Dot matrix: an outline, accent for the primary chip.
    if Dots.on: DotBox {
        width: 100%; height: 100%; radius: 14px;
        fill: ta.has-hover ? Palette.outline : Palette.card;
        stroke: root.primary ? Palette.accent : Palette.outline.brighter(0.3);
    }
    label := Text {
        text: root.text;
        color: root.primary ? (Dots.on ? Palette.accent : #FFFFFF) : Palette.text;
        font-size: 13px;
        font-weight: 600;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export struct NavEntry {
    icon: image,
    name: string,
    ready: bool,
}

component NavItem inherits Rectangle {
    in property <NavEntry> entry;
    in property <bool> active;
    callback clicked;
    height: 40px;
    border-radius: 10px;
    background: Dots.on ? transparent : active ? Palette.accent.transparentize(0.85) : ta.has-hover && entry.ready ? Palette.outline : transparent;
    opacity: entry.ready ? 1 : 0.4;
    if Dots.on && (active || (ta.has-hover && entry.ready)): DotBox {
        width: 100%; height: 100%; radius: 10px;
        fill: Palette.sidebar; stroke: active ? Palette.accent : Palette.outline;
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        Image {
            source: entry.icon; width: 20px; height: 20px; y: (parent.height - self.height) / 2;
            colorize: active ? Palette.accent : Palette.text;
        }
        Text {
            text: entry.name; vertical-alignment: center; horizontal-stretch: 1;
            color: Palette.text; font-size: 14px; font-weight: active ? 600 : 400;
        }
        if !entry.ready: Text { text: "Soon"; vertical-alignment: center; color: Palette.text2; font-size: 11px; }
    }
    ta := TouchArea {
        enabled: entry.ready;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component SectionTitle inherits Text {
    color: Palette.text2;
    font-size: 12px;
    font-weight: 600;
}

component FeatureRow inherits HorizontalLayout {
    in property <image> icon;
    in property <string> title;
    in property <string> subtitle;
    in property <bool> checked;
    // A row that opens a page (`NavRow`): a chevron instead of the switch.
    in property <bool> chevron;
    // Neither switch nor chevron (an info row).
    in property <bool> no-end;
    // The current value, left of the chevron.
    in property <string> value;
    callback toggled(bool);
    spacing: 16px;
    height: 64px;
    Image { source: icon; width: 24px; height: 24px; y: (parent.height - self.height) / 2; colorize: Palette.accent; }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 2px;
        Text { text: title; color: Palette.text; font-size: 15px; }
        if subtitle != "": Text { text: subtitle; color: Palette.text2; font-size: 12px; overflow: elide; }
    }
    if !chevron: VerticalLayout {
        alignment: center;
        Toggle { checked: root.checked; toggled(on) => { root.toggled(on); } }
    }
    if value != "": Text { text: value; color: Palette.text2; font-size: 13px; vertical-alignment: center; horizontal-alignment: right; overflow: elide; max-width: 260px; }
    if chevron && !no-end: Image {
        source: Buds.icon-chevron; width: 20px; height: 20px; y: (parent.height - self.height) / 2;
        colorize: Palette.accent;
    }
}

// A feature row that opens a page: the whole row is the button.
component NavRow inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> subtitle;
    in property <bool> chevron: true;
    in property <string> value;
    callback clicked;
    height: 64px;
    FeatureRow { width: 100%; icon: root.icon; title: root.title; subtitle: root.subtitle; chevron: true; no-end: !root.chevron; value: root.value; }
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A row divider inside a card.
component Divider inherits Rectangle {
    height: Dots.on ? Dots.pitch / Dots.scale * 1px : 1px;
    background: Dots.on ? transparent : Palette.outline;
    if Dots.on: DotBox { width: 100%; height: 100%; radius: 0; fill: Palette.outline; stroke: Palette.outline; }
}

component CaptionButton inherits Rectangle {
    in property <bool> danger;
    callback clicked;
    width: 46px;
    background: ta.has-hover ? (danger ? #C42B1C : Palette.outline) : transparent;
    ta := TouchArea { clicked => { root.clicked(); } }
    @children
}

component TitleBar inherits Rectangle {
    in property <bool> maximized;
    callback drag();
    callback minimize();
    callback toggle-maximize();
    callback close();
    height: 40px;
    background: Palette.sidebar;
    TouchArea {
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left { root.drag(); }
        }
        double-clicked => { root.toggle-maximize(); }
    }
    HorizontalLayout {
        padding-left: 16px;
        spacing: 10px;
        Image { source: Buds.icon-app; width: 20px; height: 20px; y: (parent.height - self.height) / 2; }
        Text { text: "QuickBuds"; color: Palette.text; font-size: 13px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
        CaptionButton {
            clicked => { root.minimize(); }
            Rectangle { width: 10px; height: 1px; background: Palette.text; }
        }
        CaptionButton {
            clicked => { root.toggle-maximize(); }
            Rectangle { width: 10px; height: 10px; border-width: 1px; border-color: Palette.text; }
        }
        CaptionButton {
            danger: true;
            clicked => { root.close(); }
            Path {
                width: 10px; height: 10px;
                viewbox-width: 10; viewbox-height: 10;
                stroke: Palette.text; stroke-width: 1px;
                commands: "M0 0 L10 10 M10 0 L0 10";
            }
        }
    }
}

export struct EqRow {
    id: int,
    name: string,
}

// The Equalizer page's state, filled from Rust (`App::apply`).
export global Eq {
    in property <[EqRow]> builtins;
    in property <[EqRow]> customs;
    in property <int> current: -1;
    in property <bool> has-custom;
    in property <bool> can-add;
    in property <bool> has-bass;
    in property <bool> bass-on;
    in-out property <int> bass-level;
    // The selected custom preset, in the editor.
    in property <bool> editing;
    in-out property <string> edit-name;
    in property <[int]> gains;
    in property <[string]> freq-labels;
    // Path commands in the plot's own pixels (a Path keeps its viewbox's aspect ratio).
    in property <string> curve;
    // The Dot matrix curve, set from Rust with `curve`.
    in property <image> curve-dots;
    callback plot-resized(float, float);
    // A knob or slider is held: Rust leaves the values alone.
    in-out property <bool> dragging;

    callback select-builtin(int);
    callback select-custom(int);
    callback add();
    callback delete();
    callback rename(string);
    callback band-moved(int, int);
    callback band-released(int, int);
    callback bass-toggled(bool);
    callback bass-released(int);
}

component PresetRow inherits Rectangle {
    in property <string> name;
    in property <bool> selected;
    in property <bool> enabled: Buds.on;
    callback clicked;
    height: 48px;
    border-radius: 16px;
    // Selection is an outline, never a checkmark.
    border-width: Dots.on ? 0 : selected ? 2px : 1px;
    border-color: selected ? Palette.accent : Palette.outline;
    background: Dots.on ? transparent : ta.has-hover ? Palette.card.mix(Palette.outline, 0.5) : Palette.card;
    opacity: enabled ? 1 : 0.35;
    if Dots.on: DotBox {
        width: 100%; height: 100%;
        fill: ta.has-hover ? Palette.card.mix(Palette.outline, 0.5) : Palette.card;
        stroke: selected ? Palette.accent : Palette.outline;
    }
    Text {
        x: 18px; width: parent.width - 36px;
        text: name; overflow: elide; vertical-alignment: center;
        color: selected ? Palette.accent : Palette.text; font-size: 14px;
    }
    ta := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component AddRow inherits Rectangle {
    in property <string> text;
    callback clicked;
    height: 48px;
    border-radius: 16px;
    border-width: Dots.on ? 0 : 1px;
    border-color: Palette.outline;
    background: Dots.on ? transparent : ta.has-hover ? Palette.card.mix(Palette.outline, 0.5) : Palette.card;
    opacity: Buds.on ? 1 : 0.35;
    if Dots.on: DotBox {
        width: 100%; height: 100%;
        fill: ta.has-hover ? Palette.card.mix(Palette.outline, 0.5) : Palette.card;
    }
    HorizontalLayout {
        alignment: center;
        spacing: 10px;
        Image { source: Buds.icon-plus; width: 18px; height: 18px; y: (parent.height - self.height) / 2; colorize: Palette.accent; }
        Text { text: root.text; color: Palette.text; font-size: 14px; vertical-alignment: center; }
    }
    ta := TouchArea { enabled: Buds.on; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component HSlider inherits Rectangle {
    in property <int> minimum;
    in property <int> maximum;
    in-out property <int> value;
    in property <bool> show-value: true;
    callback released(int);
    height: 48px;
    property <length> knob: Dots.on ? Dots.knob-size : 20px;
    property <length> track-y: 30px;
    property <float> frac: (value - minimum) / (maximum - minimum);
    if !Dots.on: Rectangle { y: track-y - 3px; height: 6px; border-radius: 3px; background: Palette.outline; }
    if !Dots.on: Rectangle {
        x: 0; y: track-y - 3px; height: 6px; border-radius: 3px;
        width: frac * (parent.width - knob) + knob / 2;
        background: Palette.accent;
    }
    // Dot matrix: a dot track, the accent part a second track over it, and the dot knob.
    if Dots.on: DotBox { x: 0; y: track-y - 4px; width: parent.width; height: 8px; radius: 3px; fill: Palette.outline; stroke: Palette.outline; }
    if Dots.on: DotBox {
        x: 0; y: track-y - 4px; height: 8px; radius: 3px; fill: Palette.accent; stroke: Palette.accent;
        width: frac * (parent.width - knob) + knob / 2;
    }
    if Dots.on: Image {
        x: frac * (parent.width - knob); y: track-y - knob / 2; width: knob; height: knob;
        source: Dots.knob(Palette.accent, Palette.card);
        image-fit: ImageFit.fill; image-rendering: pixelated;
    }
    if !Dots.on: Rectangle {
        x: frac * (parent.width - knob); y: track-y - knob / 2;
        width: knob; height: knob; border-radius: knob / 2;
        background: Palette.card;
        border-width: 3px; border-color: Palette.accent;
    }
    if show-value: Text {
        x: frac * (parent.width - knob) + knob / 2 - 20px; y: 0; width: 40px;
        horizontal-alignment: center;
        text: (value > 0 ? "+" : "") + value;
        color: Palette.accent; font-size: 13px; font-weight: 600;
    }
    function set-from(x: length) {
        root.value = clamp(round(minimum + (x - knob / 2) / (root.width - knob) * (maximum - minimum)), minimum, maximum);
    }
    TouchArea {
        enabled: Buds.on;
        mouse-cursor: pointer;
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down { Eq.dragging = true; set-from(self.mouse-x); }
            if ev.kind == PointerEventKind.up { Eq.dragging = false; root.released(root.value); }
        }
        moved => { if self.pressed { set-from(self.mouse-x); } }
    }
}

component EqEditor inherits Rectangle {
    property <length> knob: Dots.on ? Dots.knob-size : 18px;
    property <length> labels: 36px;
    property <length> plot-h: self.height - labels;
    property <length> band-w: self.width / max(1, Eq.gains.length);
    // The +6 / 0 / -6 guides
    for f in [0, 0.5, 1]: Rectangle {
        y: knob / 2 + f * (plot-h - knob); height: 1px;
        background: f == 0.5 ? Palette.outline.brighter(0.2) : Palette.outline;
    }
    changed width => { Eq.plot-resized(root.width / 1px, (plot-h - knob) / 1px); }
    changed height => { Eq.plot-resized(root.width / 1px, (plot-h - knob) / 1px); }
    init => { Eq.plot-resized(root.width / 1px, (plot-h - knob) / 1px); }
    if Dots.on: Image {
        x: 0; y: knob / 2; width: Dots.snap(root.width); height: Dots.snap(plot-h - knob);
        source: Eq.curve-dots;
        image-fit: ImageFit.fill;
        image-rendering: pixelated;
    }
    if !Dots.on: Path {
        x: 0; y: knob / 2; width: root.width; height: plot-h - knob;
        viewbox-width: root.width / 1px; viewbox-height: (plot-h - knob) / 1px;
        stroke: Palette.accent; stroke-width: 2.5px;
        commands: Eq.curve;
    }
    for g[i] in Eq.gains: Rectangle {
        x: i * band-w; y: 0; width: band-w; height: root.height;
        Rectangle { x: (parent.width - 2px) / 2; y: knob / 2; width: 2px; height: plot-h - knob; background: Palette.outline.transparentize(0.4); }
        if Dots.on: Image {
            x: (parent.width - knob) / 2; y: (6 - g) / 12 * (plot-h - knob);
            width: knob; height: knob;
            source: Dots.knob(Palette.accent, ta.pressed || ta.has-hover ? Palette.accent : Palette.card);
            image-fit: ImageFit.fill; image-rendering: pixelated;
        }
        if !Dots.on: Rectangle {
            x: (parent.width - knob) / 2; y: (6 - g) / 12 * (plot-h - knob);
            width: knob; height: knob; border-radius: knob / 2;
            background: ta.pressed || ta.has-hover ? Palette.accent.brighter(0.2) : Palette.accent;
            border-width: 2px; border-color: Palette.card;
        }
        Text {
            y: plot-h + 2px; width: parent.width; horizontal-alignment: center;
            text: Eq.freq-labels[i]; color: Palette.text2; font-size: 11px;
        }
        Text {
            y: plot-h + 17px; width: parent.width; horizontal-alignment: center;
            text: (g > 0 ? "+" : "") + g + " dB"; color: Palette.text; font-size: 11px;
        }
        function set-from(y: length) {
            Eq.band-moved(i, clamp(round(6 - (y - knob / 2) / (plot-h - knob) * 12), -6, 6));
        }
        ta := TouchArea {
            y: 0; height: plot-h;
            enabled: Buds.on;
            mouse-cursor: ns-resize;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down { Eq.dragging = true; set-from(self.mouse-y); }
                if ev.kind == PointerEventKind.up { Eq.dragging = false; Eq.band-released(i, Eq.gains[i]); }
            }
            moved => { if self.pressed { set-from(self.mouse-y); } }
        }
    }
}

component EqPage inherits VerticalLayout {
    padding: 28px;
    spacing: 16px;
    Text { text: Tr.eq-title; color: Palette.text; font-size: 26px; font-weight: 700; }
    if !Buds.on: Text { text: Tr.eq-not-connected; color: Palette.text2; font-size: 13px; }

    HorizontalLayout {
        spacing: 16px;
        vertical-stretch: 1;
        // Presets
        VerticalLayout {
            width: 270px;
            spacing: 16px;
            alignment: start;
            // Split lists, like the phone's: one card per row.
            if Eq.builtins.length > 0: VerticalLayout {
                spacing: 8px;
                SectionTitle { text: Tr.eq-recommended; font-size: 13px; font-weight: 400; }
                for p in Eq.builtins: PresetRow {
                    name: p.name; selected: Eq.current == p.id;
                    clicked => { Eq.select-builtin(p.id); }
                }
            }
            if Eq.has-custom: VerticalLayout {
                spacing: 8px;
                SectionTitle { text: Tr.eq-custom; font-size: 13px; font-weight: 400; }
                for p in Eq.customs: PresetRow {
                    name: p.name; selected: Eq.current == p.id;
                    clicked => { Eq.select-custom(p.id); }
                }
                if Eq.can-add: AddRow { text: Tr.eq-add; clicked => { Eq.add(); } }
            }
        }
        // Editor and bass
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 16px;
            Card {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 20px;
                    spacing: 14px;
                    if Eq.editing: HorizontalLayout {
                        spacing: 10px;
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 36px;
                            border-radius: 8px;
                            border-width: Dots.on ? 0 : 1px;
                            border-color: name-input.has-focus ? Palette.accent : Palette.outline;
                            if Dots.on: DotBox {
                                width: 100%; height: 100%; radius: 8px; fill: Palette.card;
                                stroke: name-input.has-focus ? Palette.accent : Palette.outline;
                            }
                            name-input := TextInput {
                                x: 12px; width: parent.width - 24px;
                                text <=> Eq.edit-name;
                                color: Palette.text; font-size: 15px; font-weight: 600;
                                vertical-alignment: center;
                                single-line: true;
                                accepted => { Eq.rename(self.text); self.clear-focus(); }
                            }
                        }
                        Chip { text: Tr.eq-save; clicked => { Eq.rename(name-input.text); name-input.clear-focus(); } }
                        Chip { text: Tr.eq-delete; clicked => { confirm.show(); } }
                    }
                    if Eq.editing: EqEditor { vertical-stretch: 1; min-height: 200px; }
                    if !Eq.editing: Rectangle {
                        vertical-stretch: 1;
                        Text {
                            text: Eq.has-custom ? "Pick a custom preset to edit its bands." : "These earbuds have no custom presets.";
                            color: Palette.text2; font-size: 13px;
                        }
                    }
                }
            }
            if Eq.has-bass: Card {
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 8px;
                    padding-bottom: 12px;
                    FeatureRow {
                        icon: Buds.icon-bass;
                        title: Tr.eq-basswave;
                        subtitle: Tr.eq-basswave-sub;
                        checked: Eq.bass-on;
                        toggled(on) => { Eq.bass-toggled(on); }
                    }
                    if Eq.bass-on: HSlider {
                        minimum: -5; maximum: 5;
                        value <=> Eq.bass-level;
                        released(v) => { Eq.bass-released(v); }
                    }
                }
            }
        }
    }

    confirm := PopupWindow {
        x: (root.width - 320px) / 2;
        y: (root.height - 140px) / 2;
        width: 320px;
        height: 140px;
        Rectangle {
            background: Palette.card;
            border-radius: 14px;
            border-width: 1px;
            border-color: Palette.outline;
            VerticalLayout {
                padding: 20px;
                spacing: 16px;
                Text { text: Tr.eq-delete + " \"" + Eq.edit-name + "\"?"; color: Palette.text; font-size: 15px; font-weight: 600; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Chip { text: Tr.cancel; }
                    Chip { text: Tr.eq-delete; primary: true; clicked => { Eq.delete(); } }
                }
            }
        }
    }
}

export struct LogRow {
    text: string,
    amber: bool,
}

// Dev tools' packet log, filled from Rust (`devtools.rs`). Labels stay English-only, like the phone's.
export global DevLog {
    in property <[LogRow]> rows;
    in-out property <int> mode;
    in property <string> note;
    // A monospace font the system has.
    in property <string> font;
    callback refresh();
    callback set-mode(int);
    callback clear();
    callback export();
    callback reconnect();
}

component DevPage inherits VerticalLayout {
    padding: 24px;
    spacing: 12px;
    SectionTitle { text: "Dev tools"; }
    HorizontalLayout {
        spacing: 8px;
        for m[i] in ["Human", "Detailed", "Raw hex"]: Chip { text: m; primary: DevLog.mode == i; clicked => { DevLog.set-mode(i); } }
        Rectangle { horizontal-stretch: 1; }
        Chip { text: "Clear"; clicked => { DevLog.clear(); } }
        Chip { text: "Export"; clicked => { DevLog.export(); } }
        Chip { text: "Reconnect"; clicked => { DevLog.reconnect(); } }
        Chip { text: "Disconnect"; clicked => { Buds.disconnect(); } }
    }
    if DevLog.note != "": Text { text: DevLog.note; color: Palette.text2; font-size: 12px; }
    // Not a Card: the log stays readable while disconnected.
    Rectangle {
        vertical-stretch: 1;
        background: Palette.card;
        border-radius: 16px;
        VerticalLayout { padding: 8px; ListView {
            for r in DevLog.rows: Text {
                text: r.text;
                color: r.amber ? #E8A33D : Palette.text;
                font-family: DevLog.font;
                font-size: 12px;
                wrap: word-wrap;
            }
        } }
    }
    // The session thread appends to the log; the page picks the new lines up while it is open.
    Timer { interval: 500ms; running: true; triggered => { DevLog.refresh(); } }
}

export struct FeatureItem {
    id: int,
    icon: image,
    title: string,
    sub: string,
    on: bool,
    // Asked before turning on ("" = never); `confirm-off`: before turning off too.
    confirm: string,
    confirm-off: bool,
    // A picker row under the switch: 0 none, 1 game sound type, 2 head gesture mapping.
    choice-kind: int,
    choice-title: string,
    choice: string,
    // Turning it on runs the Personalized ANC flow instead of a write.
    flow: bool,
}

export struct Choice {
    value: int,
    label: string,
}

// The Earbud settings page's state (`earbuds.rs`).
export global Earbuds {
    in property <[FeatureItem]> features;
    in property <bool> has-firmware;
    in property <string> firmware;
    in property <bool> has-find;
    // The locator tone is on: leaving the page or closing the dialog stops it.
    in-out property <bool> find-playing;
    in property <bool> has-alert;
    in-out property <int> alert: 5;
    in property <bool> has-tap;
    in-out property <int> tap: 3;
    in property <int> tap-default: 3;
    in property <bool> has-fit;
    in property <int> fit-left;
    in property <int> fit-right;
    in property <int> fit-seq;
    in property <[Choice]> game-choices;
    in property <int> game-current;
    in property <[Choice]> head-choices;
    in property <int> head-current;
    in property <int> pnc-kind;
    in property <int> pnc-value;
    in property <int> pnc-seq;
    callback pnc-query();
    callback pnc(int);
    callback status-read();
    callback choose(int, int);
    callback fit(bool);
    callback opened();
    callback alert-released(int);
    callback tap-released(int);
    callback set-feature(int, bool);
    callback find(bool);
    public function stop-find() { if find-playing { find-playing = false; find(false); } }
}

// A list to pick one from (the phone's bottom sheet items); the current one has the outline.
component ChoiceDialog inherits PopupWindow {
    in property <string> title;
    in property <[Choice]> items;
    in property <int> current;
    in property <string> message;
    callback picked(int);
    width: 340px;
    Rectangle {
        background: Dots.on ? Palette.bg : Palette.card;
        border-radius: 14px;
        border-width: Dots.on ? 0 : 1px;
        border-color: Palette.outline;
        if Dots.on: DotBox { width: 100%; height: 100%; radius: 14px; }
        VerticalLayout {
            padding: 20px;
            spacing: 8px;
            Text { text: root.title; color: Palette.text; font-size: 15px; font-weight: 600; }
            if root.message != "": Text { text: root.message; color: Palette.text2; font-size: 13px; wrap: word-wrap; }
            for c in root.items: PresetRow {
                name: c.label; selected: c.value == root.current;
                clicked => { root.picked(c.value); }
            }
        }
    }
}

// Earbud fit test (`FitTestSheet`): both buds in an ear, Play, one result per bud within 15 s; closing stops it.
component FitDialog inherits PopupWindow {
    // 0 ready, 1 insert the buds, 2 running, 3 failed, 4 perfect, 5 adjust
    property <int> state;
    property <bool> started;
    property <bool> shown-result;
    close-policy: PopupClosePolicy.no-auto-close;
    width: 380px;
    public function stop() { if started { started = false; Earbuds.fit(false); } }
    function play() {
        if Buds.left-wear != 2 || Buds.right-wear != 2 { state = 1; return; }
        state = 2; started = true; shown-result = false;
        Earbuds.fit(true);
    }
    pure function ok(s: int) -> bool { return s == 0 || s == 1 || s == 6; }
    pure function word(s: int) -> string { return s == 1 ? Tr.fit-good : s == 0 ? Tr.fit-average : s == 6 ? Tr.fit-poor : ""; }
    property <int> seq: Earbuds.fit-seq;
    changed seq => {
        if state != 2 { return; }
        if !ok(Earbuds.fit-left) || !ok(Earbuds.fit-right) { state = 3; return; }
        shown-result = true;
        state = Earbuds.fit-left == 1 && Earbuds.fit-right == 1 ? 4 : 5;
    }
    Timer { interval: 15s; running: state == 2; triggered => { state = 3; } }
    Rectangle {
        background: Dots.on ? Palette.bg : Palette.card;
        border-radius: 14px;
        border-width: Dots.on ? 0 : 1px;
        border-color: Palette.outline;
        if Dots.on: DotBox { width: 100%; height: 100%; radius: 14px; }
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text {
                text: [Tr.fit-title, Tr.fit-insert, Tr.fit-keep, Tr.fit-failed, Tr.fit-perfect, Tr.fit-adjust][state];
                color: Palette.text; font-size: 15px; font-weight: 600; wrap: word-wrap;
            }
            if state != 2 && state != 4: Text {
                text: state == 5 ? (Earbuds.fit-left != 1 && Earbuds.fit-right != 1 ? Tr.fit-tips-both : Earbuds.fit-left != 1 ? Tr.fit-tips-left : Tr.fit-tips-right) : Tr.fit-hint;
                color: Palette.text2; font-size: 13px; wrap: word-wrap;
            }
            // "Left · Good", a good fit in the accent colour.
            if shown-result: HorizontalLayout {
                alignment: space-around;
                for side[i] in [Earbuds.fit-left, Earbuds.fit-right]: Text {
                    text: (i == 0 ? Tr.bud-left : Tr.bud-right) + " · " + word(side);
                    color: side == 1 ? Palette.accent : Palette.text; font-size: 15px;
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Chip { text: Tr.close; clicked => { stop(); state = 0; shown-result = false; root.close(); } }
                Chip {
                    primary: true;
                    text: state == 2 ? Tr.fit-playing : state == 4 ? Tr.done : state == 5 ? Tr.fit-again : Tr.fit-play;
                    clicked => {
                        if state == 2 { return; }
                        if state == 4 { stop(); state = 0; shown-result = false; root.close(); return; }
                        play();
                    }
                }
            }
        }
    }
}

// Personalized ANC (`PersonalNoiseFlow`): both buds worn, then the stored result if the buds hold one (5 s for
// the answer), else the ear canal test (a result within 15 s; closing cancels it).
component PncDialog inherits PopupWindow {
    // 0 asking, 1 stored result offered, 2 test intro, 3 testing, 4 failed, 5 wear both buds, 6 done
    property <int> state;
    property <int> reason;
    close-policy: PopupClosePolicy.no-auto-close;
    width: 380px;
    pure function worn() -> bool { return Buds.left-wear == 2 && Buds.right-wear == 2; }
    function start() {
        if !worn() { state = 5; return; }
        state = 0;
        Earbuds.pnc-query();
    }
    function test() {
        if !worn() { state = 5; return; }
        state = 3;
        Earbuds.pnc(1);
    }
    function finish() {
        if state == 3 { Earbuds.pnc(3); }
        state = 0;
        root.close();
    }
    property <int> seq: Earbuds.pnc-seq;
    changed seq => {
        if Earbuds.pnc-kind == 1 && state == 0 { state = Earbuds.pnc-value != 0 ? 1 : 2; }
        // A rejected write fails the test as well (status 15: another device busy).
        if Earbuds.pnc-kind == 2 && state == 3 && Earbuds.pnc-value != 0 { reason = 0; state = 4; }
        if Earbuds.pnc-kind == 3 && state == 3 {
            if Earbuds.pnc-value == 0 { state = 6; Earbuds.status-read(); } else { reason = Earbuds.pnc-value; state = 4; }
        }
    }
    Timer { interval: 5s; running: state == 0; triggered => { state = 2; } }
    // The popup's content is built on each show: each opening starts the flow.
    init => { start(); }
    Timer { interval: 15s; running: state == 3; triggered => { reason = 0; state = 4; } }
    Rectangle {
        background: Dots.on ? Palette.bg : Palette.card;
        border-radius: 14px;
        border-width: Dots.on ? 0 : 1px;
        border-color: Palette.outline;
        if Dots.on: DotBox { width: 100%; height: 100%; radius: 14px; }
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text {
                text: [Tr.pnc-title, Tr.pnc-stored-title, Tr.pnc-test-title, Tr.pnc-title, Tr.pnc-failed, Tr.pnc-title, Tr.pnc-title][state];
                color: Palette.text; font-size: 15px; font-weight: 600; wrap: word-wrap;
            }
            Text {
                text: [Tr.connecting, Tr.pnc-stored-body, Tr.pnc-test-body, Tr.pnc-testing,
                    ["", Tr.pnc-fail-quiet, Tr.pnc-fail-fit, Tr.pnc-fail-wind, Tr.pnc-fail-still, Tr.pnc-fail-audio][reason <= 5 ? reason : 0],
                    Tr.pnc-wear, Tr.pnc-done][state];
                color: Palette.text2; font-size: 13px; wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Chip {
                    text: state == 1 ? Tr.pnc-test-again : state == 6 ? Tr.close : Tr.cancel;
                    clicked => { if state == 1 { test(); } else { finish(); } }
                }
                if state == 1 || state == 2 || state == 4 || state == 5: Chip {
                    primary: true;
                    text: state == 1 ? Tr.pnc-use : state == 2 ? Tr.pnc-start : Tr.pnc-retry;
                    clicked => {
                        if state == 1 { Earbuds.pnc(2); state = 0; root.close(); }
                        else if state == 5 { start(); }
                        else { test(); }
                    }
                }
            }
        }
    }
}

// Find my earbuds (`FindBudsSheet`): Play / Stop in place; a bud in an ear asks first (the tone is loud).
component FindDialog inherits PopupWindow {
    property <bool> warn;
    close-policy: PopupClosePolicy.no-auto-close;
    width: 360px;
    Rectangle {
        background: Dots.on ? Palette.bg : Palette.card;
        border-radius: 14px;
        border-width: Dots.on ? 0 : 1px;
        border-color: Palette.outline;
        if Dots.on: DotBox { width: 100%; height: 100%; radius: 14px; }
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text { text: warn ? Tr.find-warn-title : Tr.find-title; color: Palette.text; font-size: 15px; font-weight: 600; wrap: word-wrap; }
            Text { text: warn ? Tr.find-warn-msg : Tr.find-hint; color: Palette.text2; font-size: 13px; wrap: word-wrap; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Chip { text: Tr.close; clicked => { warn = false; Earbuds.stop-find(); root.close(); } }
                Chip {
                    primary: true;
                    text: Earbuds.find-playing ? Tr.find-stop : warn ? Tr.find-warn-play : Tr.find-play;
                    clicked => {
                        if Earbuds.find-playing {
                            Earbuds.stop-find();
                        } else if !warn && (Buds.left-wear == 2 || Buds.right-wear == 2) {
                            warn = true;
                        } else {
                            warn = false;
                            Earbuds.find-playing = true;
                            Earbuds.find(true);
                        }
                    }
                }
            }
        }
    }
}

// A centred dialog: title, body, and Cancel / OK (`ConfirmDialog`); no Cancel with `cancel` "".
component Dialog inherits PopupWindow {
    in property <string> title;
    in property <string> body;
    in property <string> ok: Tr.ok;
    in property <string> cancel: Tr.cancel;
    callback accepted();
    width: 360px;
    Rectangle {
        background: Dots.on ? transparent : Palette.card;
        border-radius: 14px;
        border-width: Dots.on ? 0 : 1px;
        border-color: Palette.outline;
        // Solid behind the dots: the page must not show through the gaps.
        if Dots.on: Rectangle { background: Palette.bg; border-radius: 14px; }
        if Dots.on: DotBox { width: 100%; height: 100%; radius: 14px; }
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text { text: root.title; color: Palette.text; font-size: 15px; font-weight: 600; wrap: word-wrap; }
            if root.body != "": Text { text: root.body; color: Palette.text2; font-size: 13px; wrap: word-wrap; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                if root.cancel != "": Chip { text: root.cancel; }
                Chip { text: root.ok; primary: true; clicked => { root.accepted(); } }
            }
        }
    }
}

// Earbud settings (`EarbudSettingsActivity`): the switches these buds list, and the firmware version.
component EarbudsPage inherits Rectangle {
    callback open-models();
    init => { Earbuds.opened(); }
    property <int> ask-id;
    property <bool> ask-on;
    property <string> ask-title;
    property <string> ask-body;
    ScrollView {
        VerticalLayout {
            padding: 28px;
            spacing: 16px;
            alignment: start;
            Text { text: Tr.earbuds-title; color: Palette.text; font-size: 26px; font-weight: 700; }
            if !Buds.on: Text { text: Tr.not-connected; color: Palette.text2; font-size: 13px; }
            // Not a Card: the model list works while disconnected too.
            Rectangle {
                height: 64px;
                border-radius: 24px;
                background: Dots.on ? transparent : Palette.card;
                if Dots.on: DotBox { width: 100%; height: 100%; radius: 24px; }
                NavRow {
                    x: 20px; width: parent.width - 40px;
                    icon: Buds.icon-earbud; title: Tr.model-title;
                    subtitle: Models.current == "" ? Tr.model-auto + " · " + Models.detected : Models.model-name;
                    clicked => { root.open-models(); }
                }
            }
            if Earbuds.has-find || Earbuds.has-fit: Card {
                border-radius: 24px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    if Earbuds.has-find: NavRow { icon: Buds.icon-find; title: Tr.find-row-title; subtitle: Tr.find-row-sub; clicked => { if Buds.on { find.show(); } } }
                    if Earbuds.has-find && Earbuds.has-fit: Divider {}
                    if Earbuds.has-fit: NavRow { icon: Buds.icon-earbud; title: Tr.fit-title; subtitle: Tr.fit-sub; clicked => { if Buds.on { fit.show(); } } }
                }
            }
            if Earbuds.features.length > 0: SectionTitle { text: Tr.section-features; font-size: 13px; font-weight: 400; }
            if Earbuds.features.length > 0: Card {
                border-radius: 24px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    for f[i] in Earbuds.features: VerticalLayout {
                        if i > 0: Divider {}
                        FeatureRow {
                            icon: f.icon; title: f.title; subtitle: f.sub; checked: f.on;
                            toggled(on) => {
                                if f.flow && on {
                                    pnc.show();
                                } else if f.confirm != "" && (on || f.confirm-off) {
                                    ask-id = f.id; ask-on = on; ask-title = f.title; ask-body = f.confirm;
                                    ask.show();
                                } else {
                                    Earbuds.set-feature(f.id, on);
                                }
                            }
                        }
                        if f.choice-kind > 0: Divider {}
                        if f.choice-kind > 0: NavRow {
                            icon: f.icon; title: f.choice-title; subtitle: f.choice;
                            clicked => { if !Buds.on { return; } if f.choice-kind == 1 { game.show(); } else { head.show(); } }
                        }
                    }
                }
            }
            if Earbuds.has-tap: SectionTitle { text: Tr.tap-title; font-size: 13px; font-weight: 400; }
            if Earbuds.has-tap: Card {
                border-radius: 24px;
                VerticalLayout {
                    padding: 20px;
                    padding-bottom: 10px;
                    Text { text: Tr.tap-hint; color: Palette.text2; font-size: 13px; wrap: word-wrap; }
                    HSlider { minimum: 1; maximum: 5; value <=> Earbuds.tap; released(v) => { Earbuds.tap-released(v); } }
                    // Below the buds' default, as HeyMelody warns.
                    if Earbuds.tap < Earbuds.tap-default: Text { text: Tr.tap-warning; color: Palette.text2; font-size: 13px; wrap: word-wrap; }
                }
            }
            if Earbuds.has-alert: SectionTitle { text: Tr.section-sounds; font-size: 13px; font-weight: 400; }
            // No numbers, as in HeyMelody: a speaker left of the bar, muted at the lowest step (level 1 is silent).
            if Earbuds.has-alert: Card {
                border-radius: 24px;
                VerticalLayout {
                    padding: 20px;
                    padding-bottom: 6px;
                    Text { text: Tr.alert-title; color: Palette.text; font-size: 15px; font-weight: 600; }
                    HorizontalLayout {
                        spacing: 12px;
                        Image {
                            source: Earbuds.alert <= 1 ? Buds.icon-volume-off : Buds.icon-volume;
                            width: 22px; height: 22px; y: 22px; colorize: Palette.accent;
                        }
                        HSlider {
                            horizontal-stretch: 1; minimum: 1; maximum: 10; show-value: false;
                            value <=> Earbuds.alert; released(v) => { Earbuds.alert-released(v); }
                        }
                    }
                }
            }
            if Earbuds.has-firmware: SectionTitle { text: Tr.section-about; font-size: 13px; font-weight: 400; }
            // No firmware updates here [USER]: a failed flash can brick the buds, so a click points to HeyMelody.
            if Earbuds.has-firmware: Card {
                border-radius: 24px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    NavRow { icon: Buds.icon-info; title: Tr.firmware-title; subtitle: Earbuds.firmware; chevron: false; clicked => { info.show(); } }
                }
            }
        }
    }
    ask := Dialog {
        x: (root.width - self.width) / 2; y: (root.height - 160px) / 2;
        title: root.ask-title; body: root.ask-body;
        accepted => { Earbuds.set-feature(root.ask-id, root.ask-on); }
    }
    game := ChoiceDialog {
        x: (root.width - self.width) / 2; y: 120px;
        title: Tr.game-sound-type-title; items: Earbuds.game-choices; current: Earbuds.game-current;
        picked(v) => { Earbuds.choose(1, v); }
    }
    head := ChoiceDialog {
        x: (root.width - self.width) / 2; y: 120px;
        title: Tr.head-motion-type-title; items: Earbuds.head-choices; current: Earbuds.head-current;
        picked(v) => { Earbuds.choose(2, v); }
    }
    pnc := PncDialog {
        x: (root.width - self.width) / 2; y: 120px;
    }
    fit := FitDialog {
        x: (root.width - self.width) / 2; y: 120px;
    }
    find := FindDialog {
        x: (root.width - self.width) / 2; y: (root.height - 160px) / 2;
    }
    info := Dialog {
        x: (root.width - self.width) / 2; y: (root.height - 180px) / 2;
        title: Tr.firmware-dialog-title; body: Tr.firmware-dialog-body; ok: Tr.close; cancel: "";
    }
}

export struct ModelRow {
    id: string,
    name: string,
    // The id, where two rows share a name.
    sub: string,
}

export struct ModelSection {
    title: string,
    rows: [ModelRow],
}

// The model list's state (`models.rs`).
export global Models {
    in property <[ModelSection]> sections;
    // The manual pick's id, "" = Automatic.
    in property <string> current;
    in property <string> detected;
    in property <string> model-name;
    callback pick(string);
}

// The model list (`ModelActivity`): Automatic, then every model by brand. Selection is an outline.
component ModelsPage inherits Rectangle {
    callback back();
    ScrollView {
        VerticalLayout {
            padding: 28px;
            spacing: 8px;
            alignment: start;
            HorizontalLayout {
                spacing: 12px;
                Chip { text: "‹"; width: 40px; clicked => { root.back(); } }
                Text { text: Tr.model-title; color: Palette.text; font-size: 26px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
            }
            PresetRow { name: Tr.model-auto + "   ·   " + Models.detected; selected: Models.current == ""; enabled: true; clicked => { Models.pick(""); } }
            for sec in Models.sections: VerticalLayout {
                spacing: 8px;
                padding-top: 8px;
                SectionTitle { text: sec.title; font-size: 13px; font-weight: 400; }
                for m in sec.rows: PresetRow {
                    name: m.sub == "" ? m.name : m.name + "  (" + m.sub + ")";
                    selected: Models.current == m.id; enabled: true;
                    clicked => { Models.pick(m.id); }
                }
            }
        }
    }
}

export struct ControlsRow {
    icon: image,
    title: string,
    value: string,
}

export struct Pick {
    value: int,
    label: string,
    on: bool,
}

// Controls' state (`controls.rs`); the dialogs are filled from Rust when a row opens.
export global Controls {
    in property <[ControlsRow]> rows;
    in property <[ControlsRow]> calls;
    in property <int> side;
    in property <string> dialog-title;
    in property <[Choice]> choices;
    in property <int> choice-current;
    in property <[Pick]> picks;
    in property <string> pick-message;
    callback opened();
    callback set-side(int);
    // 1 a list to pick one from, 2 the per-bud hold's choices, 3 the hold's noise modes.
    callback open-row(int) -> int;
    callback open-call(int);
    // 3: the noise modes open next.
    callback picked(int) -> int;
    callback toggle(int);
    callback done();
}

// The hold's noise modes (several, cycled in order): a click toggles, Done writes.
component PickDialog inherits PopupWindow {
    close-policy: PopupClosePolicy.no-auto-close;
    width: 340px;
    Rectangle {
        background: Dots.on ? Palette.bg : Palette.card;
        border-radius: 14px;
        border-width: Dots.on ? 0 : 1px;
        border-color: Palette.outline;
        if Dots.on: DotBox { width: 100%; height: 100%; radius: 14px; }
        VerticalLayout {
            padding: 20px;
            spacing: 8px;
            Text { text: Controls.dialog-title; color: Palette.text; font-size: 15px; font-weight: 600; }
            for p in Controls.picks: PresetRow { name: p.label; selected: p.on; clicked => { Controls.toggle(p.value); } }
            if Controls.pick-message != "": Text { text: Controls.pick-message; color: Palette.text2; font-size: 13px; wrap: word-wrap; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Chip { text: Tr.cancel; clicked => { root.close(); } }
                Chip { text: Tr.done; primary: true; clicked => { Controls.done(); root.close(); } }
            }
        }
    }
}

// Controls (`GestureActivity`): Left / Right, the gestures of that bud, then the on-call rows (both buds).
component ControlsPage inherits Rectangle {
    init => { Controls.opened(); }
    ScrollView {
        VerticalLayout {
            padding: 28px;
            spacing: 16px;
            alignment: start;
            Text { text: Tr.gesture-title; color: Palette.text; font-size: 26px; font-weight: 700; }
            if !Buds.on: Text { text: Tr.not-connected; color: Palette.text2; font-size: 13px; }
            Rectangle {
                height: 52px;
                border-radius: self.height / 2;
                background: Dots.on ? transparent : Palette.card;
                if Dots.on: DotBox { width: 100%; height: 100%; radius: 22px; }
                HorizontalLayout {
                    padding: 4px;
                    spacing: 4px;
                    Segment { enabled: true; label: Tr.bud-left; selected: Controls.side == 0; clicked => { Controls.set-side(0); } }
                    Segment { enabled: true; label: Tr.bud-right; selected: Controls.side == 1; clicked => { Controls.set-side(1); } }
                }
            }
            if Controls.rows.length > 0: SectionTitle { text: Tr.gesture-not-in-call; font-size: 13px; font-weight: 400; }
            if Controls.rows.length > 0: Card {
                border-radius: 24px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    for r[i] in Controls.rows: VerticalLayout {
                        if i > 0: Divider {}
                        NavRow {
                            icon: r.icon; title: r.title; subtitle: ""; value: r.value;
                            clicked => {
                                if !Buds.on { return; }
                                let kind = Controls.open-row(i);
                                if kind == 1 || kind == 2 { choice.show(); }
                                if kind == 3 { picks.show(); }
                            }
                        }
                    }
                }
            }
            if Controls.calls.length > 0: SectionTitle { text: Tr.gesture-on-call; font-size: 13px; font-weight: 400; }
            if Controls.calls.length > 0: Card {
                border-radius: 24px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    for r[i] in Controls.calls: VerticalLayout {
                        if i > 0: Divider {}
                        NavRow {
                            icon: r.icon; title: r.title; subtitle: ""; value: r.value;
                            clicked => { if Buds.on { Controls.open-call(i); choice.show(); } }
                        }
                    }
                }
            }
            Text { text: Tr.gesture-note; color: Palette.text2; font-size: 12px; wrap: word-wrap; }
        }
    }
    choice := ChoiceDialog {
        x: (root.width - self.width) / 2; y: 100px;
        title: Controls.dialog-title; items: Controls.choices; current: Controls.choice-current;
        picked(v) => { if Controls.picked(v) == 3 { picks.show(); } }
    }
    picks := PickDialog {
        x: (root.width - self.width) / 2; y: 100px;
    }
}

export struct RadarLabel {
    x: float,
    y: float,
    text: string,
}

// Hearing profile's state (`hearing.rs`); the test dialog's texts come from Rust as its flow moves on.
export global Hearing {
    in property <bool> on;
    in property <[EqRow]> profiles;
    in property <[string]> delete-names;
    in property <int> active: -1;
    in property <bool> has-test;
    in property <bool> has-radar;
    in-out property <int> ear;
    // The radar as path commands in the plot's own pixels, and as dots (Dot matrix).
    in property <string> grid;
    in property <string> rim;
    in property <string> shape;
    in property <image> grid-dots;
    in property <image> rim-dots;
    in property <image> shape-dots;
    in property <[RadarLabel]> labels;
    in property <string> test-title;
    in property <string> test-message;
    in property <string> test-button;
    in property <bool> test-slider;
    // The result is saved: the main button closes the dialog.
    in property <bool> test-done;
    in-out property <int> test-stop;
    callback opened();
    callback set-on(bool);
    callback pick(int);
    callback delete(int);
    callback set-ear(int);
    callback radar-resized(float, float);
    callback test-open();
    callback test-action();
    callback test-moved(int);
    callback test-closed();
}

// The hearing test (`GoldenTestSheet`): ear scan where the model has one, then a tone per frequency, each set
// to where it just disappears. Closing stops it.
component HearingTestDialog inherits PopupWindow {
    close-policy: PopupClosePolicy.no-auto-close;
    width: 400px;
    property <int> stop: Hearing.test-stop;
    changed stop => { Hearing.test-moved(stop); }
    Rectangle {
        background: Dots.on ? Palette.bg : Palette.card;
        border-radius: 14px;
        border-width: Dots.on ? 0 : 1px;
        border-color: Palette.outline;
        if Dots.on: DotBox { width: 100%; height: 100%; radius: 14px; }
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text { text: Hearing.test-title; color: Palette.text; font-size: 15px; font-weight: 600; wrap: word-wrap; }
            if Hearing.test-message != "": Text { text: Hearing.test-message; color: Palette.text2; font-size: 13px; wrap: word-wrap; }
            if Hearing.test-slider: HSlider { minimum: 0; maximum: 24; show-value: false; value <=> Hearing.test-stop; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Chip { text: Tr.close; clicked => { Hearing.test-closed(); root.close(); } }
                Chip {
                    primary: true;
                    text: Hearing.test-button;
                    clicked => { if Hearing.test-done { root.close(); } else { Hearing.test-action(); } }
                }
            }
        }
    }
}

// Hearing profile (`GoldenSoundActivity`): the switch, the active profile's radar, the profiles, the test.
component HearingPage inherits Rectangle {
    init => { Hearing.opened(); }
    property <int> ask-index;
    ScrollView {
        VerticalLayout {
            padding: 28px;
            spacing: 16px;
            alignment: start;
            Text { text: Tr.hearing-title; color: Palette.text; font-size: 26px; font-weight: 700; }
            if !Buds.on: Text { text: Tr.not-connected; color: Palette.text2; font-size: 13px; }
            Card {
                border-radius: 24px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    FeatureRow {
                        icon: Buds.icon-hearing; title: Tr.hearing-title; subtitle: Tr.hearing-sub; checked: Hearing.on;
                        toggled(on) => { Hearing.set-on(on); }
                    }
                }
            }
            // One ear at a time reads better [USER].
            if Hearing.has-radar: Card {
                border-radius: 24px;
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    Rectangle {
                        height: 44px;
                        HorizontalLayout {
                            spacing: 4px;
                            Segment { enabled: true; label: Tr.hearing-left; selected: Hearing.ear == 0; clicked => { Hearing.set-ear(0); } }
                            Segment { enabled: true; label: Tr.hearing-right; selected: Hearing.ear == 1; clicked => { Hearing.set-ear(1); } }
                        }
                    }
                    plot := Rectangle {
                        height: 260px;
                        changed width => { Hearing.radar-resized(self.width / 1px, self.height / 1px); }
                        init => { Hearing.radar-resized(self.width / 1px, self.height / 1px); }
                        if !Dots.on: Path {
                            x: 0; y: 0; width: parent.width; height: parent.height;
                            viewbox-width: parent.width / 1px; viewbox-height: parent.height / 1px;
                            stroke: Palette.outline; stroke-width: 1px; commands: Hearing.grid;
                        }
                        if !Dots.on: Path {
                            x: 0; y: 0; width: parent.width; height: parent.height;
                            viewbox-width: parent.width / 1px; viewbox-height: parent.height / 1px;
                            fill: Palette.text2.transparentize(0.9); stroke: Palette.text2; stroke-width: 2px; commands: Hearing.rim;
                        }
                        if !Dots.on && Hearing.shape != "": Path {
                            x: 0; y: 0; width: parent.width; height: parent.height;
                            viewbox-width: parent.width / 1px; viewbox-height: parent.height / 1px;
                            fill: Palette.accent.transparentize(0.75); stroke: Palette.accent; stroke-width: 2px; commands: Hearing.shape;
                        }
                        for img in Dots.on ? [Hearing.grid-dots, Hearing.rim-dots, Hearing.shape-dots] : []: Image {
                            x: 0; y: 0; width: Dots.snap(parent.width); height: Dots.snap(parent.height);
                            source: img; image-fit: ImageFit.fill; image-rendering: pixelated;
                        }
                        for l in Hearing.labels: Text {
                            x: l.x * 1px - 30px; y: l.y * 1px - 8px; width: 60px;
                            horizontal-alignment: center;
                            text: l.text; color: Palette.text2; font-size: 11px;
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        Rectangle { width: 16px; height: 2px; y: (parent.height - self.height) / 2; background: Palette.text2; }
                        Text { text: Tr.hearing-boost; color: Palette.text2; font-size: 11px; }
                    }
                }
            }
            SectionTitle { text: Tr.hearing-profiles; font-size: 13px; font-weight: 400; }
            if Hearing.profiles.length == 0: Text { text: Tr.hearing-none; color: Palette.text2; font-size: 13px; }
            for p[i] in Hearing.profiles: HorizontalLayout {
                spacing: 8px;
                PresetRow {
                    horizontal-stretch: 1;
                    name: p.name; selected: Hearing.active == i;
                    clicked => { Hearing.pick(i); }
                }
                Chip { y: 7px; text: Tr.eq-delete; clicked => { ask-index = i; ask.show(); } }
            }
            if Hearing.has-test: Card {
                border-radius: 24px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    NavRow {
                        icon: Buds.icon-hearing; title: Tr.hearing-test-row; subtitle: Tr.hearing-test-sub;
                        clicked => { if Buds.on { Hearing.test-open(); test.show(); } }
                    }
                }
            }
        }
    }
    ask := Dialog {
        x: (root.width - self.width) / 2; y: (root.height - 140px) / 2;
        title: Hearing.delete-names[root.ask-index]; body: ""; ok: Tr.eq-delete;
        accepted => { Hearing.delete(root.ask-index); }
    }
    test := HearingTestDialog {
        x: (root.width - self.width) / 2; y: 120px;
    }
}

export struct DualDevice {
    name: string,
    // Connected (this device) / Connected / Not connected
    state: string,
    // "Connect X?" / "Disconnect X?", and its button.
    ask: string,
    action: string,
    can-click: bool,
}

// Dual connection's state (`dual.rs`).
export global Dual {
    in property <bool> on;
    in property <[DualDevice]> devices;
    // The model has HeyMelody's device manager: every paired device is listed and can be (dis)connected.
    in property <bool> manages;
    in property <bool> has-preferred;
    in property <string> preferred;
    in property <[Choice]> preferred-choices;
    in property <int> preferred-current;
    callback opened();
    callback set-dual(bool);
    callback connect-device(int);
    callback set-preferred(int);
}

// Dual connection (`DualDeviceActivity`): the switch, the preferred device, the devices; Add device is instructions.
component DualPage inherits Rectangle {
    init => { Dual.opened(); }
    property <int> ask-index;
    property <string> ask-title;
    property <string> ask-ok;
    ScrollView {
        VerticalLayout {
            padding: 28px;
            spacing: 16px;
            alignment: start;
            Text { text: Tr.dual-title; color: Palette.text; font-size: 26px; font-weight: 700; }
            if !Buds.on: Text { text: Tr.not-connected; color: Palette.text2; font-size: 13px; }
            Card {
                border-radius: 24px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    FeatureRow {
                        icon: Buds.icon-devices; title: Tr.dual-title; subtitle: Tr.dual-switch-sub; checked: Dual.on;
                        toggled(on) => { Dual.set-dual(on); }
                    }
                }
            }
            if Dual.has-preferred: Card {
                border-radius: 24px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    NavRow {
                        icon: Buds.icon-devices; title: Tr.dual-preferred; subtitle: Dual.preferred;
                        clicked => { if Buds.on { preferred.show(); } }
                    }
                }
            }
            SectionTitle { text: Dual.manages ? Tr.dual-section-all : Tr.dual-section-devices; font-size: 13px; font-weight: 400; }
            Card {
                border-radius: 24px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    for d[i] in Dual.devices: VerticalLayout {
                        if i > 0: Divider {}
                        Rectangle {
                            height: 60px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text { text: d.name; color: Palette.text; font-size: 15px; font-weight: 600; overflow: elide; }
                                Text { text: d.state; color: Palette.text2; font-size: 12px; }
                            }
                            if d.can-click: TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if !Buds.on { return; }
                                    ask-index = i; ask-title = d.ask; ask-ok = d.action;
                                    ask.show();
                                }
                            }
                        }
                    }
                    if Dual.devices.length > 0: Divider {}
                    NavRow { icon: Buds.icon-plus; title: Tr.dual-add-title; subtitle: ""; clicked => { add.show(); } }
                }
            }
        }
    }
    ask := Dialog {
        x: (root.width - self.width) / 2; y: (root.height - 140px) / 2;
        title: root.ask-title; body: ""; ok: root.ask-ok;
        accepted => { Dual.connect-device(root.ask-index); }
    }
    preferred := ChoiceDialog {
        x: (root.width - self.width) / 2; y: 120px;
        title: Tr.dual-preferred; message: Tr.dual-preferred-sub;
        items: Dual.preferred-choices; current: Dual.preferred-current;
        picked(v) => { Dual.set-preferred(v); }
    }
    add := Dialog {
        x: (root.width - self.width) / 2; y: (root.height - 200px) / 2;
        title: Tr.dual-add-title; body: Tr.dual-add-message; ok: Tr.ok; cancel: "";
    }
}

// App settings (the phone's Settings and Theme screens): for now the style.
component SettingsPage inherits VerticalLayout {
    padding: 28px;
    spacing: 16px;
    Text { text: "App settings"; color: Palette.text; font-size: 26px; font-weight: 700; }
    SectionTitle { text: Tr.style-title; font-size: 13px; font-weight: 400; }
    // Classic / Dot matrix, like the phone's Theme screen: one switch for the window and the quick panel.
    Rectangle {
        height: 52px;
        border-radius: self.height / 2;
        background: Dots.on ? transparent : Palette.card;
        if Dots.on: DotBox { width: 100%; height: 100%; radius: 22px; }
        HorizontalLayout {
            padding: 4px;
            spacing: 4px;
            Segment { compact: false; enabled: true; label: Tr.style-classic; selected: !Dots.on; clicked => { Dots.set-on(false); } }
            Segment { compact: false; enabled: true; label: Tr.style-dots; selected: Dots.on; clicked => { Dots.set-on(true); } }
        }
    }
    Rectangle { vertical-stretch: 1; }
}

export component MainWindow inherits Window {
    in property <[NavEntry]> nav;
    in-out property <int> page: 0;
    changed page => { Earbuds.stop-find(); Hearing.test-closed(); }
    title: "QuickBuds";
    icon: Buds.icon-app;
    min-width: 900px;
    min-height: 580px;
    preferred-width: 960px;
    preferred-height: 620px;
    background: Palette.bg;
    default-font-family: Dots.font;
    no-frame: true;
    // Window chrome, handled in Rust (winit): drag, minimize, maximize, hide, edge resize.
    in property <bool> max-state;
    callback drag();
    callback minimize();
    callback toggle-maximize();
    callback close-window();
    // 0 N, 1 S, 2 W, 3 E, 4 NW, 5 NE, 6 SW, 7 SE
    callback resize(int);

    VerticalLayout {
    TitleBar {
        maximized: root.max-state;
        drag => { root.drag(); }
        minimize => { root.minimize(); }
        toggle-maximize => { root.toggle-maximize(); }
        close => { root.close-window(); }
    }
    HorizontalLayout {
        vertical-stretch: 1;
        // --- Sidebar: the device and the sections ---
        Rectangle {
            width: 250px;
            background: Palette.sidebar;
            VerticalLayout {
                padding: 16px;
                padding-top: 8px;
                spacing: 4px;
                // Device card
                Rectangle {
                    background: Dots.on ? transparent : Palette.card;
                    border-radius: 14px;
                    if Dots.on: DotBox { width: 100%; height: 100%; radius: 14px; }
                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;
                        Text {
                            text: Buds.name == "" ? "No earbuds" : Buds.name;
                            color: Palette.text; font-size: 15px; font-weight: 600; overflow: elide;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                width: 8px; height: 8px; border-radius: 4px; y: (parent.height - self.height) / 2;
                                background: Buds.on ? #3DDC84 : Buds.status == 1 ? #E8A33D : Palette.text2;
                            }
                            Text { text: Buds.status-text; color: Palette.text2; font-size: 12px; }
                        }
                        Chip {
                            text: Buds.status == 0 ? Tr.connect : Tr.disconnect;
                            primary: Buds.status == 0;
                            clicked => { if Buds.status == 0 { Buds.connect(); } else { Buds.disconnect(); } }
                        }
                    }
                }
                Rectangle { height: 16px; }
                for e[i] in root.nav: NavItem {
                    entry: e;
                    active: root.page == i || (root.page == 8 && i == 5);
                    clicked => { root.page = i; }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }

        // --- Content ---
        if root.page == 1: EqPage { horizontal-stretch: 1; }
        if root.page == 5: EarbudsPage { horizontal-stretch: 1; open-models => { root.page = 8; } }
        // The model list, opened from Earbud settings (no sidebar entry; the sidebar shows Earbud settings).
        if root.page == 8: ModelsPage { horizontal-stretch: 1; back => { root.page = 5; } }
        if root.page == 2: ControlsPage { horizontal-stretch: 1; }
        if root.page == 3: HearingPage { horizontal-stretch: 1; }
        if root.page == 4: DualPage { horizontal-stretch: 1; }
        if root.page == 6: SettingsPage { horizontal-stretch: 1; }
        if root.page == 7: DevPage { horizontal-stretch: 1; }
        if root.page == 0: VerticalLayout {
            horizontal-stretch: 1;
            padding: 28px;
            spacing: 16px;


            // The phone's home: status card, noise pill, feature list.
            Card {
                border-radius: 24px;
                vertical-stretch: 0;
                VerticalLayout {
                    padding: 20px;
                    spacing: 10px;
                    Batteries { size: 110px; }
                    Text {
                        text: Buds.name; horizontal-alignment: center;
                        color: Palette.text2; font-size: 14px;
                    }
                }
            }
            if Buds.has-off || Buds.levels.length > 0 || Buds.has-adaptive || Buds.has-transparency: Card {
                height: 72px;
                border-radius: self.height / 2;
                AncSegments { x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px; }
            }
            Card {
                border-radius: 24px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    FeatureRow {
                        icon: Buds.icon-low-latency;
                        title: Tr.game-title;
                        subtitle: Tr.game-sub;
                        checked: Buds.low-latency;
                        toggled(on) => { Buds.set-low-latency(on); }
                    }
                    Divider {}
                    NavRow {
                        icon: Buds.icon-bass;
                        title: Tr.eq-row-title;
                        subtitle: Tr.eq-row-sub;
                        clicked => { root.page = 1; }
                    }
                }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }
    }

    // Resize edges (a frameless window has none of its own).
    if !root.max-state: Rectangle {
        property <length> e: 5px;
        TouchArea { x: e; y: 0; width: root.width - 2 * e; height: e; mouse-cursor: ns-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize(0); } } }
        TouchArea { x: e; y: root.height - e; width: root.width - 2 * e; height: e; mouse-cursor: ns-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize(1); } } }
        TouchArea { x: 0; y: e; width: e; height: root.height - 2 * e; mouse-cursor: ew-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize(2); } } }
        TouchArea { x: root.width - e; y: e; width: e; height: root.height - 2 * e; mouse-cursor: ew-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize(3); } } }
        TouchArea { x: 0; y: 0; width: e; height: e; mouse-cursor: nwse-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize(4); } } }
        TouchArea { x: root.width - e; y: 0; width: e; height: e; mouse-cursor: nesw-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize(5); } } }
        TouchArea { x: 0; y: root.height - e; width: e; height: e; mouse-cursor: nesw-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize(6); } } }
        TouchArea { x: root.width - e; y: root.height - e; width: e; height: e; mouse-cursor: nwse-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize(7); } } }
    }
}


export component QuickPanel inherits Window {
    no-frame: true;
    always-on-top: true;
    title: "QuickBuds";
    width: 300px;
    height: 250px;
    background: Palette.outline;
    default-font-family: Dots.font;

    Rectangle {
        x: 1px; y: 1px;
        width: parent.width - 2px; height: parent.height - 2px;
        background: Palette.bg;
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            HorizontalLayout {
                Text {
                    text: Buds.name == "" ? "QuickBuds" : Buds.name;
                    color: Palette.text; font-size: 13px; font-weight: 700;
                    overflow: elide; horizontal-stretch: 1;
                }
                Text { text: Buds.status-text; color: Palette.text2; font-size: 11px; }
            }
            Batteries { size: 54px; labels: false; }
            AncSegments { compact: true; height: 40px; opacity: Buds.on ? 1 : 0.35; }
            LowLatencyRow { opacity: Buds.on ? 1 : 0.35; }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Chip { text: Tr.quit; clicked => { Buds.quit(); } }
                Chip { text: Tr.open; primary: true; clicked => { Buds.open-main(); } }
            }
        }
    }
}
