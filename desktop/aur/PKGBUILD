# Maintainer: spizganed <328350196+spizganed@users.noreply.github.com>
# Repackages the Linux archive from the GitHub release (built by scripts/desktop-dist.sh).
pkgname=quickbuds-bin
_ver=4.4.0
_tag=v4.4.0
pkgver=${_ver//-/_}
pkgrel=1
pkgdesc="Control OnePlus / OPPO / realme earbuds over Bluetooth"
arch=('x86_64')
url="https://github.com/spizganed/QuickBuds"
license=('GPL-3.0-only')
depends=('bluez' 'dbus' 'fontconfig' 'gdk-pixbuf2' 'glib2' 'glibc' 'gtk3' 'hicolor-icon-theme' 'libayatana-appindicator'
         'libgcc' 'libxkbcommon')
provides=('quickbuds')
conflicts=('quickbuds')
source=("$url/releases/download/$_tag/QuickBuds$_ver-linux-x64.tar.gz")
sha256sums=('522ce0ecb58e9e464647f45000180f55fc59633339ea6d483ab67795c0fd716d')

package() {
  cd "QuickBuds$_ver-linux-x64"
  install -Dm755 quickbuds "$pkgdir/usr/bin/quickbuds"
  install -Dm644 quickbuds.desktop "$pkgdir/usr/share/applications/quickbuds.desktop"
  install -Dm644 quickbuds.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/quickbuds.svg"
}
